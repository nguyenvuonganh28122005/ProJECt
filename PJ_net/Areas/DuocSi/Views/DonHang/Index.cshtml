@model IEnumerable<PJ_net.Models.HoaDon>
@{
    ViewData["Title"] = "Duyệt đơn hàng & Thẩm định đơn thuốc (Rx)";
    string currentTab = ViewBag.CurrentTrangThai as string ?? "";
    int choXacNhanCount = ViewBag.ChoXacNhanCount ?? 0;
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-3 mb-4" role="alert">
        <i class="bi bi-check-circle me-1"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
    <!-- Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4 pb-3 border-bottom">
        <div>
            <h4 class="fw-bold mb-1 text-slate-900"><i class="bi bi-file-earmark-medical text-primary me-2"></i>Duyệt đơn trực tuyến &amp; Thẩm định đơn (Rx)</h4>
            <p class="text-muted small mb-0">Kiểm tra tính hợp lệ của đơn thuốc Bác sĩ, đối soát mã đơn điện tử và xác nhận xuất kho FEFO</p>
        </div>

        <!-- Filter Tabs -->
        <div class="btn-group btn-group-sm rounded-pill p-1 bg-light">
            <a asp-action="Index" asp-route-search="@ViewBag.Search" 
               class="btn rounded-pill @(string.IsNullOrEmpty(currentTab) ? "btn-success" : "btn-light text-muted")">
                Tất cả
            </a>
            <a asp-action="Index" asp-route-trangThai="ChoXacNhan" asp-route-search="@ViewBag.Search" 
               class="btn rounded-pill @(currentTab == "ChoXacNhan" ? "btn-warning text-dark fw-bold" : "btn-light text-muted")">
                Chờ duyệt Rx @(choXacNhanCount > 0 ? $"({choXacNhanCount})" : "")
            </a>
            <a asp-action="Index" asp-route-trangThai="DaXacNhan" asp-route-search="@ViewBag.Search" 
               class="btn rounded-pill @(currentTab == "DaXacNhan" ? "btn-info text-white fw-bold" : "btn-light text-muted")">
                Đã duyệt
            </a>
            <a asp-action="Index" asp-route-trangThai="DangGiao" asp-route-search="@ViewBag.Search" 
               class="btn rounded-pill @(currentTab == "DangGiao" ? "btn-primary text-white fw-bold" : "btn-light text-muted")">
                Đang giao
            </a>
            <a asp-action="Index" asp-route-trangThai="HoanTat" asp-route-search="@ViewBag.Search" 
               class="btn rounded-pill @(currentTab == "HoanTat" ? "btn-success text-white fw-bold" : "btn-light text-muted")">
                Hoàn tất
            </a>
        </div>
    </div>

    <!-- Search box -->
    <form method="get" asp-action="Index" class="row g-2 mb-4">
        <input type="hidden" name="trangThai" value="@currentTab" />
        <div class="col-md-6">
            <div class="input-group">
                <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-search"></i></span>
                <input type="text" name="search" value="@ViewBag.Search" class="form-control bg-light border-start-0" 
                       placeholder="Tìm theo Mã đơn, Họ tên khách hoặc SĐT..." />
                <button type="submit" class="btn btn-primary px-4">Tìm kiếm</button>
            </div>
        </div>
    </form>

    <!-- Orders Table -->
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light text-muted small text-uppercase">
                <tr>
                    <th class="ps-3">Mã Đơn</th>
                    <th>Thời Gian</th>
                    <th>Khách Hàng / Nhận Thuốc</th>
                    <th>Hồ Sơ Đơn Thuốc (Rx)</th>
                    <th>Tổng Tiền</th>
                    <th>Trạng Thái</th>
                    <th class="text-end pe-3">Thẩm Định &amp; Xử Lý</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">Không có đơn hàng nào trong danh sách.</td>
                    </tr>
                }
                else
                {
                    @foreach (var hd in Model)
                    {
                        <tr>
                            <td class="ps-3 font-monospace fw-bold text-slate-800">#@hd.MaHd</td>
                            <td class="small">@(hd.NgayLap?.ToString("dd/MM/yyyy HH:mm") ?? "-")</td>
                            <td>
                                <div class="fw-bold text-slate-900 small">@(hd.MaKhNavigation?.HoTen ?? "Khách vãng lai")</div>
                                <span class="text-muted text-truncate d-block" style="font-size: 11px; max-width: 200px;">
                                    @hd.GhiChuKhachHang
                                </span>
                            </td>
                            <td>
                                @if (hd.LoaiDonTuVan == "GuiAnh")
                                {
                                    <span class="badge bg-danger text-white rounded-pill small">
                                        <i class="bi bi-camera me-1"></i>Đã tải ảnh đơn BS
                                    </span>
                                }
                                else if (hd.LoaiDonTuVan == "GuiMaDon")
                                {
                                    <span class="badge bg-primary text-white rounded-pill small">
                                        <i class="bi bi-qr-code me-1"></i>Mã đơn điện tử QG
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted small">Không kê đơn</span>
                                }
                            </td>
                            <td class="fw-bold text-slate-800">@((hd.TongTien ?? 0).ToString("N0")) đ</td>
                            <td>
                                @{
                                    var badgeClass = hd.TrangThai switch
                                    {
                                        "HoanTat" => "bg-success text-white",
                                        "DaXacNhan" => "bg-info text-white",
                                        "DangGiao" => "bg-primary text-white",
                                        "DaHuy" => "bg-danger text-white",
                                        _ => "bg-warning text-dark fw-bold"
                                    };
                                    var statusText = hd.TrangThai switch
                                    {
                                        "ChoXacNhan" => "Chờ Dược sĩ duyệt",
                                        "DaXacNhan" => "Đã duyệt đơn",
                                        "DangGiao" => "Đang giao",
                                        "HoanTat" => "Hoàn tất",
                                        "DaHuy" => "Đã hủy",
                                        _ => hd.TrangThai
                                    };
                                }
                                <span class="badge @badgeClass rounded-pill px-2.5 py-1 small">
                                    @statusText
                                </span>
                            </td>
                            <td class="text-end pe-3">
                                <a asp-action="ThamDinh" asp-route-id="@hd.MaHd" 
                                   class="btn @(hd.TrangThai == "ChoXacNhan" ? "btn-success fw-bold" : "btn-outline-secondary") btn-sm rounded-pill px-3">
                                    <i class="bi bi-search me-1"></i> Thẩm định &amp; Duyệt
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
