@model PJ_net.Models.N6HoaDon
@{
    ViewData["Title"] = "Thẩm định đơn thuốc #" + Model.MaHd;
}

<div class="mb-3">
    <a asp-area="DuocSi" asp-controller="DonHang" asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill">
        <i class="bi bi-arrow-left me-1"></i> Quay lại danh sách đơn hàng
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-3 mb-4" role="alert">
        <i class="bi bi-check-circle me-1"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show rounded-3 mb-4" role="alert">
        <i class="bi bi-exclamation-triangle me-1"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row g-4">
    <!-- CỘT TRÁI (7 COLS): THẨM ĐỊNH ĐƠN THUỐC BÁC SĨ & CHI TIẾT SẢN PHẨM -->
    <div class="col-lg-7">
        <!-- Đơn thuốc Bác sĩ (Rx) thẩm định -->
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4 border-start border-4 border-danger">
            <div class="d-flex justify-content-between align-items-center pb-3 border-bottom mb-3">
                <h5 class="fw-bold mb-0 text-slate-900">
                    <i class="bi bi-file-earmark-medical text-danger me-2"></i>1. Thẩm định Hồ sơ Đơn thuốc Bác sĩ (Rx)
                </h5>
                <span class="badge bg-danger-subtle text-danger font-monospace">Quy tắc BR02</span>
            </div>

            @if (!string.IsNullOrEmpty(Model.LoaiDonTuVan))
            {
                <div class="mb-3">
                    <span class="text-muted small">Hình thức gửi đơn:</span>
                    <strong class="text-slate-900 ms-1">
                        @(Model.LoaiDonTuVan == "GuiAnh" ? "Ảnh chụp đơn Bác sĩ trực tiếp" : "Mã đơn thuốc điện tử quốc gia")
                    </strong>
                </div>

                @if (Model.LoaiDonTuVan == "GuiMaDon")
                {
                    <div class="p-3 bg-light rounded-3 mb-3 border">
                        <span class="text-muted small d-block">Mã đơn điện tử quốc gia:</span>
                        <div class="fs-4 font-monospace fw-bold text-primary my-1">@Model.MaDonThuocDienTu</div>
                        <a href="https://donthuocquocgia.vn" target="_blank" class="btn btn-outline-primary btn-sm rounded-pill mt-2">
                            <i class="bi bi-box-arrow-up-right me-1"></i> Tra cứu trên Cổng đơn thuốc Quốc gia
                        </a>
                    </div>
                }

                @if (Model.LoaiDonTuVan == "GuiAnh" && !string.IsNullOrEmpty(Model.AnhDonThuoc))
                {
                    <div class="mb-3">
                        <span class="text-muted small d-block mb-2">Ảnh chụp đơn thuốc do khách hàng tải lên:</span>
                        <div class="border rounded-4 p-2 bg-light text-center">
                            <a href="@Model.AnhDonThuoc" target="_blank" title="Bấm để mở ảnh lớn">
                                <img src="@Model.AnhDonThuoc" alt="Đơn thuốc khách gửi" class="img-fluid rounded-3 shadow-2xs" style="max-height: 380px; object-fit: contain;" />
                            </a>
                        </div>
                        <div class="text-muted small text-center mt-2">
                            <i class="bi bi-zoom-in me-1"></i> Bấm vào ảnh để phóng to kiểm tra chữ ký Bác sĩ &amp; chẩn đoán
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="alert alert-info border-0 rounded-3 small mb-0">
                    <i class="bi bi-info-circle me-1"></i> Đơn hàng này chỉ gồm các sản phẩm không kê đơn (OTC), không bắt buộc thẩm định đơn Bác sĩ.
                </div>
            }
        </div>

        <!-- Bảng Dược phẩm xuất kho FEFO -->
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
            <h5 class="fw-bold mb-3 text-slate-900"><i class="bi bi-box2 text-success me-2"></i>2. Dược phẩm &amp; Lô xuất kho (FEFO)</h5>
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead class="table-light text-muted small text-uppercase">
                        <tr>
                            <th>Tên Thuốc</th>
                            <th>Lô Thuốc (FEFO)</th>
                            <th>Hạn Dùng</th>
                            <th class="text-center">Số Lượng</th>
                            <th class="text-end">Đơn Giá</th>
                            <th class="text-end">Thành Tiền</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.ChiTietHoaDons.Any())
                        {
                            @foreach (var ct in Model.ChiTietHoaDons)
                            {
                                var thuoc = ct.MaLoNavigation?.MaThuocNavigation;
                                var lo = ct.MaLoNavigation;
                                <tr>
                                    <td>
                                        <div class="fw-bold text-slate-900">@(thuoc?.TenThuoc ?? "Thuốc")</div>
                                        @if (thuoc?.KeDon == true)
                                        {
                                            <span class="badge bg-danger text-white rounded-pill" style="font-size: 10px;">Rx Kê đơn</span>
                                        }
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark font-monospace border">@(lo?.SoLo ?? "N/A")</span>
                                    </td>
                                    <td class="small text-muted">
                                        @(lo != null ? lo.HanSuDung.ToString("dd/MM/yyyy") : "-")
                                    </td>
                                    <td class="text-center fw-bold">@ct.SoLuong</td>
                                    <td class="text-end">@ct.DonGia.ToString("N0")</td>
                                    <td class="text-end fw-bold text-success">@((ct.SoLuong * ct.DonGia).ToString("N0")) đ</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center text-muted py-3">Đơn tư vấn khám sơ bộ (Chưa lên đơn xuất lô)</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="5" class="text-end fw-bold">Tổng thanh toán:</td>
                            <td class="text-end fw-bold text-success fs-5">@((Model.TongTien ?? 0).ToString("N0")) đ</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>

    <!-- CỘT PHẢI (5 COLS): QUY TRÌNH DUYỆT ĐƠN & THÔNG TIN KHÁCH HÀNG -->
    <div class="col-lg-5">
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white sticky-top" style="top: 80px;">
            <div class="d-flex justify-content-between align-items-center pb-3 border-bottom mb-3">
                <h5 class="fw-bold mb-0 text-slate-900">Quyết định Thẩm định</h5>
                <span class="badge bg-warning text-dark rounded-pill px-3 py-1">@Model.TrangThai</span>
            </div>

            <!-- Khách hàng -->
            <div class="bg-light rounded-3 p-3 mb-4 small">
                <div class="mb-1"><strong class="text-muted">Mã đơn:</strong> <span class="font-monospace fw-bold">#@Model.MaHd</span></div>
                <div class="mb-1"><strong class="text-muted">Ngày đặt:</strong> @(Model.NgayLap?.ToString("dd/MM/yyyy HH:mm"))</div>
                <div class="mb-1"><strong class="text-muted">Khách hàng:</strong> @(Model.MaKhNavigation?.HoTen ?? "Khách vãng lai")</div>
                <div class="mb-0"><strong class="text-muted">Ghi chú &amp; Địa chỉ:</strong> @Model.GhiChuKhachHang</div>
            </div>

            <!-- Form cập nhật trạng thái (UC10) -->
            <form asp-area="DuocSi" asp-controller="DonHang" asp-action="CapNhatTrangThai" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="maHd" value="@Model.MaHd" />

                <div class="mb-3">
                    <label class="form-label small fw-bold">Ghi chú của Dược sĩ thẩm định:</label>
                    <textarea name="ghiChuDuyet" rows="2" class="form-control form-control-sm" placeholder="Ghi chú: Đơn thuốc hợp lệ, liều dùng an toàn..."></textarea>
                </div>

                <div class="d-grid gap-2">
                    @if (Model.TrangThai == "ChoXacNhan")
                    {
                        <button type="submit" name="trangThaiMoi" value="DaXacNhan" class="btn btn-success py-2.5 rounded-pill fw-bold shadow-sm">
                            <i class="bi bi-check-circle me-1"></i> Duyệt đơn thuốc &amp; Xuất kho FEFO
                        </button>
                    }

                    @if (Model.TrangThai == "DaXacNhan")
                    {
                        <button type="submit" name="trangThaiMoi" value="DangGiao" class="btn btn-primary py-2.5 rounded-pill fw-bold shadow-sm">
                            <i class="bi bi-truck me-1"></i> Bàn giao Shipper (Đang giao hàng)
                        </button>
                    }

                    @if (Model.TrangThai == "DangGiao")
                    {
                        <button type="submit" name="trangThaiMoi" value="HoanTat" class="btn btn-success py-2.5 rounded-pill fw-bold shadow-sm">
                            <i class="bi bi-patch-check me-1"></i> Khách đã nhận &amp; Hoàn tất đơn
                        </button>
                    }

                    @if (Model.TrangThai != "HoanTat" && Model.TrangThai != "DaHuy")
                    {
                        <button type="submit" name="trangThaiMoi" value="DaHuy" class="btn btn-outline-danger btn-sm rounded-pill mt-2" 
                                onclick="return confirm('Bạn có chắc chắn muốn HỦY đơn này? Nếu đơn đã trừ kho, hệ thống sẽ tự động hoàn lại số lượng tồn cho các lô.');">
                            <i class="bi bi-x-circle me-1"></i> Từ chối / Hủy đơn thuốc
                        </button>
                    }
                </div>
            </form>
        </div>
    </div>
</div>
