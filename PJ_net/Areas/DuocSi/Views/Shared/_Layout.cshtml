<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Quầy Dược Sĩ An Tâm</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <style>
        body {
            background-color: #f8fafc;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            color: #1e293b;
        }
        .rail-nav {
            width: 72px;
            background: #ffffff;
            border-right: 1px solid #e2e8f0;
            min-height: 100vh;
            position: fixed;
            top: 0;
            left: 0;
            z-index: 1030;
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 1rem 0;
        }
        .rail-item {
            width: 48px;
            height: 48px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #64748b;
            text-decoration: none;
            margin-bottom: 0.5rem;
            transition: all 0.2s ease;
            position: relative;
        }
        .rail-item:hover {
            background-color: #f1f5f9;
            color: #0f172a;
        }
        .rail-item.active {
            background-color: #ecfdf5;
            color: #059669;
        }
        .main-wrapper {
            margin-left: 72px;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }
        .top-command-bar {
            background: #ffffff;
            border-bottom: 1px solid #e2e8f0;
            height: 64px;
            position: sticky;
            top: 0;
            z-index: 1020;
            display: flex;
            align-items: center;
            padding: 0 1.5rem;
        }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <!-- Minimalist Icon-Rail Sidebar -->
    <aside class="rail-nav shadow-xs">
        <a asp-area="DuocSi" asp-controller="BanHang" asp-action="Index" class="rail-item mb-4" style="background: #059669; color: white;" title="An Tâm Pharmacy POS">
            <i class="bi bi-plus-lg fs-4 fw-bold"></i>
        </a>

        <!-- Menu items -->
        <a asp-area="DuocSi" asp-controller="BanHang" asp-action="Index" 
           class="rail-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "BanHang" ? "active" : "")" 
           title="Bán hàng tại quầy (POS)">
            <i class="bi bi-cart3 fs-5"></i>
        </a>

        <a asp-area="DuocSi" asp-controller="DonHang" asp-action="Index" 
           class="rail-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "DonHang" ? "active" : "")" 
           title="Duyệt đơn thuốc trực tuyến (Rx)">
            <i class="bi bi-file-earmark-medical fs-5"></i>
        </a>

        <a asp-area="DuocSi" asp-controller="LoThuoc" asp-action="Index" 
           class="rail-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "LoThuoc" ? "active" : "")" 
           title="Tra cứu tồn kho lô thuốc (FEFO)">
            <i class="bi bi-boxes fs-5"></i>
        </a>

        <!-- Bottom items -->
        <div class="mt-auto">
            <a asp-area="" asp-controller="Home" asp-action="Index" target="_blank" class="rail-item" title="Xem trang bán lẻ Client">
                <i class="bi bi-box-arrow-up-right fs-5"></i>
            </a>
            @if (User.IsInRole("3"))
            {
                <a asp-area="Admin" asp-controller="Home" asp-action="Index" class="rail-item text-danger" title="Vào trang Quản trị Admin">
                    <i class="bi bi-speedometer2 fs-5"></i>
                </a>
            }
        </div>
    </aside>

    <!-- Main Content Area -->
    <div class="main-wrapper">
        <!-- Top Command Bar -->
        <header class="top-command-bar justify-content-between">
            <div class="d-flex align-items-center gap-3">
                <span class="badge bg-success-subtle text-success border border-success-subtle px-2.5 py-1 rounded-pill fw-bold">
                    Phân hệ Dược Sĩ
                </span>
                <h5 class="fw-bold mb-0 text-slate-800">Nhà thuốc An Tâm <span class="text-success fw-normal small">| Quầy Dược POS &amp; Thẩm định đơn</span></h5>
            </div>

            <div class="d-flex align-items-center gap-3">
                <div class="text-end d-none d-sm-block">
                    <div class="fw-bold small text-slate-800">@User.Identity?.Name</div>
                    <div class="text-success small" style="font-size: 11px;">Dược sĩ trực ca • Quầy 1</div>
                </div>

                <form asp-area="" asp-controller="TaiKhoan" asp-action="DangXuat" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-3">
                        <i class="bi bi-box-arrow-right me-1"></i>Đăng xuất
                    </button>
                </form>
            </div>
        </header>

        <!-- Body -->
        <main class="p-3 p-md-4 flex-grow-1">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
