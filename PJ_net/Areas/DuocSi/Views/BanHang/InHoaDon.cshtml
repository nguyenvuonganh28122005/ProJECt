@model PJ_net.Models.HoaDon
@{
    ViewData["Title"] = "Phiếu thanh toán #" + Model.MaHd;
}

<div class="container py-4" style="max-width: 650px;">
    <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white print-area">
        <!-- Receipt Header -->
        <div class="text-center pb-3 border-bottom mb-3">
            <h4 class="fw-bold text-success mb-1">NHÀ THUỐC AN TÂM</h4>
            <p class="text-muted small mb-1">Chuỗi nhà thuốc đạt chuẩn Thực hành tốt GPP</p>
            <p class="text-muted small mb-0">Địa chỉ: 123 Đường Y Dược, Hà Nội • Hotline: 1900 6868</p>
        </div>

        <div class="text-center mb-4">
            <h5 class="fw-bold text-slate-900 mb-1">HÓA ĐƠN BÁN LẺ THUỐC</h5>
            <span class="font-monospace text-muted small">Mã HĐ: #@Model.MaHd</span>
        </div>

        <div class="row g-2 small mb-4">
            <div class="col-6">
                <span class="text-muted">Ngày lập:</span>
                <span class="fw-bold">@(Model.NgayLap?.ToString("dd/MM/yyyy HH:mm") ?? "-")</span>
            </div>
            <div class="col-6 text-end">
                <span class="text-muted">Hình thức:</span>
                <span class="fw-bold">Tại quầy</span>
            </div>
            <div class="col-12">
                <span class="text-muted">Khách hàng:</span>
                <span class="fw-bold">@Model.GhiChuKhachHang</span>
            </div>
            <div class="col-12">
                <span class="text-muted">Dược sĩ phụ trách:</span>
                <span class="fw-bold">@User.Identity?.Name</span>
            </div>
        </div>

        <!-- Line items -->
        <table class="table table-sm align-middle mb-4">
            <thead class="table-light small">
                <tr>
                    <th>Thuốc &amp; Lô xuất</th>
                    <th class="text-center">SL</th>
                    <th class="text-end">Đơn giá</th>
                    <th class="text-end">Thành tiền</th>
                </tr>
            </thead>
            <tbody class="small">
                @foreach (var ct in Model.ChiTietHoaDons)
                {
                    var thuoc = ct.MaLoNavigation?.MaThuocNavigation;
                    var lo = ct.MaLoNavigation;
                    <tr>
                        <td>
                            <div class="fw-bold text-slate-800">@(thuoc?.TenThuoc ?? "Dược phẩm")</div>
                            <span class="text-muted" style="font-size: 11px;">Lô: @(lo?.SoLo) - HSD: @(lo?.HanSuDung.ToString("dd/MM/yyyy"))</span>
                        </td>
                        <td class="text-center fw-bold">@ct.SoLuong</td>
                        <td class="text-end">@ct.DonGia.ToString("N0")</td>
                        <td class="text-end fw-bold">@((ct.SoLuong * ct.DonGia).ToString("N0"))</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr class="border-top">
                    <td colspan="3" class="fw-bold text-end fs-6">Tổng tiền:</td>
                    <td class="text-end fw-bold text-success fs-5">@((Model.TongTien ?? 0).ToString("N0")) đ</td>
                </tr>
            </tfoot>
        </table>

        <div class="text-center border-top pt-3 text-muted small">
            <p class="mb-1 fst-italic">Cảm ơn Quý khách &amp; Chúc Quý khách mau bình phục sức khỏe!</p>
            <p class="mb-0" style="font-size: 11px;">(Hóa đơn điện tử nội bộ kiểm soát theo tiêu chuẩn FEFO &amp; GPP)</p>
        </div>

        <!-- Buttons for Action -->
        <div class="d-flex gap-2 justify-content-center mt-4 no-print">
            <button type="button" class="btn btn-outline-secondary rounded-pill px-4" onclick="window.print()">
                <i class="bi bi-printer me-1"></i> In hóa đơn
            </button>
            <a asp-action="Index" class="btn btn-success rounded-pill px-4 fw-bold">
                Tạo hóa đơn mới
            </a>
        </div>
    </div>
</div>

<style>
    @@media print {
        .rail-nav, .top-command-bar, .no-print {
            display: none !important;
        }
        .main-wrapper {
            margin-left: 0 !important;
        }
        .print-area {
            box-shadow: none !important;
            border: none !important;
            padding: 0 !important;
        }
    }
</style>
