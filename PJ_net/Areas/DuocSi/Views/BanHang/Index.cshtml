@model IEnumerable<PJ_net.Models.Thuoc>
@{
    ViewData["Title"] = "Bán hàng tại quầy (POS FEFO)";
    var today = (DateOnly)ViewBag.Today;
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-3 mb-4" role="alert">
        <i class="bi bi-check-circle me-1"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show rounded-3 mb-4" role="alert">
        <i class="bi bi-exclamation-triangle me-1"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row g-4">
    <!-- CỘT TRÁI (7 COLS): TÌM KIẾM THUỐC & DANH SÁCH LÔ HÀNG FEFO -->
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h5 class="fw-bold mb-1 text-slate-900"><i class="bi bi-boxes text-success me-2"></i>Kho thuốc &amp; Gợi ý Lô FEFO</h5>
                    <p class="text-muted small mb-0">Hệ thống tự động xếp lô có hạn dùng gần nhất (FEFO) lên trước để xuất bán</p>
                </div>
            </div>

            <!-- Search box -->
            <form method="get" asp-action="Index" class="mb-4">
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-search"></i></span>
                    <input type="text" name="search" value="@ViewBag.Search" class="form-control bg-light border-start-0" 
                           placeholder="Gõ tên thuốc, hoạt chất hoặc số lô để tìm nhanh..." autofocus />
                    <button type="submit" class="btn btn-success px-3">Tìm</button>
                    @if (!string.IsNullOrWhiteSpace(ViewBag.Search))
                    {
                        <a asp-action="Index" class="btn btn-outline-secondary">Xóa</a>
                    }
                </div>
            </form>

            <!-- Drug and Batch list -->
            <div class="divide-y max-h-[550px] overflow-y-auto pe-1" style="max-height: 550px;">
                @foreach (var thuoc in Model)
                {
                    // Lọc các lô còn hạn và còn tồn
                    var loConHan = thuoc.LoThuocs
                        .Where(l => l.HanSuDung > today && l.SoLuongTon > 0)
                        .OrderBy(l => l.HanSuDung)
                        .ToList();

                    if (!loConHan.Any()) continue;

                    <div class="py-3 border-bottom">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div>
                                <h6 class="fw-bold mb-0 text-slate-900">
                                    @thuoc.TenThuoc
                                    @if (thuoc.KeDon == true)
                                    {
                                        <span class="badge bg-danger text-white rounded-pill ms-1" style="font-size: 10px;">Rx Kê đơn</span>
                                    }
                                </h6>
                                <span class="text-muted small">@thuoc.HoatChat • @thuoc.DangBaoChe (@thuoc.DonViTinh)</span>
                            </div>
                            <span class="fw-bold text-success fs-6">@thuoc.GiaBan.ToString("N0") đ</span>
                        </div>

                        <!-- Batches Table for this drug -->
                        <div class="bg-light rounded-3 p-2">
                            <div class="d-flex justify-content-between text-muted small px-2 py-1 fw-bold" style="font-size: 11px;">
                                <span>Số Lô</span>
                                <span>Hạn sử dụng</span>
                                <span>Tồn khả dụng</span>
                                <span>Thao tác</span>
                            </div>

                            @foreach (var lo in loConHan)
                            {
                                int daysRemaining = (lo.HanSuDung.ToDateTime(TimeOnly.MinValue) - DateTime.Today).Days;
                                string badgeHsdClass = daysRemaining <= 60 ? "bg-warning text-dark" : "bg-success-subtle text-success";

                                <div class="d-flex justify-content-between align-items-center bg-white rounded-2 px-2 py-1.5 mb-1 shadow-2xs">
                                    <span class="font-monospace fw-bold text-slate-800 small">@lo.SoLo</span>
                                    <span class="badge @badgeHsdClass small">
                                        @lo.HanSuDung.ToString("dd/MM/yyyy") (@daysRemaining ngày)
                                    </span>
                                    <span class="fw-bold small text-slate-700">@lo.SoLuongTon @thuoc.DonViTinh</span>
                                    <button type="button" class="btn btn-outline-success btn-sm py-0 px-2 rounded-pill fw-bold" 
                                            onclick="addToBill(@lo.MaLo, '@thuoc.TenThuoc.Replace("'", "\\'") (@lo.SoLo)', @thuoc.GiaBan, @lo.SoLuongTon, @(thuoc.KeDon == true ? "true" : "false"))">
                                        + Thêm
                                    </button>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- CỘT PHẢI (5 COLS): HÓA ĐƠN THANH TOÁN TẠI QUẦY (ACTIVE INVOICE) -->
    <div class="col-lg-5">
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white sticky-top" style="top: 80px;">
            <div class="d-flex justify-content-between align-items-center pb-3 border-bottom mb-3">
                <h5 class="fw-bold mb-0 text-slate-900"><i class="bi bi-receipt text-primary me-2"></i>Hóa đơn bán lẻ</h5>
                <span class="badge bg-primary text-white rounded-pill">Tại quầy</span>
            </div>

            <form asp-action="LapHoaDon" method="post" id="posForm">
                @Html.AntiForgeryToken()

                <!-- Thông tin khách -->
                <div class="row g-2 mb-3">
                    <div class="col-7">
                        <label class="form-label small text-muted">Tên khách hàng</label>
                        <input type="text" name="hoTenKhach" class="form-control form-control-sm" placeholder="Khách vãng lai" />
                    </div>
                    <div class="col-5">
                        <label class="form-label small text-muted">Số điện thoại</label>
                        <input type="text" name="sdtKhach" class="form-control form-control-sm" placeholder="SĐT (nếu có)" />
                    </div>
                </div>

                <!-- Bảng sản phẩm trong hóa đơn -->
                <div class="mb-3">
                    <div class="table-responsive" style="max-height: 250px; overflow-y: auto;">
                        <table class="table table-sm align-middle">
                            <thead class="table-light text-muted small" style="font-size: 11px;">
                                <tr>
                                    <th>Mặt hàng (Lô)</th>
                                    <th style="width: 80px;" class="text-center">SL</th>
                                    <th class="text-end">Tiền</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody id="billItemsContainer">
                                <tr id="emptyBillRow">
                                    <td colspan="4" class="text-center text-muted py-4 small">Chưa có sản phẩm nào được chọn</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Ràng buộc thuốc kê đơn (BR02) -->
                <div id="prescriptionAlertBox" class="alert alert-danger rounded-3 p-2 small mb-3 d-none">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="xacNhanDonBacSi" id="chkDonBacSi" value="true">
                        <label class="form-check-label fw-bold text-danger" for="chkDonBacSi">
                            <i class="bi bi-shield-exclamation me-1"></i>Xác nhận đã kiểm tra đơn Bác sĩ hợp lệ
                        </label>
                    </div>
                </div>

                <!-- Tóm tắt thanh toán -->
                <div class="bg-light rounded-3 p-3 mb-3">
                    <div class="d-flex justify-content-between mb-1 text-muted small">
                        <span>Tổng số món:</span>
                        <strong id="totalItemCount">0</strong>
                    </div>
                    <div class="d-flex justify-content-between align-items-baseline">
                        <span class="fw-bold text-slate-800">Tổng tiền phải trả:</span>
                        <span class="fs-4 fw-bold text-success" id="totalBillAmount">0 đ</span>
                    </div>
                </div>

                <!-- Nút thanh toán -->
                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-success py-2.5 rounded-pill fw-bold shadow-sm" id="btnSubmitPos" disabled>
                        <i class="bi bi-printer me-1"></i> In Hóa Đơn &amp; Thanh Toán
                    </button>
                    <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill" onclick="clearBill()">
                        Làm mới hóa đơn
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let billItems = [];

        function addToBill(maLo, name, price, maxStock, isKeDon) {
            let existing = billItems.find(i => i.maLo === maLo);
            if (existing) {
                if (existing.qty + 1 <= maxStock) {
                    existing.qty += 1;
                } else {
                    alert('Lô này chỉ còn tối đa ' + maxStock + ' sản phẩm!');
                }
            } else {
                billItems.push({
                    maLo: maLo,
                    name: name,
                    price: price,
                    qty: 1,
                    maxStock: maxStock,
                    isKeDon: isKeDon
                });
            }
            renderBill();
        }

        function changeQty(index, delta) {
            let item = billItems[index];
            let newQty = item.qty + delta;
            if (newQty <= 0) {
                billItems.splice(index, 1);
            } else if (newQty > item.maxStock) {
                alert('Tồn kho lô này chỉ còn ' + item.maxStock);
            } else {
                item.qty = newQty;
            }
            renderBill();
        }

        function removeItem(index) {
            billItems.splice(index, 1);
            renderBill();
        }

        function clearBill() {
            billItems = [];
            renderBill();
        }

        function renderBill() {
            const container = document.getElementById('billItemsContainer');
            const emptyRow = document.getElementById('emptyBillRow');
            const alertBox = document.getElementById('prescriptionAlertBox');
            const submitBtn = document.getElementById('btnSubmitPos');
            const totalCountSpan = document.getElementById('totalItemCount');
            const totalAmountSpan = document.getElementById('totalBillAmount');

            if (billItems.length === 0) {
                container.innerHTML = '<tr id="emptyBillRow"><td colspan="4" class="text-center text-muted py-4 small">Chưa có sản phẩm nào được chọn</td></tr>';
                alertBox.classList.add('d-none');
                submitBtn.disabled = true;
                totalCountSpan.innerText = '0';
                totalAmountSpan.innerText = '0 đ';
                return;
            }

            let html = '';
            let total = 0;
            let totalItems = 0;
            let hasPrescription = false;

            billItems.forEach((item, idx) => {
                let subtotal = item.qty * item.price;
                total += subtotal;
                totalItems += item.qty;
                if (item.isKeDon) hasPrescription = true;

                html += `
                    <tr>
                        <td>
                            <div class="fw-bold small text-slate-800 text-truncate" style="max-width: 140px;">${item.name}</div>
                            <span class="text-muted" style="font-size: 11px;">${item.price.toLocaleString('vi-VN')} đ</span>
                            <input type="hidden" name="items[${idx}].MaLo" value="${item.maLo}" />
                            <input type="hidden" name="items[${idx}].SoLuong" value="${item.qty}" />
                        </td>
                        <td class="text-center">
                            <div class="input-group input-group-sm justify-content-center">
                                <button type="button" class="btn btn-outline-secondary btn-sm px-1.5" onclick="changeQty(${idx}, -1)">-</button>
                                <span class="px-2 py-1 fw-bold small">${item.qty}</span>
                                <button type="button" class="btn btn-outline-secondary btn-sm px-1.5" onclick="changeQty(${idx}, 1)">+</button>
                            </div>
                        </td>
                        <td class="text-end fw-bold text-success small">
                            ${subtotal.toLocaleString('vi-VN')} đ
                        </td>
                        <td class="text-end">
                            <button type="button" class="btn btn-outline-danger btn-sm border-0 py-0 px-1" onclick="removeItem(${idx})">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        </td>
                    </tr>
                `;
            });

            container.innerHTML = html;
            totalCountSpan.innerText = totalItems;
            totalAmountSpan.innerText = total.toLocaleString('vi-VN') + ' đ';
            submitBtn.disabled = false;

            if (hasPrescription) {
                alertBox.classList.remove('d-none');
            } else {
                alertBox.classList.add('d-none');
            }
        }
    </script>
}
