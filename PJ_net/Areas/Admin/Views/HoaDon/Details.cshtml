@model PJ_net.Models.HoaDon
@{
    ViewData["Title"] = $"Chi tiết hóa đơn #{Model.MaHd}";
}

<!--begin::App Main-->
<main class="app-main">
    <!--begin::App Content Header-->
    <div class="app-content-header">
        <div class="container-fluid">
            <div class="row">
                <div class="col-sm-6">
                    <h3 class="mb-0 text-light">Chi tiết hóa đơn #@Model.MaHd</h3>
                </div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-end">
                        <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Home" asp-action="Index">Trang chủ</a></li>
                        <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="HoaDon" asp-action="Index">Hóa đơn</a></li>
                        <li class="breadcrumb-item active" aria-current="page">#@Model.MaHd</li>
                    </ol>
                </div>
            </div>
        </div>
    </div>
    <!--end::App Content Header-->
    <!--begin::App Content-->
    <div class="app-content">
        <div class="container-fluid">

            <div class="card shadow-sm mb-4 border-secondary">
                <div class="card-header bg-dark border-secondary text-light d-flex justify-content-between align-items-center py-3">
                    <h5 class="mb-0">
                        <i class="bi bi-receipt me-2 text-primary"></i> Thông tin đơn hàng
                    </h5>
                    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
                        <i class="bi bi-arrow-left me-1"></i> Trở về danh sách
                    </a>
                </div>

                <div class="card-body text-light">
                    <div class="row mb-4">
                        <div class="col-md-6">
                            <h6 class="fw-bold text-info text-uppercase fs-7 mb-2">Khách hàng</h6>
                            <p class="mb-1"><strong>Họ tên:</strong> @(Model.MaKhNavigation?.HoTen ?? "Khách vãng lai")</p>
                            <p class="mb-1"><strong>Số điện thoại:</strong> @(Model.MaKhNavigation?.SoDienThoai ?? "—")</p>
                            <p class="mb-1"><strong>Ghi chú:</strong> @(string.IsNullOrWhiteSpace(Model.GhiChuKhachHang) ? "Không có" : Model.GhiChuKhachHang)</p>
                        </div>
                        <div class="col-md-6">
                            <h6 class="fw-bold text-info text-uppercase fs-7 mb-2">Thông tin thanh toán</h6>
                            <p class="mb-1"><strong>Ngày tạo:</strong> @(Model.NgayLap.HasValue ? Model.NgayLap.Value.ToString("dd/MM/yyyy HH:mm") : "—")</p>
                            <p class="mb-1"><strong>Hình thức mua:</strong> @(Model.HinhThuc ?? "Trực tiếp")</p>
                            <p class="mb-1">
                                <strong>Trạng thái:</strong>
                                <span class="badge text-bg-primary">@Model.TrangThai</span>
                            </p>
                        </div>
                    </div>

                    <h5 class="fw-bold mb-3 border-bottom border-secondary pb-2 text-light">
                        <i class="bi bi-capsule me-1 text-success"></i> Danh sách thuốc trong đơn
                    </h5>

                    <div class="table-responsive">
                        <table class="table table-bordered table-striped table-dark align-middle mb-0">
                            <thead class="table-dark">
                                <tr>
                                    <th style="width: 50px;" class="text-center">STT</th>
                                    <th>Tên thuốc</th>
                                    <th class="text-center">Số lô</th>
                                    <th class="text-center">Số lượng</th>
                                    <th class="text-end">Đơn giá</th>
                                    <th class="text-end">Thành tiền</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.ChiTietHoaDons == null || !Model.ChiTietHoaDons.Any())
                                {
                                    <tr>
                                        <td colspan="6" class="text-center text-muted py-3">
                                            Chưa có dữ liệu chi tiết mặt hàng cho hóa đơn này.
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    var stt = 1;
                                    foreach (var ct in Model.ChiTietHoaDons)
                                    {
                                        var thanhTien = ct.SoLuong * ct.DonGia;
                                        <tr>
                                            <td class="text-center text-light">@(stt++)</td>
                                            <td class="fw-semibold text-primary">
                                                @(ct.MaLoNavigation?.MaThuocNavigation?.TenThuoc ?? "—")
                                            </td>
                                            <td class="text-center font-monospace text-light">
                                                @(ct.MaLoNavigation?.SoLo ?? "—")
                                            </td>
                                            <td class="text-center fw-bold text-light">
                                                @ct.SoLuong
                                            </td>
                                            <td class="text-end text-light">
                                                @string.Format("{0:N0} đ", ct.DonGia)
                                            </td>
                                            <td class="text-end fw-bold text-success">
                                                @string.Format("{0:N0} đ", thanhTien)
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                            <tfoot>
                                <tr class="table-dark">
                                    <td colspan="5" class="text-end fw-bold fs-6 text-light">Tổng cộng:</td>
                                    <td class="text-end fw-bold text-danger fs-5">
                                        @string.Format("{0:N0} đ", Model.TongTien ?? 0)
                                    </td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>

        </div>
    </div>
    <!--end::App Content-->
</main>
<!--end::App Main-->