@model PJ_net.Models.TaiKhoan
@{
    ViewData["Title"] = "Xác nhận xóa nhân viên";
}

<!--begin::App Main-->
<main class="app-main">
  <!--begin::App Content Header-->
  <div class="app-content-header">
    <div class="container-fluid">
      <div class="row">
        <div class="col-sm-6">
          <h3 class="mb-0 text-danger">
            <i class="bi bi-trash3-fill me-2"></i>Xóa nhân viên
          </h3>
        </div>
        <div class="col-sm-6">
          <ol class="breadcrumb float-sm-end">
            <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Home" asp-action="Index">Trang chủ</a></li>
            <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="NhanVien" asp-action="Index">Nhân viên</a></li>
            <li class="breadcrumb-item active" aria-current="page">Xóa</li>
          </ol>
        </div>
      </div>
    </div>
  </div>
  <!--end::App Content Header-->

  <!--begin::App Content-->
  <div class="app-content">
    <div class="container-fluid">
      <div class="row justify-content-center">
        <div class="col-lg-7">
          <div class="card border-secondary shadow-sm">
            <div class="card-header bg-danger text-white py-3">
              <h5 class="card-title mb-0">
                <i class="bi bi-exclamation-triangle-fill me-2"></i> Cảnh báo: Xác nhận xóa tài khoản nhân viên
              </h5>
            </div>

            <div class="card-body text-light">
              <div class="alert alert-warning mb-4 border-secondary" role="alert">
                <i class="bi bi-info-circle-fill me-2"></i>
                Bạn có chắc chắn muốn xóa nhân viên này khỏi hệ thống không? Hành động này không thể hoàn tác nếu tiếp tục.
              </div>

              <table class="table table-bordered table-dark border-secondary align-middle mb-0">
                <tbody>
                  <tr>
                    <th style="width: 180px;" class="bg-dark text-light border-secondary">Mã nhân viên:</th>
                    <td class="fw-bold text-light border-secondary">#@Model.MaTk</td>
                  </tr>
                  <tr>
                    <th class="bg-dark text-light border-secondary">Họ và tên:</th>
                    <td class="fw-bold fs-5 text-danger border-secondary">@Model.HoTen</td>
                  </tr>
                  <tr>
                    <th class="bg-dark text-light border-secondary">Tên đăng nhập:</th>
                    <td class="font-monospace text-info border-secondary">@Model.TenDangNhap</td>
                  </tr>
                  <tr>
                    <th class="bg-dark text-light border-secondary">Số điện thoại:</th>
                    <td class="text-light border-secondary">@(Model.SoDienThoai ?? "Chưa có")</td>
                  </tr>
                  <tr>
                    <th class="bg-dark text-light border-secondary">Vai trò hiện tại:</th>
                    <td class="border-secondary">
                      @switch (Model.VaiTro)
                      {
                        case 2:
                          <span class="badge text-bg-primary">Dược sĩ / Bán hàng</span>
                          break;
                        case 3:
                          <span class="badge text-bg-danger">Quản trị viên</span>
                          break;
                        case 0:
                          <span class="badge text-bg-secondary">Quản trị viên cũ</span>
                          break;
                        default:
                          <span class="badge text-bg-secondary">Khác (@Model.VaiTro)</span>
                          break;
                      }
                    </td>
                  </tr>
                  @if (Model.HoaDons != null && Model.HoaDons.Any())
                  {
                    <tr>
                      <th class="bg-dark text-danger border-secondary">Ràng buộc dữ liệu:</th>
                      <td class="text-danger fw-semibold border-secondary">
                        <i class="bi bi-exclamation-octagon me-1"></i> Có @Model.HoaDons.Count hóa đơn liên quan đến tài khoản này. Không thể xóa trực tiếp.
                      </td>
                    </tr>
                  }
                </tbody>
              </table>
            </div>

            <div class="card-footer bg-dark border-secondary d-flex justify-content-between">
              <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i> Hủy & Quay lại
              </a>

              <form asp-action="Delete" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.MaTk" />
                <button type="submit" class="btn btn-danger" @(Model.HoaDons != null && Model.HoaDons.Any() ? "disabled" : "")>
                  <i class="bi bi-trash-fill me-1"></i> Xác nhận xóa
                </button>
              </form>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <!--end::App Content-->
</main>
<!--end::App Main-->