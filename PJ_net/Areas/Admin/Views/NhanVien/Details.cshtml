@model PJ_net.Models.TaiKhoan
@{
    ViewData["Title"] = "Chi tiết nhân viên";
}

<!--begin::App Main-->
<main class="app-main">
  <!--begin::App Content Header-->
  <div class="app-content-header">
    <div class="container-fluid">
      <div class="row">
        <div class="col-sm-6">
          <h3 class="mb-0 text-light">
            <i class="bi bi-person-lines-fill text-info me-2"></i>Hồ sơ nhân viên #@Model.MaTk
          </h3>
        </div>
        <div class="col-sm-6">
          <ol class="breadcrumb float-sm-end">
            <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Home" asp-action="Index">Trang chủ</a></li>
            <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="NhanVien" asp-action="Index">Nhân viên</a></li>
            <li class="breadcrumb-item active" aria-current="page">Chi tiết</li>
          </ol>
        </div>
      </div>
    </div>
  </div>
  <!--end::App Content Header-->

  <!--begin::App Content-->
  <div class="app-content">
    <div class="container-fluid">
      <div class="row justify-content-center">
        <div class="col-lg-8">
          <div class="card shadow-sm mb-4 border-secondary">
            <div class="card-header bg-dark border-secondary text-light d-flex justify-content-between align-items-center py-3">
              <h5 class="card-title mb-0">
                <i class="bi bi-info-circle me-2 text-info"></i> Thông tin cá nhân & Phân quyền
              </h5>
              <div>
                @switch (Model.VaiTro)
                {
                  case 0:
                    <span class="badge text-bg-danger px-3 py-2">Quản trị viên</span>
                    break;
                  case 2:
                    <span class="badge text-bg-primary px-3 py-2">Dược sĩ / Bán hàng</span>
                    break;
                  case 3:
                    <span class="badge text-bg-warning text-dark px-3 py-2">Quản lý kho</span>
                    break;
                  default:
                    <span class="badge text-bg-secondary px-3 py-2">Khác</span>
                    break;
                }
              </div>
            </div>

            <div class="card-body p-0">
              <table class="table table-bordered table-dark border-secondary align-middle mb-0">
                <tbody>
                  <tr>
                    <th style="width: 200px;" class="bg-dark text-light border-secondary">Mã nhân viên:</th>
                    <td class="fw-bold text-light border-secondary">#@Model.MaTk</td>
                  </tr>
                  <tr>
                    <th class="bg-dark text-light border-secondary">Họ và tên:</th>
                    <td class="fs-5 fw-bold text-primary border-secondary">@Model.HoTen</td>
                  </tr>
                  <tr>
                    <th class="bg-dark text-light border-secondary">Tên đăng nhập:</th>
                    <td class="font-monospace text-info border-secondary">@Model.TenDangNhap</td>
                  </tr>
                  <tr>
                    <th class="bg-dark text-light border-secondary">Số điện thoại:</th>
                    <td class="border-secondary">
                      @if (!string.IsNullOrWhiteSpace(Model.SoDienThoai))
                      {
                        <span class="badge text-bg-dark border border-secondary text-light font-monospace">
                          <i class="bi bi-telephone me-1 text-info"></i>@Model.SoDienThoai
                        </span>
                      }
                      else
                      {
                        <span class="text-muted">Chưa cập nhật</span>
                      }
                    </td>
                  </tr>
                  <tr>
                    <th class="bg-dark text-light border-secondary">Vai trò hệ thống:</th>
                    <td class="text-light border-secondary">
                      @if (Model.VaiTro == 0)
                      {
                        <span>Quản trị viên (Toàn quyền hệ thống, quản lý tài khoản & danh mục)</span>
                      }
                      else if (Model.VaiTro == 2)
                      {
                        <span>Dược sĩ (Tư vấn, kê đơn, bán lẻ thuốc và quản lý hóa đơn)</span>
                      }
                      else if (Model.VaiTro == 3)
                      {
                        <span>Quản lý kho (Nhập hàng về kho, kiểm tra hạn dùng, lô thuốc)</span>
                      }
                      else
                      {
                        <span>Nhân sự (Mã vai trò: @Model.VaiTro)</span>
                      }
                    </td>
                  </tr>
                </tbody>
              </table>
            </div>

            <div class="card-footer bg-dark border-secondary d-flex justify-content-between py-3">
              <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i> Quay lại danh sách
              </a>
              <div class="d-flex gap-2">
                <a asp-action="Edit" asp-route-id="@Model.MaTk" class="btn btn-warning">
                  <i class="bi bi-pencil me-1"></i> Chỉnh sửa
                </a>
                <a asp-action="Delete" asp-route-id="@Model.MaTk" class="btn btn-outline-danger">
                  <i class="bi bi-trash me-1"></i> Xóa
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <!--end::App Content-->
</main>
<!--end::App Main-->