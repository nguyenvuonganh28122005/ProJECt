@{
    ViewData["Title"] = "Thống kê doanh thu & Thuốc bán chạy";
    var topThuoc = ViewBag.TopThuoc as List<PJ_net.Areas.Admin.Controllers.ThuocBanChayDto> ?? new List<PJ_net.Areas.Admin.Controllers.ThuocBanChayDto>();
    var tongDoanhThu = (decimal)(ViewBag.TongDoanhThu ?? 0m);
    var tongSoDon = (int)(ViewBag.TongSoDon ?? 0);
}

<!--begin::App Main-->
<main class="app-main">
  <!--begin::App Content Header-->
  <div class="app-content-header">
    <div class="container-fluid">
      <div class="row">
        <div class="col-sm-6">
          <h3 class="mb-0 text-light">Thống kê doanh thu & Thuốc bán chạy</h3>
        </div>
        <div class="col-sm-6">
          <ol class="breadcrumb float-sm-end">
            <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Home" asp-action="Index">Trang chủ</a></li>
            <li class="breadcrumb-item active" aria-current="page">Thống kê</li>
          </ol>
        </div>
      </div>
    </div>
  </div>
  <!--end::App Content Header-->

  <!--begin::App Content-->
  <div class="app-content">
    <div class="container-fluid">

      <!-- Row Tổng quan doanh thu -->
      <div class="row mb-4">
        <div class="col-lg-6 col-12">
          <div class="small-box text-bg-success">
            <div class="inner">
              <h3>@string.Format("{0:N0} đ", tongDoanhThu)</h3>
              <p class="fs-6">Tổng doanh thu bán thuốc</p>
            </div>
            <i class="small-box-icon bi bi-cash-coin"></i>
          </div>
        </div>

        <div class="col-lg-6 col-12">
          <div class="small-box text-bg-primary">
            <div class="inner">
              <h3>@tongSoDon</h3>
              <p class="fs-6">Tổng số đơn hàng thực hiện</p>
            </div>
            <i class="small-box-icon bi bi-receipt-cutoff"></i>
          </div>
        </div>
      </div>

      <!-- Bảng Top thuốc bán chạy -->
      <div class="card shadow-sm mb-4 border-secondary">
        <div class="card-header bg-dark border-secondary py-3">
          <div class="d-flex justify-content-between align-items-center">
            <h5 class="card-title fw-bold text-light mb-0">
              <i class="bi bi-trophy-fill text-warning me-2"></i>
              Top 10 mặt hàng thuốc bán chạy nhất
            </h5>
            <span class="badge text-bg-info">Xếp hạng theo sản lượng</span>
          </div>
        </div>

        <div class="card-body table-responsive p-0">
          <table class="table table-hover table-striped table-dark align-middle mb-0">
            <thead class="table-dark">
              <tr>
                <th style="width: 80px;" class="text-center">Xếp hạng</th>
                <th>Tên thuốc</th>
                <th class="text-center">Đơn vị tính</th>
                <th class="text-center">Số lượng đã bán</th>
                <th class="text-end">Doanh thu thu về</th>
              </tr>
            </thead>
            <tbody>
              @if (!topThuoc.Any())
              {
                <tr>
                  <td colspan="5" class="text-center text-muted py-4">
                    <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                    Chưa có phát sinh dữ liệu bán hàng.
                  </td>
                </tr>
              }
              else
              {
                var rank = 1;
                @foreach (var item in topThuoc)
                {
                  <tr>
                    <td class="text-center">
                      @if (rank == 1)
                      {
                        <span class="badge text-bg-warning text-dark rounded-circle p-2 fs-6">🥇 1</span>
                      }
                      else if (rank == 2)
                      {
                        <span class="badge text-bg-secondary rounded-circle p-2 fs-6">🥈 2</span>
                      }
                      else if (rank == 3)
                      {
                        <span class="badge text-bg-danger rounded-circle p-2 fs-6">🥉 3</span>
                      }
                      else
                      {
                        <span class="badge text-bg-dark border border-secondary text-light fs-6">#@rank</span>
                      }
                    </td>
                    <td class="fw-semibold text-primary">
                      @item.TenThuoc
                    </td>
                    <td class="text-center">
                      <span class="badge text-bg-dark border border-secondary text-light">@(item.DonViTinh ?? "Đơn vị")</span>
                    </td>
                    <td class="text-center fw-bold fs-6 text-light">
                      @item.TongSoLuongBan
                    </td>
                    <td class="text-end fw-bold text-success fs-6">
                      @string.Format("{0:N0} đ", item.TongDoanhThu)
                    </td>
                  </tr>
                  rank++;
                }
              }
            </tbody>
          </table>
        </div>

        <div class="card-footer bg-dark border-secondary text-light">
          Dữ liệu thống kê dựa trên tất cả hóa đơn hợp lệ trong cơ sở dữ liệu.
        </div>
      </div>

    </div>
  </div>
  <!--end::App Content-->
</main>
<!--end::App Main-->