@model PJ_net.Models.N6NhomThuoc
@{
    ViewData["Title"] = "Thêm mới nhóm thuốc";
}

<!--begin::App Main-->
<main class="app-main">
  <!--begin::App Content Header-->
  <div class="app-content-header">
    <div class="container-fluid">
      <div class="row">
        <div class="col-sm-6">
          <h3 class="mb-0 text-light">Thêm mới nhóm thuốc</h3>
        </div>
        <div class="col-sm-6">
          <ol class="breadcrumb float-sm-end">
            <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Home" asp-action="Index">Trang chủ</a></li>
            <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="NhomThuoc" asp-action="Index">Nhóm thuốc</a></li>
            <li class="breadcrumb-item active" aria-current="page">Thêm mới</li>
          </ol>
        </div>
      </div>
    </div>
  </div>
  <!--end::App Content Header-->

  <!--begin::App Content-->
  <div class="app-content">
    <div class="container-fluid">
      <div class="row justify-content-center">
        <div class="col-lg-8">
          <div class="card shadow-sm border-secondary">
            <div class="card-header bg-primary text-white py-3">
              <h5 class="card-title mb-0">
                <i class="bi bi-folder-plus me-2"></i> Thông tin nhóm thuốc mới
              </h5>
            </div>
            
            <form asp-action="Create" method="post">
              @Html.AntiForgeryToken()
              <div class="card-body text-light">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <div class="mb-3">
                  <label asp-for="TenNhom" class="form-label fw-semibold text-light">
                    Tên nhóm thuốc <span class="text-danger">*</span>
                  </label>
                  <input
                    asp-for="TenNhom"
                    class="form-control form-control-lg bg-dark text-light border-secondary"
                    placeholder="Ví dụ: Kháng sinh, Giảm đau hạ sốt, Vitamin & Khoáng chất..."
                    required
                    autofocus
                  />
                  <span asp-validation-for="TenNhom" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                  <label asp-for="MoTa" class="form-label fw-semibold text-light">Mô tả chi tiết</label>
                  <textarea
                    asp-for="MoTa"
                    class="form-control bg-dark text-light border-secondary"
                    rows="4"
                    placeholder="Ghi chú về nhóm điều trị, công dụng chung hoặc lưu ý sử dụng..."
                  ></textarea>
                  <span asp-validation-for="MoTa" class="text-danger small"></span>
                </div>
              </div>

              <div class="card-footer bg-dark border-secondary d-flex justify-content-between py-3">
                <a asp-action="Index" class="btn btn-outline-secondary">
                  <i class="bi bi-arrow-left me-1"></i> Quay lại danh sách
                </a>
                <button type="submit" class="btn btn-primary px-4">
                  <i class="bi bi-check-circle me-1"></i> Lưu nhóm thuốc
                </button>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>
  <!--end::App Content-->
</main>
<!--end::App Main-->