@model PJ_net.Models.LoThuoc
@{
    ViewData["Title"] = "Nhập hàng về kho";
    var thuocs = ViewBag.Thuocs as List<PJ_net.Models.Thuoc> ?? new List<PJ_net.Models.Thuoc>();
    var nccs = ViewBag.NhaCungCaps as List<PJ_net.Models.NhaCungCap> ?? new List<PJ_net.Models.NhaCungCap>();
}

<!--begin::App Main-->
<main class="app-main">
  <!--begin::App Content Header-->
  <div class="app-content-header">
    <div class="container-fluid">
      <div class="row">
        <div class="col-sm-6">
          <h3 class="mb-0 text-light">Nhập hàng về kho</h3>
        </div>
        <div class="col-sm-6">
          <ol class="breadcrumb float-sm-end">
            <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Home" asp-action="Index">Trang chủ</a></li>
            <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="LoThuoc" asp-action="Index">Lô thuốc</a></li>
            <li class="breadcrumb-item active" aria-current="page">Nhập hàng</li>
          </ol>
        </div>
      </div>
    </div>
  </div>
  <!--end::App Content Header-->

  <!--begin::App Content-->
  <div class="app-content">
    <div class="container-fluid">
      <div class="row justify-content-center">
        <div class="col-lg-9">
          <div class="card shadow-sm border-secondary">
            <div class="card-header bg-success text-white">
              <h5 class="card-title mb-0">
                <i class="bi bi-box-arrow-in-down me-2"></i> Thông tin phiếu nhập lô thuốc
              </h5>
            </div>

            <form asp-action="Create" method="post">
              @Html.AntiForgeryToken()
              <div class="card-body text-light">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <div class="row g-3">
                  <!-- Chọn Thuốc -->
                  <div class="col-md-6">
                    <label asp-for="MaThuoc" class="form-label fw-semibold text-light">
                      Mặt hàng thuốc <span class="text-danger">*</span>
                    </label>
                    <select asp-for="MaThuoc" class="form-select bg-dark text-light border-secondary" required>
                      <option value="" class="bg-dark text-light">-- Chọn thuốc --</option>
                      @foreach (var t in thuocs)
                      {
                        <option value="@t.MaThuoc" class="bg-dark text-light">@t.TenThuoc (@t.DonViTinh)</option>
                      }
                    </select>
                    <span asp-validation-for="MaThuoc" class="text-danger small"></span>
                  </div>

                  <!-- Chọn Nhà cung cấp -->
                  <div class="col-md-6">
                    <label asp-for="MaNcc" class="form-label fw-semibold text-light">
                      Nhà cung cấp <span class="text-danger">*</span>
                    </label>
                    <select asp-for="MaNcc" class="form-select bg-dark text-light border-secondary" required>
                      <option value="" class="bg-dark text-light">-- Chọn nhà cung cấp --</option>
                      @foreach (var n in nccs)
                      {
                        <option value="@n.MaNcc" class="bg-dark text-light">@n.TenNcc</option>
                      }
                    </select>
                    <span asp-validation-for="MaNcc" class="text-danger small"></span>
                  </div>

                  <!-- Số lô -->
                  <div class="col-md-4">
                    <label asp-for="SoLo" class="form-label fw-semibold text-light">
                      Số lô sản xuất <span class="text-danger">*</span>
                    </label>
                    <input asp-for="SoLo" class="form-control bg-dark text-light border-secondary font-monospace" placeholder="Ví dụ: LO-2026-001" required />
                    <span asp-validation-for="SoLo" class="text-danger small"></span>
                  </div>

                  <!-- Ngày SX -->
                  <div class="col-md-4">
                    <label asp-for="NgaySx" class="form-label fw-semibold text-light">Ngày sản xuất</label>
                    <input asp-for="NgaySx" type="date" class="form-control bg-dark text-light border-secondary" />
                    <span asp-validation-for="NgaySx" class="text-danger small"></span>
                  </div>

                  <!-- Hạn sử dụng -->
                  <div class="col-md-4">
                    <label asp-for="HanSuDung" class="form-label fw-semibold text-light">
                      Hạn sử dụng <span class="text-danger">*</span>
                    </label>
                    <input asp-for="HanSuDung" type="date" class="form-control bg-dark text-light border-secondary" required />
                    <span asp-validation-for="HanSuDung" class="text-danger small"></span>
                  </div>

                  <!-- Số lượng nhập -->
                  <div class="col-md-6">
                    <label asp-for="SoLuongTon" class="form-label fw-semibold text-light">
                      Số lượng nhập kho <span class="text-danger">*</span>
                    </label>
                    <input asp-for="SoLuongTon" type="number" min="1" class="form-control bg-dark text-light border-secondary" placeholder="Nhập số lượng..." required />
                    <span asp-validation-for="SoLuongTon" class="text-danger small"></span>
                  </div>

                  <!-- Giá nhập -->
                  <div class="col-md-6">
                    <label asp-for="GiaNhap" class="form-label fw-semibold text-light">
                      Giá nhập (VNĐ) <span class="text-danger">*</span>
                    </label>
                    <div class="input-group">
                      <input asp-for="GiaNhap" type="number" step="1000" min="0" class="form-control bg-dark text-light border-secondary" placeholder="Giá nhập mỗi đơn vị..." required />
                      <span class="input-group-text bg-dark text-light border-secondary">đ</span>
                    </div>
                    <span asp-validation-for="GiaNhap" class="text-danger small"></span>
                  </div>
                </div>
              </div>

              <div class="card-footer bg-dark border-secondary d-flex justify-content-between">
                <a asp-action="Index" class="btn btn-outline-secondary">
                  <i class="bi bi-arrow-left me-1"></i> Quay lại danh sách lô
                </a>
                <button type="submit" class="btn btn-success px-4">
                  <i class="bi bi-check-circle me-1"></i> Xác nhận nhập kho
                </button>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>
  <!--end::App Content-->
</main>
<!--end::App Main-->