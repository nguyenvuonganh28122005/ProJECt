@model PJ_net.Models.TaiKhoan
@{
    ViewData["Title"] = $"Lịch sử mua hàng - {Model.HoTen}";
}

<!--begin::App Main-->
<main class="app-main">
  <!--begin::App Content Header-->
  <div class="app-content-header">
    <div class="container-fluid">
      <div class="row">
        <div class="col-sm-6">
          <h3 class="mb-0 text-light">Lịch sử mua hàng</h3>
        </div>
        <div class="col-sm-6">
          <ol class="breadcrumb float-sm-end">
            <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Home" asp-action="Index">Trang chủ</a></li>
            <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="KhachHang" asp-action="Index">Khách hàng</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.HoTen</li>
          </ol>
        </div>
      </div>
    </div>
  </div>
  <!--end::App Content Header-->

  <!--begin::App Content-->
  <div class="app-content">
    <div class="container-fluid">

      <div class="card shadow-sm mb-4 border-secondary">
        <div class="card-header bg-dark border-secondary text-light d-flex justify-content-between align-items-center py-3">
          <h5 class="mb-0">
            <i class="bi bi-person-badge text-primary me-2"></i> Khách hàng: <strong class="text-light">@Model.HoTen</strong>
          </h5>
          <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Trở về danh sách
          </a>
        </div>

        <div class="card-body text-light">
          <div class="row mb-3">
            <div class="col-md-4">
              <p class="mb-1"><strong>Tài khoản:</strong> <span class="text-info">@Model.TenDangNhap</span></p>
              <p class="mb-1"><strong>Số điện thoại:</strong> @(Model.SoDienThoai ?? "—")</p>
            </div>
            <div class="col-md-4">
              <p class="mb-1"><strong>Tổng số đơn hàng:</strong> <span class="badge text-bg-secondary">@Model.HoaDons.Count</span></p>
              <p class="mb-1">
                <strong>Tổng tiền đã chi:</strong>
                <span class="text-success fw-bold">
                  @string.Format("{0:N0} đ", Model.HoaDons.Where(h => h.TrangThai != "Huy").Sum(h => h.TongTien ?? 0))
                </span>
              </p>
            </div>
          </div>

          <h5 class="fw-bold mb-3 border-bottom border-secondary pb-2 text-light">
            <i class="bi bi-receipt me-1 text-info"></i> Các đơn hàng đã đặt
          </h5>

          <div class="table-responsive">
            <table class="table table-hover table-striped table-dark align-middle mb-0">
              <thead class="table-dark">
                <tr>
                  <th style="width: 80px;" class="text-center">Mã HĐ</th>
                  <th class="text-center">Ngày đặt</th>
                  <th>Hình thức</th>
                  <th class="text-center">Trạng thái</th>
                  <th class="text-end">Tổng tiền</th>
                  <th style="width: 120px;" class="text-center">Chi tiết</th>
                </tr>
              </thead>
              <tbody>
                @if (!Model.HoaDons.Any())
                {
                  <tr>
                    <td colspan="6" class="text-center text-muted py-3">
                      Khách hàng này chưa có đơn hàng nào.
                    </td>
                  </tr>
                }
                else
                {
                  @foreach (var hd in Model.HoaDons.OrderByDescending(h => h.NgayLap))
                  {
                    <tr>
                      <td class="text-center fw-bold text-light">#@hd.MaHd</td>
                      <td class="text-center text-secondary">
                        @(hd.NgayLap.HasValue ? hd.NgayLap.Value.ToString("dd/MM/yyyy HH:mm") : "—")
                      </td>
                      <td>
                        <span class="badge text-bg-dark border border-secondary text-light">@(hd.HinhThuc ?? "Trực tiếp")</span>
                      </td>
                      <td class="text-center">
                        @switch (hd.TrangThai)
                        {
                          case "ChoXacNhan":
                            <span class="badge text-bg-warning">Chờ xác nhận</span>
                            break;
                          case "DaThanhToan":
                            <span class="badge text-bg-info">Đã thanh toán</span>
                            break;
                          case "HoanThanh":
                            <span class="badge text-bg-success">Hoàn thành</span>
                            break;
                          case "Huy":
                            <span class="badge text-bg-danger">Đã hủy</span>
                            break;
                          default:
                            <span class="badge text-bg-secondary">@(hd.TrangThai ?? "Mới")</span>
                            break;
                        }
                      </td>
                      <td class="text-end fw-bold text-success">
                        @string.Format("{0:N0} đ", hd.TongTien ?? 0)
                      </td>
                      <td class="text-center">
                        <a asp-area="Admin" asp-controller="HoaDon" asp-action="Details" asp-route-id="@hd.MaHd" class="btn btn-sm btn-outline-primary">
                          <i class="bi bi-eye"></i> Xem đơn
                        </a>
                      </td>
                    </tr>
                  }
                }
              </tbody>
            </table>
          </div>
        </div>
      </div>

    </div>
  </div>
  <!--end::App Content-->
</main>
<!--end::App Main-->