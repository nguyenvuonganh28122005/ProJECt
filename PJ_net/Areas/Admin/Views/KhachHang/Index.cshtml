@model IEnumerable<PJ_net.Models.TaiKhoan>
@{
    ViewData["Title"] = "Quản lý khách hàng";
}

<!--begin::App Main-->
<main class="app-main">
  <!--begin::App Content Header-->
  <div class="app-content-header">
    <div class="container-fluid">
      <div class="row">
        <div class="col-sm-6">
          <h3 class="mb-0 text-light">Quản lý khách hàng</h3>
        </div>
        <div class="col-sm-6">
          <ol class="breadcrumb float-sm-end">
            <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Home" asp-action="Index">Trang chủ</a></li>
            <li class="breadcrumb-item active" aria-current="page">Khách hàng</li>
          </ol>
        </div>
      </div>
    </div>
  </div>
  <!--end::App Content Header-->

  <!--begin::App Content-->
  <div class="app-content">
    <div class="container-fluid">

      <div class="card shadow-sm mb-4 border-secondary">
        <div class="card-header bg-dark border-secondary py-3">
          <form method="get" asp-action="Index" class="d-flex align-items-center" style="max-width: 400px;">
            <div class="input-group">
              <input
                type="text"
                name="search"
                value="@ViewBag.Search"
                class="form-control bg-dark text-light border-secondary"
                placeholder="Tìm theo họ tên, username, SĐT..."
              />
              <button class="btn btn-outline-secondary text-light border-secondary" type="submit">
                <i class="bi bi-search"></i>
              </button>
              @if (!string.IsNullOrEmpty(ViewBag.Search))
              {
                <a asp-action="Index" class="btn btn-outline-danger" title="Xóa bộ lọc">
                  <i class="bi bi-x-lg"></i>
                </a>
              }
            </div>
          </form>
        </div>

        <div class="card-body table-responsive p-0">
          <table class="table table-hover table-striped table-dark align-middle mb-0">
            <thead class="table-dark">
              <tr>
                <th style="width: 80px;" class="text-center">Mã KH</th>
                <th>Tài khoản</th>
                <th>Họ và tên</th>
                <th>Số điện thoại</th>
                <th class="text-center">Số đơn đã mua</th>
                <th class="text-end">Tổng chi tiêu</th>
                <th style="width: 140px;" class="text-center">Thao tác</th>
              </tr>
            </thead>
            <tbody>
              @if (!Model.Any())
              {
                <tr>
                  <td colspan="7" class="text-center text-muted py-4">
                    <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                    Không tìm thấy khách hàng nào.
                  </td>
                </tr>
              }
              else
              {
                @foreach (var item in Model)
                {
                  var tongChiTieu = item.HoaDons.Where(h => h.TrangThai != "Huy").Sum(h => h.TongTien ?? 0);
                  <tr>
                    <td class="text-center fw-bold text-light">#@item.MaTk</td>
                    <td class="font-monospace text-secondary">@item.TenDangNhap</td>
                    <td class="fw-semibold text-primary">
                      <i class="bi bi-person me-1"></i> @item.HoTen
                    </td>
                    <td>
                      @if (!string.IsNullOrWhiteSpace(item.SoDienThoai))
                      {
                        <span class="badge text-bg-dark border border-secondary text-light font-monospace">
                          <i class="bi bi-telephone me-1 text-info"></i>@item.SoDienThoai
                        </span>
                      }
                      else
                      {
                        <span class="text-muted">—</span>
                      }
                    </td>
                    <td class="text-center">
                      <span class="badge rounded-pill text-bg-info px-3 py-2">
                        @item.HoaDons.Count đơn
                      </span>
                    </td>
                    <td class="text-end fw-bold text-success">
                      @string.Format("{0:N0} đ", tongChiTieu)
                    </td>
                    <td class="text-center">
                      <a asp-action="Details" asp-route-id="@item.MaTk" class="btn btn-sm btn-outline-info">
                        <i class="bi bi-clock-history me-1"></i> Lịch sử mua
                      </a>
                    </td>
                  </tr>
                }
              }
            </tbody>
          </table>
        </div>

        <div class="card-footer bg-dark border-secondary text-light">
          Tổng cộng: <strong>@Model.Count()</strong> khách hàng (Vai trò = 1)
        </div>
      </div>

    </div>
  </div>
  <!--end::App Content-->
</main>
<!--end::App Main-->