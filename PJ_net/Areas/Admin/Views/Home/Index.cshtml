@{
    ViewData["Title"] = "Bảng điều khiển Trung tâm - Quản lý Nhà thuốc";
    var recentOrders = ViewBag.RecentOrders as List<PJ_net.Models.HoaDon> ?? new List<PJ_net.Models.HoaDon>();
    var expiringLoThuoc = ViewBag.ExpiringLoThuoc as List<PJ_net.Models.LoThuoc> ?? new List<PJ_net.Models.LoThuoc>();
    var today = ViewBag.Today != null ? (DateOnly)ViewBag.Today : DateOnly.FromDateTime(DateTime.Today);
    int loHetHanCount = ViewBag.LoHetHanCount ?? 0;
    int loSapHetHanCount = ViewBag.LoSapHetHanCount ?? 0;
    int totalLo = ViewBag.TotalLo ?? (loHetHanCount + loSapHetHanCount + 10);
    int choXacNhanRxCount = ViewBag.ChoXacNhanRxCount ?? 0;
    decimal totalDoanhThu = ViewBag.TotalDoanhThu ?? 0;

    int anToanCount = Math.Max(0, totalLo - loHetHanCount - loSapHetHanCount);
    double pctAnToan = totalLo > 0 ? Math.Round((double)anToanCount / totalLo * 100, 1) : 100;
    double pctSapHet = totalLo > 0 ? Math.Round((double)loSapHetHanCount / totalLo * 100, 1) : 0;
    double pctHetHan = totalLo > 0 ? Math.Round((double)loHetHanCount / totalLo * 100, 1) : 0;
}

<main class="app-main">
    <!-- Header Command Bar -->
    <div class="app-content-header py-3 border-bottom bg-white">
        <div class="container-fluid">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
                <div>
                    <div class="d-flex align-items-center gap-2">
                        <h4 class="mb-0 fw-bold text-slate-900">Bảng điều khiển Trung tâm</h4>
                        <span class="badge bg-emerald-50 text-success border border-success-subtle rounded-pill px-2.5 py-1 small">
                            v2.0 Bento OS
                        </span>
                    </div>
                    <p class="text-muted small mb-0">Hệ thống Quản lý Dược phẩm, Kho FEFO &amp; Đơn thuốc An Tâm</p>
                </div>

                <!-- Quick Action Buttons -->
                <div class="d-flex align-items-center gap-2">
                    <a asp-area="DuocSi" asp-controller="BanHang" asp-action="Index" class="btn btn-success btn-sm rounded-pill px-3 fw-semibold shadow-xs">
                        <i class="bi bi-cart3 me-1"></i> Bán tại quầy (POS)
                    </a>
                    <a asp-area="Admin" asp-controller="LoThuoc" asp-action="Create" class="btn btn-outline-success btn-sm rounded-pill px-3 fw-semibold">
                        <i class="bi bi-plus-circle me-1"></i> Nhập lô mới
                    </a>
                    <a asp-area="Admin" asp-controller="CanhBao" asp-action="Index" class="btn btn-outline-warning btn-sm rounded-pill px-3">
                        <i class="bi bi-exclamation-triangle me-1"></i> Cảnh báo kho
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Bento Grid Content -->
    <div class="app-content py-4">
        <div class="container-fluid">

            <!-- ROW 1: 4 SLEEK STAT CARDS (Bento Style) -->
            <div class="row g-3 mb-4">
                <!-- Card 1: Doanh thu -->
                <div class="col-sm-6 col-lg-3">
                    <div class="card h-100 border-0 shadow-sm rounded-4 p-3 bg-white border-start border-4 border-success">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="text-muted small fw-bold text-uppercase">Tổng doanh thu</span>
                            <div class="w-8 h-8 rounded-3 bg-success-subtle text-success d-flex align-items-center justify-content-center p-2 fs-5">
                                <i class="bi bi-currency-dollar"></i>
                            </div>
                        </div>
                        <div class="fs-4 fw-bold text-slate-900">@totalDoanhThu.ToString("N0") <span class="fs-6 text-muted font-normal">đ</span></div>
                        <div class="mt-2 text-success small">
                            <i class="bi bi-graph-up-arrow me-1"></i><strong>@(ViewBag.TotalHoaDon ?? 0)</strong> hóa đơn bán lẻ
                        </div>
                    </div>
                </div>

                <!-- Card 2: Đơn thuốc Rx cần duyệt -->
                <div class="col-sm-6 col-lg-3">
                    <div class="card h-100 border-0 shadow-sm rounded-4 p-3 bg-white border-start border-4 border-warning">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="text-muted small fw-bold text-uppercase">Đơn kê đơn (Rx)</span>
                            <div class="w-8 h-8 rounded-3 bg-warning-subtle text-warning d-flex align-items-center justify-content-center p-2 fs-5">
                                <i class="bi bi-file-earmark-medical"></i>
                            </div>
                        </div>
                        <div class="fs-4 fw-bold text-slate-900">@choXacNhanRxCount <span class="fs-6 text-warning font-normal">chờ duyệt</span></div>
                        <div class="mt-2 text-muted small">
                            <i class="bi bi-shield-check text-warning me-1"></i>Đơn bác sĩ &amp; mã điện tử QG
                        </div>
                    </div>
                </div>

                <!-- Card 3: Mặt hàng thuốc -->
                <div class="col-sm-6 col-lg-3">
                    <div class="card h-100 border-0 shadow-sm rounded-4 p-3 bg-white border-start border-4 border-primary">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="text-muted small fw-bold text-uppercase">Danh mục thuốc</span>
                            <div class="w-8 h-8 rounded-3 bg-primary-subtle text-primary d-flex align-items-center justify-content-center p-2 fs-5">
                                <i class="bi bi-capsule"></i>
                            </div>
                        </div>
                        <div class="fs-4 fw-bold text-slate-900">@(ViewBag.TotalThuoc ?? 0) <span class="fs-6 text-muted font-normal">mặt hàng</span></div>
                        <div class="mt-2 text-primary small">
                            <i class="bi bi-tags me-1"></i><strong>@(ViewBag.TotalNhomThuoc ?? 0)</strong> nhóm danh mục dược
                        </div>
                    </div>
                </div>

                <!-- Card 4: Cảnh báo HSD Lô thuốc -->
                <div class="col-sm-6 col-lg-3">
                    <div class="card h-100 border-0 shadow-sm rounded-4 p-3 bg-white border-start border-4 border-danger">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="text-muted small fw-bold text-uppercase">Lô thuốc cận hạn/hết</span>
                            <div class="w-8 h-8 rounded-3 bg-danger-subtle text-danger d-flex align-items-center justify-content-center p-2 fs-5">
                                <i class="bi bi-exclamation-triangle"></i>
                            </div>
                        </div>
                        <div class="fs-4 fw-bold text-danger">@(loHetHanCount + loSapHetHanCount) <span class="fs-6 text-muted font-normal">lô cần chú ý</span></div>
                        <div class="mt-2 text-danger small">
                            <strong>@loHetHanCount</strong> hết hạn • <strong>@loSapHetHanCount</strong> cận hạn &lt; 60 ngày
                        </div>
                    </div>
                </div>
            </div>

            <!-- ROW 2: BENTO MAIN GRID -->
            <div class="row g-4">
                <!-- CỘT TRÁI (8 COLS): ĐƠN HÀNG VỪA TẠO & TRẠNG THÁI (Bảng dữ liệu thông minh) -->
                <div class="col-lg-8">
                    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100">
                        <div class="d-flex justify-content-between align-items-center pb-3 border-bottom mb-3">
                            <div>
                                <h5 class="fw-bold mb-0 text-slate-900"><i class="bi bi-cart3 text-success me-2"></i>Đơn hàng vừa tạo &amp; Trạng thái</h5>
                                <p class="text-muted small mb-0">Theo dõi giao dịch tại quầy và trực tuyến theo thời gian thực</p>
                            </div>
                            <a asp-area="Admin" asp-controller="HoaDon" asp-action="Index" class="btn btn-outline-success btn-sm rounded-pill px-3">
                                Xem tất cả hóa đơn &rarr;
                            </a>
                        </div>

                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light text-muted small text-uppercase">
                                    <tr>
                                        <th class="ps-3">Mã HĐ</th>
                                        <th>Khách Hàng</th>
                                        <th>Thời Gian</th>
                                        <th>Tổng Tiền</th>
                                        <th>Trạng Thái</th>
                                        <th class="text-end pe-3">Chi Tiết</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (!recentOrders.Any())
                                    {
                                        <tr>
                                            <td colspan="6" class="text-center text-muted py-4">Chưa có hóa đơn nào trong hệ thống.</td>
                                        </tr>
                                    }
                                    else
                                    {
                                        @foreach (var order in recentOrders)
                                        {
                                            <tr>
                                                <td class="ps-3 font-monospace fw-bold text-success">#@order.MaHd</td>
                                                <td>
                                                    <div class="fw-bold small text-slate-900">
                                                        @(order.MaKhNavigation?.HoTen ?? (order.GhiChuKhachHang?.Split('-')[0] ?? "Khách vãng lai"))
                                                    </div>
                                                    <span class="badge @(order.HinhThuc == "TaiQuay" ? "bg-light text-muted border" : "bg-primary-subtle text-primary")" style="font-size: 10px;">
                                                        @(order.HinhThuc == "TaiQuay" ? "Bán tại quầy" : "Trực tuyến")
                                                    </span>
                                                </td>
                                                <td class="small text-muted">
                                                    @(order.NgayLap?.ToString("dd/MM/yyyy HH:mm") ?? "-")
                                                </td>
                                                <td class="fw-bold text-slate-800">
                                                    @((order.TongTien ?? 0).ToString("N0")) đ
                                                </td>
                                                <td>
                                                    @{
                                                        var badgeClass = order.TrangThai switch
                                                        {
                                                            "HoanTat" => "bg-success text-white",
                                                            "DaXacNhan" => "bg-info text-white",
                                                            "DangGiao" => "bg-primary text-white",
                                                            "DaHuy" => "bg-danger text-white",
                                                            _ => "bg-warning text-dark fw-bold"
                                                        };
                                                    }
                                                    <span class="badge @badgeClass rounded-pill px-2.5 py-1 small">
                                                        @order.TrangThai
                                                    </span>
                                                </td>
                                                <td class="text-end pe-3">
                                                    <a asp-area="Admin" asp-controller="HoaDon" asp-action="Details" asp-route-id="@order.MaHd" 
                                                       class="btn btn-outline-secondary btn-sm rounded-circle p-1" style="width: 32px; height: 32px;" title="Xem chi tiết">
                                                        <i class="bi bi-eye"></i>
                                                    </a>
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- CỘT PHẢI (4 COLS): RADA SỨC KHỎE KHO THUỐC (FEFO RADAR) & LÔ CẦN XỬ LÝ -->
                <div class="col-lg-4">
                    <!-- Widget 1: Thước đo sức khỏe hạn dùng kho -->
                    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
                        <div class="d-flex justify-content-between align-items-center pb-2 border-bottom mb-3">
                            <h6 class="fw-bold mb-0 text-slate-900"><i class="bi bi-heart-pulse text-danger me-1"></i>Sức khỏe Kho Lô (FEFO)</h6>
                            <span class="badge bg-success-subtle text-success small">@pctAnToan% An toàn</span>
                        </div>

                        <!-- Progress Bar Stacked -->
                        <div class="progress mb-3" style="height: 10px;">
                            <div class="progress-bar bg-success" role="progressbar" style="width: @pctAnToan%" title="An toàn: @pctAnToan%"></div>
                            <div class="progress-bar bg-warning" role="progressbar" style="width: @pctSapHet%" title="Cận hạn: @pctSapHet%"></div>
                            <div class="progress-bar bg-danger" role="progressbar" style="width: @pctHetHan%" title="Hết hạn: @pctHetHan%"></div>
                        </div>

                        <div class="d-flex justify-content-between text-muted small" style="font-size: 11px;">
                            <span><span class="badge bg-success rounded-circle p-1"> </span> An toàn (@anToanCount)</span>
                            <span><span class="badge bg-warning rounded-circle p-1"> </span> Cận hạn (@loSapHetHanCount)</span>
                            <span><span class="badge bg-danger rounded-circle p-1"> </span> Hết hạn (@loHetHanCount)</span>
                        </div>
                    </div>

                    <!-- Widget 2: Danh sách lô thuốc cận hạn/hết hạn -->
                    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                        <div class="d-flex justify-content-between align-items-center pb-2 border-bottom mb-3">
                            <h6 class="fw-bold mb-0 text-slate-900"><i class="bi bi-exclamation-octagon text-danger me-1"></i>Lô thuốc ưu tiên xử lý</h6>
                            <a asp-area="Admin" asp-controller="CanhBao" asp-action="Index" class="text-danger small fw-bold text-decoration-none">
                                Xem tất cả &rarr;
                            </a>
                        </div>

                        <div class="divide-y max-h-80 overflow-y-auto pe-1" style="max-height: 320px;">
                            @if (!expiringLoThuoc.Any())
                            {
                                <div class="text-center text-muted py-3 small">Tất cả các lô thuốc đều còn hạn sử dụng tốt!</div>
                            }
                            else
                            {
                                @foreach (var lo in expiringLoThuoc)
                                {
                                    bool isExpired = lo.HanSuDung < today;
                                    <div class="py-2.5 border-bottom">
                                        <div class="d-flex justify-content-between align-items-start">
                                            <div>
                                                <div class="fw-bold small text-slate-900">@(lo.MaThuocNavigation?.TenThuoc ?? "Thuốc")</div>
                                                <div class="text-muted" style="font-size: 11px;">
                                                    Lô: <span class="font-monospace fw-bold">@lo.SoLo</span> • Tồn: <span class="fw-bold text-slate-700">@lo.SoLuongTon @(lo.MaThuocNavigation?.DonViTinh ?? "hộp")</span>
                                                </div>
                                                <div class="small @(isExpired ? "text-danger" : "text-warning") fw-bold" style="font-size: 11px;">
                                                    HSD: @lo.HanSuDung.ToString("dd/MM/yyyy") @(isExpired ? "(Đã hết hạn)" : "(Cận hạn)")
                                                </div>
                                            </div>

                                            <span class="badge @(isExpired ? "bg-danger text-white" : "bg-warning text-dark") small">
                                                @(isExpired ? "Đã hết hạn" : "Ưu tiên FEFO")
                                            </span>
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</main>