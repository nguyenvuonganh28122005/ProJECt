@model IEnumerable<PJ_net.Models.Thuoc>
@{
    ViewData["Title"] = "Danh sách mặt hàng thuốc";
    var nhomThuocs = ViewBag.NhomThuocs as List<PJ_net.Models.NhomThuoc> ?? new List<PJ_net.Models.NhomThuoc>();
}

<!--begin::App Main-->
<main class="app-main">
  <!--begin::App Content Header-->
  <div class="app-content-header">
    <div class="container-fluid">
      <div class="row">
        <div class="col-sm-6">
          <h3 class="mb-0">Danh sách mặt hàng thuốc</h3>
        </div>
        <div class="col-sm-6">
          <ol class="breadcrumb float-sm-end">
            <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Home" asp-action="Index">Trang chủ</a></li>
            <li class="breadcrumb-item active" aria-current="page">Thuốc</li>
          </ol>
        </div>
      </div>
    </div>
  </div>
  <!--end::App Content Header-->

  <!--begin::App Content-->
  <div class="app-content">
    <div class="container-fluid">

      <div class="card shadow-sm mb-4">
        <div class="card-header border-0">
          <form method="get" asp-action="Index" class="row g-2 align-items-center">
            <!-- Tìm kiếm tên / hoạt chất -->
            <div class="col-md-5">
              <div class="input-group">
                <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
                <input
                  type="text"
                  name="search"
                  value="@ViewBag.Search"
                  class="form-control"
                  placeholder="Tìm theo tên thuốc, hoạt chất, dạng bào chế..."
                />
              </div>
            </div>

            <!-- Lọc theo nhóm thuốc -->
            <div class="col-md-4">
              <select name="maNhom" class="form-select" onchange="this.form.submit()">
                <option value="">-- Tất cả nhóm thuốc --</option>
                @foreach (var nhom in nhomThuocs)
                {
                  <!option value="@nhom.MaNhom" @(ViewBag.CurrentMaNhom == nhom.MaNhom ? "selected" : "")>
                    @nhom.TenNhom
                  </!option>
                }
              </select>
            </div>

            <div class="col-md-3 d-flex gap-2 justify-content-md-end">
              <button type="submit" class="btn btn-primary">
                <i class="bi bi-funnel me-1"></i> Lọc
              </button>
              @if (!string.IsNullOrEmpty(ViewBag.Search) || ViewBag.CurrentMaNhom != null)
              {
                <a asp-action="Index" class="btn btn-outline-secondary" title="Đặt lại bộ lọc">
                  <i class="bi bi-arrow-clockwise"></i> Đặt lại
                </a>
              }
            </div>
          </form>
        </div>

        <div class="card-body table-responsive p-0">
          <table class="table table-hover table-striped align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th style="width: 70px;" class="text-center">Mã</th>
                <th>Tên thuốc</th>
                <th>Nhóm thuốc</th>
                <th>Dạng / ĐVT</th>
                <th class="text-end">Giá bán</th>
                <th class="text-center">Kê đơn</th>
                <th class="text-center">Tồn kho</th>
                <th style="width: 110px;" class="text-center">Thao tác</th>
              </tr>
            </thead>
            <tbody>
              @if (!Model.Any())
              {
                <tr>
                  <td colspan="8" class="text-center text-muted py-4">
                    <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                    Không tìm thấy mặt hàng thuốc nào phù hợp.
                  </td>
                </tr>
              }
              else
              {
                @foreach (var item in Model)
                {
                  var totalTonKho = item.LoThuocs.Sum(l => l.SoLuongTon);
                  <tr>
                    <td class="text-center fw-bold">#@item.MaThuoc</td>
                    <td>
                      <div class="fw-semibold text-primary">@item.TenThuoc</div>
                      @if (!string.IsNullOrWhiteSpace(item.HoatChat))
                      {
                        <div class="small text-secondary">
                          <i class="bi bi-info-circle me-1"></i>Hoạt chất: @item.HoatChat
                        </div>
                      }
                    </td>
                    <td>
                      @if (item.MaNhomNavigation != null)
                      {
                        <span class="badge text-bg-light border">@item.MaNhomNavigation.TenNhom</span>
                      }
                      else
                      {
                        <span class="text-muted small">Chưa phân nhóm</span>
                      }
                    </td>
                    <td>
                      <div>@(item.DangBaoChe ?? "—")</div>
                      <span class="badge text-bg-secondary small">@(item.DonViTinh ?? "Đơn vị")</span>
                    </td>
                    <td class="text-end fw-bold text-success">
                      @string.Format("{0:N0} đ", item.GiaBan)
                    </td>
                    <td class="text-center">
                      @if (item.KeDon == true)
                      {
                        <span class="badge text-bg-danger">Bắt buộc kê đơn</span>
                      }
                      else
                      {
                        <span class="badge text-bg-success">Không kê đơn</span>
                      }
                    </td>
                    <td class="text-center">
                      @if (totalTonKho > 0)
                      {
                        <span class="badge text-bg-primary fs-7">@totalTonKho @item.DonViTinh</span>
                      }
                      else
                      {
                        <span class="badge text-bg-secondary fs-7">Hết hàng (0)</span>
                      }
                    </td>
                    <td class="text-center">
                      <a asp-area="Admin" asp-controller="LoThuoc" asp-action="Index" asp-route-maThuoc="@item.MaThuoc" class="btn btn-sm btn-outline-info" title="Xem các lô của thuốc này">
                        <i class="bi bi-box-seam"></i> Xem lô
                      </a>
                    </td>
                  </tr>
                }
              }
            </tbody>
          </table>
        </div>

        <div class="card-footer bg-white text-muted">
          Tổng cộng: <strong>@Model.Count()</strong> mặt hàng thuốc
        </div>
      </div>

    </div>
  </div>
  <!--end::App Content-->
</main>
<!--end::App Main-->
