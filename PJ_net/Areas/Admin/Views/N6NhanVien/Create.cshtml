@model PJ_net.Models.N6TaiKhoan
@{
    ViewData["Title"] = "Thêm mới nhân viên";
}

<!--begin::App Main-->
<main class="app-main">
  <!--begin::App Content Header-->
  <div class="app-content-header">
    <div class="container-fluid">
      <div class="row">
        <div class="col-sm-6">
          <h3 class="mb-0 text-light">
            <i class="bi bi-person-plus-fill text-primary me-2"></i>Thêm mới nhân viên
          </h3>
        </div>
        <div class="col-sm-6">
          <ol class="breadcrumb float-sm-end">
            <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Home" asp-action="Index">Trang chủ</a></li>
            <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="NhanVien" asp-action="Index">Nhân viên</a></li>
            <li class="breadcrumb-item active" aria-current="page">Thêm mới</li>
          </ol>
        </div>
      </div>
    </div>
  </div>
  <!--end::App Content Header-->

  <!--begin::App Content-->
  <div class="app-content">
    <div class="container-fluid">
      <div class="row justify-content-center">
        <div class="col-lg-8">
          <div class="card shadow-sm border-secondary">
            <div class="card-header bg-primary text-white">
              <h5 class="card-title mb-0">
                <i class="bi bi-person-badge me-2"></i> Thông tin tài khoản nhân sự mới
              </h5>
            </div>

            <form asp-action="Create" method="post">
              @Html.AntiForgeryToken()
              <div class="card-body text-light">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <div class="row g-3">
                  <div class="col-md-6">
                    <label asp-for="TenDangNhap" class="form-label fw-semibold text-light">
                      Tên đăng nhập (Username) <span class="text-danger">*</span>
                    </label>
                    <div class="input-group">
                      <span class="input-group-text bg-dark text-light border-secondary"><i class="bi bi-person"></i></span>
                      <input
                        asp-for="TenDangNhap"
                        class="form-control bg-dark text-light border-secondary"
                        placeholder="Ví dụ: duocsi_an, nv_kho01..."
                        required
                        autofocus
                      />
                    </div>
                    <span asp-validation-for="TenDangNhap" class="text-danger small"></span>
                  </div>

                  <div class="col-md-6">
                    <label asp-for="MatKhau" class="form-label fw-semibold text-light">
                      Mật khẩu khởi tạo <span class="text-danger">*</span>
                    </label>
                    <div class="input-group">
                      <span class="input-group-text bg-dark text-light border-secondary"><i class="bi bi-key"></i></span>
                      <input
                        asp-for="MatKhau"
                        type="password"
                        class="form-control bg-dark text-light border-secondary"
                        placeholder="Nhập mật khẩu..."
                        required
                      />
                    </div>
                    <span asp-validation-for="MatKhau" class="text-danger small"></span>
                  </div>

                  <div class="col-md-6">
                    <label asp-for="HoTen" class="form-label fw-semibold text-light">
                      Họ và tên nhân viên <span class="text-danger">*</span>
                    </label>
                    <div class="input-group">
                      <span class="input-group-text bg-dark text-light border-secondary"><i class="bi bi-card-heading"></i></span>
                      <input
                        asp-for="HoTen"
                        class="form-control bg-dark text-light border-secondary"
                        placeholder="Ví dụ: Nguyễn Văn An"
                        required
                      />
                    </div>
                    <span asp-validation-for="HoTen" class="text-danger small"></span>
                  </div>

                  <div class="col-md-6">
                    <label asp-for="SoDienThoai" class="form-label fw-semibold text-light">Số điện thoại liên hệ</label>
                    <div class="input-group">
                      <span class="input-group-text bg-dark text-light border-secondary"><i class="bi bi-telephone"></i></span>
                      <input
                        asp-for="SoDienThoai"
                        class="form-control bg-dark text-light border-secondary"
                        placeholder="Ví dụ: 0912345678"
                      />
                    </div>
                    <span asp-validation-for="SoDienThoai" class="text-danger small"></span>
                  </div>

                  <div class="col-md-12">
                    <label asp-for="VaiTro" class="form-label fw-semibold text-light">
                      Vai trò & Phân quyền <span class="text-danger">*</span>
                    </label>
                    <select asp-for="VaiTro" class="form-select bg-dark text-light border-secondary">
                      <option value="2" class="bg-dark text-light">Dược sĩ / Nhân viên bán thuốc & tư vấn</option>
                      <option value="3" class="bg-dark text-light">Quản trị viên (Toàn quyền hệ thống)</option>
                    </select>
                    <span asp-validation-for="VaiTro" class="text-danger small"></span>
                    <div class="form-text text-secondary">
                      Tài khoản khách hàng có mã vai trò = 1 sẽ không tạo tại đây.
                    </div>
                  </div>
                </div>
              </div>

              <div class="card-footer bg-dark border-secondary d-flex justify-content-between">
                <a asp-action="Index" class="btn btn-outline-secondary">
                  <i class="bi bi-arrow-left me-1"></i> Quay lại danh sách
                </a>
                <button type="submit" class="btn btn-primary px-4">
                  <i class="bi bi-save me-1"></i> Lưu thông tin nhân viên
                </button>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>
  <!--end::App Content-->
</main>
<!--end::App Main-->