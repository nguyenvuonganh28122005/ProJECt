@model PJ_net.Models.N6Thuoc
@{
    var formAction = ViewData["FormAction"] as string ?? "Create";
    var nhomThuocs = ViewBag.NhomThuocs as List<PJ_net.Models.N6NhomThuoc> ?? new List<PJ_net.Models.N6NhomThuoc>();
}

<form asp-action="@formAction" method="post">
  @Html.AntiForgeryToken()
  @if (Model?.MaThuoc > 0)
  {
    <input asp-for="MaThuoc" type="hidden" />
  }
  <div class="card-body">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
    <div class="row g-3">
      <div class="col-md-6">
        <label asp-for="TenThuoc" class="form-label">Tên thuốc <span class="text-danger">*</span></label>
        <input asp-for="TenThuoc" class="form-control" required />
        <span asp-validation-for="TenThuoc" class="text-danger small"></span>
      </div>
      <div class="col-md-6">
        <label asp-for="MaNhom" class="form-label">Nhóm thuốc</label>
        <select asp-for="MaNhom" class="form-select">
          <option value="">-- Chưa phân nhóm --</option>
          @foreach (var nhom in nhomThuocs)
          {
            <option value="@nhom.MaNhom">@nhom.TenNhom</option>
          }
        </select>
        <span asp-validation-for="MaNhom" class="text-danger small"></span>
      </div>
      <div class="col-md-6">
        <label asp-for="HoatChat" class="form-label">Hoạt chất</label>
        <input asp-for="HoatChat" class="form-control" />
        <span asp-validation-for="HoatChat" class="text-danger small"></span>
      </div>
      <div class="col-md-6">
        <label asp-for="DangBaoChe" class="form-label">Dạng bào chế</label>
        <input asp-for="DangBaoChe" class="form-control" />
        <span asp-validation-for="DangBaoChe" class="text-danger small"></span>
      </div>
      <div class="col-md-6">
        <label asp-for="DonViTinh" class="form-label">Đơn vị tính</label>
        <input asp-for="DonViTinh" class="form-control" />
        <span asp-validation-for="DonViTinh" class="text-danger small"></span>
      </div>
      <div class="col-md-6">
        <label asp-for="GiaBan" class="form-label">Giá bán (VNĐ) <span class="text-danger">*</span></label>
        <input asp-for="GiaBan" type="number" min="0" step="0.01" class="form-control" required />
        <span asp-validation-for="GiaBan" class="text-danger small"></span>
      </div>
      <div class="col-md-6">
        <label asp-for="KeDon" class="form-label">Tình trạng kê đơn</label>
        <select asp-for="KeDon" class="form-select">
          <option value="false">Không kê đơn</option>
          <option value="true">Bắt buộc kê đơn</option>
        </select>
        <span asp-validation-for="KeDon" class="text-danger small"></span>
      </div>
      <div class="col-md-6">
        <label asp-for="AnhThuoc" class="form-label">Đường dẫn ảnh</label>
        <input asp-for="AnhThuoc" class="form-control" />
        <span asp-validation-for="AnhThuoc" class="text-danger small"></span>
      </div>
      <div class="col-12">
        <label asp-for="HuongDanSuDung" class="form-label">Hướng dẫn sử dụng</label>
        <textarea asp-for="HuongDanSuDung" class="form-control" rows="4"></textarea>
        <span asp-validation-for="HuongDanSuDung" class="text-danger small"></span>
      </div>
    </div>
  </div>
  <div class="card-footer bg-body-tertiary border-secondary d-flex justify-content-between">
    <a asp-action="Index" class="btn btn-outline-secondary">Quay lại danh sách</a>
    <button type="submit" class="btn btn-primary">Lưu thuốc</button>
  </div>
</form>
