<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Nhà thuốc An Tâm</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PJ_net.styles.css" asp-append-version="true" />
</head>
<body class="pharmacy-site">
    <header class="pharmacy-header shadow-xs">
        <nav class="navbar navbar-expand-lg navbar-light pharmacy-navbar">
            <div class="container-fluid pharmacy-nav-inner">
                <a class="navbar-brand pharmacy-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="brand-mark" aria-hidden="true"><span></span><span></span></span>
                    <span>nhà thuốc <strong>An Tâm</strong><small>CHĂM SÓC SỨC KHỎE</small></span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar" aria-controls="mainNavbar"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse" id="mainNavbar">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 pharmacy-nav-links">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Trang chủ</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Thuoc" asp-action="Index">Danh mục thuốc</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="TuVan" asp-action="GuiDonThuoc">
                                <i class="bi bi-file-medical text-success me-1"></i>Tư vấn đơn thuốc
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="DonHang" asp-action="LichSu">Theo dõi đơn hàng</a>
                        </li>
                    </ul>

                    <ul class="navbar-nav align-items-lg-center pharmacy-account-nav gap-2">
                        <!-- Cart Link -->
                        <li class="nav-item">
                            <a class="btn btn-outline-success btn-sm rounded-pill px-3 d-flex align-items-center gap-1" asp-area="" asp-controller="Cart" asp-action="Index">
                                <i class="bi bi-cart3"></i>
                                <span>Giỏ hàng</span>
                            </a>
                        </li>

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-dark fw-semibold" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-person-circle me-1 text-success"></i>@User.Identity.Name
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 rounded-3">
                                    <li><a class="dropdown-item" asp-area="" asp-controller="TaiKhoan" asp-action="ThongTin"><i class="bi bi-person me-2"></i>Hồ sơ cá nhân</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-controller="DonHang" asp-action="LichSu"><i class="bi bi-receipt me-2"></i>Đơn hàng của tôi</a></li>
                                    
                                    @if (User.IsInRole("2"))
                                    {
                                        <li><hr class="dropdown-divider"></li>
                                        <li><a class="dropdown-item text-primary fw-bold" asp-area="DuocSi" asp-controller="BanHang" asp-action="Index"><i class="bi bi-shop me-2"></i>Quầy Dược Sĩ (POS)</a></li>
                                    }
                                    @if (User.IsInRole("3"))
                                    {
                                        <li><hr class="dropdown-divider"></li>
                                        <li><a class="dropdown-item text-danger fw-bold" asp-area="Admin" asp-controller="Home" asp-action="Index"><i class="bi bi-speedometer2 me-2"></i>Trang Quản Trị (Admin)</a></li>
                                    }

                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form asp-area="" asp-controller="TaiKhoan" asp-action="DangXuat" method="post" class="px-3 py-1">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-danger btn-sm w-100 rounded-pill">Đăng xuất</button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item"><a class="btn btn-sm pharmacy-login-button rounded-pill" asp-area="" asp-controller="TaiKhoan" asp-action="DangNhap">Đăng nhập</a></li>
                            <li class="nav-item"><a class="btn btn-success btn-sm pharmacy-register-button rounded-pill" asp-area="" asp-controller="TaiKhoan" asp-action="DangKy">Đăng ký</a></li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="pharmacy-content">
        <main role="main" class="pharmacy-main">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top pharmacy-footer text-muted">
        <div class="pharmacy-footer-inner">
            <span>&copy; @DateTime.Now.Year Nhà thuốc An Tâm - Hệ thống Quản lý Hiệu thuốc</span>
            <a asp-area="" asp-controller="Home" asp-action="Privacy">Chính sách &amp; quyền riêng tư</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
