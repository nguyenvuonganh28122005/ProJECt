@model PJ_net.ViewModels.CartViewModel
@{
    ViewData["Title"] = "Giỏ hàng của bạn";
}

<div class="container py-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-success text-decoration-none">Trang chủ</a></li>
            <li class="breadcrumb-item"><a asp-controller="Thuoc" asp-action="Index" class="text-success text-decoration-none">Danh mục thuốc</a></li>
            <li class="breadcrumb-item active" aria-current="page">Giỏ hàng</li>
        </ol>
    </nav>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3" role="alert">
            <i class="bi bi-check-circle me-1"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3" role="alert">
            <i class="bi bi-exclamation-circle me-1"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["WarningMessage"] != null)
    {
        <div class="alert alert-warning alert-dismissible fade show rounded-3" role="alert">
            <i class="bi bi-exclamation-triangle me-1"></i> @TempData["WarningMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (!Model.Items.Any())
    {
        <div class="card border-0 shadow-sm rounded-4 p-5 text-center my-4">
            <div class="text-muted mb-3"><i class="bi bi-cart-x fs-1 text-success"></i></div>
            <h4 class="fw-bold">Giỏ hàng đang trống</h4>
            <p class="text-muted small">Bạn chưa thêm loại thuốc nào vào giỏ hàng.</p>
            <div class="mt-3">
                <a asp-controller="Thuoc" asp-action="Index" class="btn btn-success rounded-pill px-4 fw-bold">
                    Khám phá thuốc &amp; dược phẩm
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4">
            <!-- Left: List items (8 cols) -->
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm rounded-4 p-4">
                    <h5 class="fw-bold mb-3 text-slate-800">Danh sách thuốc trong giỏ (@Model.TongSoLuong sản phẩm)</h5>

                    @if (Model.CoThuocKeDon)
                    {
                        <div class="alert alert-danger border-0 rounded-3 small mb-4 d-flex align-items-center gap-2">
                            <i class="bi bi-exclamation-triangle-fill fs-5 shrink-0"></i>
                            <div>
                                <strong>Lưu ý:</strong> Giỏ hàng của bạn có chứa <strong>Thuốc kê đơn (Rx)</strong>. Tại bước thanh toán, hệ thống yêu cầu bạn tải lên ảnh đơn thuốc của Bác sĩ hoặc cung cấp Mã đơn thuốc điện tử quốc gia để Dược sĩ thẩm định.
                            </div>
                        </div>
                    }

                    <div class="table-responsive">
                        <table class="table align-middle">
                            <thead class="table-light text-muted small text-uppercase">
                                <tr>
                                    <th>Sản phẩm</th>
                                    <th>Đơn giá</th>
                                    <th style="width: 140px;">Số lượng</th>
                                    <th>Thành tiền</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Items)
                                {
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center gap-3">
                                                <div class="bg-light rounded-3 p-1 text-center shrink-0" style="width: 55px; height: 55px; display: flex; align-items: center; justify-content: center;">
                                                    @if (!string.IsNullOrEmpty(item.AnhThuoc))
                                                    {
                                                        <img src="@item.AnhThuoc" alt="@item.TenThuoc" class="img-fluid" style="max-height: 48px; object-fit: contain;" />
                                                    }
                                                    else
                                                    {
                                                        <i class="bi bi-capsule text-success fs-4"></i>
                                                    }
                                                </div>
                                                <div>
                                                    <h6 class="fw-bold mb-0">
                                                        <a asp-controller="Thuoc" asp-action="Details" asp-route-id="@item.MaThuoc" class="text-decoration-none text-slate-900">
                                                            @item.TenThuoc
                                                        </a>
                                                    </h6>
                                                    @if (item.KeDon)
                                                    {
                                                        <span class="badge bg-danger text-white rounded-pill small" style="font-size: 10px;">
                                                            Thuốc kê đơn (Rx)
                                                        </span>
                                                    }
                                                    <span class="text-muted small">/@(item.DonViTinh ?? "Hộp")</span>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="fw-semibold">@item.GiaBan.ToString("N0") đ</td>
                                        <td>
                                            <form asp-action="UpdateQuantity" method="post" class="d-flex align-items-center gap-1">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="maThuoc" value="@item.MaThuoc" />
                                                <input type="number" name="soLuong" value="@item.SoLuong" min="1" max="999"
                                                       class="form-control form-control-sm text-center" onchange="this.form.submit()" />
                                            </form>
                                        </td>
                                        <td class="fw-bold text-success">@item.ThanhTien.ToString("N0") đ</td>
                                        <td>
                                            <form asp-action="RemoveFromCart" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="maThuoc" value="@item.MaThuoc" />
                                                <button type="submit" class="btn btn-outline-danger btn-sm border-0 rounded-circle" title="Xóa">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                        <a asp-controller="Thuoc" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3 btn-sm">
                            <i class="bi bi-arrow-left me-1"></i> Tiếp tục mua thuốc
                        </a>
                    </div>
                </div>
            </div>

            <!-- Right: Summary (4 cols) -->
            <div class="col-lg-4">
                <div class="card border-0 shadow-sm rounded-4 p-4 sticky-top" style="top: 90px;">
                    <h5 class="fw-bold mb-3 text-slate-800">Tóm tắt đơn thuốc</h5>

                    <div class="d-flex justify-content-between mb-2 text-muted">
                        <span>Tổng số lượng:</span>
                        <strong class="text-dark">@Model.TongSoLuong</strong>
                    </div>

                    <div class="d-flex justify-content-between mb-2 text-muted">
                        <span>Phí vận chuyển:</span>
                        <span class="text-success fw-semibold">Miễn phí</span>
                    </div>

                    <hr />

                    <div class="d-flex justify-content-between align-items-baseline mb-4">
                        <span class="fw-bold text-slate-800">Tổng thanh toán:</span>
                        <span class="fs-4 fw-bold text-success">@Model.TongTien.ToString("N0") đ</span>
                    </div>

                    <a asp-action="Checkout" class="btn btn-success w-100 py-2.5 rounded-pill fw-bold shadow-sm">
                        Tiến hành đặt hàng <i class="bi bi-arrow-right ms-1"></i>
                    </a>

                    <div class="mt-3 text-center text-muted small">
                        <i class="bi bi-shield-check text-success me-1"></i> Cam kết 100% thuốc chính hãng &amp; bảo mật thông tin
                    </div>
                </div>
            </div>
        </div>
    }
</div>
