@model PJ_net.ViewModels.ThuocListViewModel
@{
    ViewData["Title"] = "Danh mục thuốc & Dược phẩm";
}

<div class="container py-4">
    <!-- Header Banner / Search Bar -->
    <div class="p-4 p-md-5 mb-4 rounded-4 bg-white border shadow-sm">
        <div class="row align-items-center">
            <div class="col-lg-7">
                <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-1.5 rounded-pill mb-2 fw-semibold">
                    Nhà thuốc An Tâm
                </span>
                <h1 class="h2 fw-bold text-slate-900 mb-2">Tra cứu Thuốc &amp; Thực phẩm chức năng</h1>
                <p class="text-muted mb-4">Cam kết 100% thuốc chính hãng, kiểm duyệt nguồn gốc và hướng dẫn sử dụng an toàn từ Dược sĩ chuyên môn.</p>

                <!-- Search form -->
                <form method="get" asp-area="" asp-controller="Thuoc" asp-action="Index" class="d-flex gap-2">
                    <input type="hidden" name="maNhom" value="@Model.MaNhom" />
                    <input type="hidden" name="minGia" value="@Model.MinGia" />
                    <input type="hidden" name="maxGia" value="@Model.MaxGia" />
                    <div class="input-group input-group-lg shadow-sm">
                        <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-search"></i></span>
                        <input type="text" name="search" value="@Model.Search" class="form-control border-start-0 ps-0" placeholder="Tìm theo tên thuốc, hoạt chất (Paracetamol, Amoxicillin...)" />
                        <button type="submit" class="btn btn-success px-4 fw-bold">Tìm kiếm</button>
                    </div>
                </form>
            </div>
            <div class="col-lg-5 text-center d-none d-lg-block">
                <img src="~/images/nhathuoc-intro.svg" alt="Nhà thuốc An Tâm" style="max-height: 200px;" class="img-fluid" />
            </div>
        </div>
    </div>

    <!-- Main Content: Filter + Product Grid -->
    <div class="row g-4">
        <!-- Sidebar Filter (3 cols) -->
        <div class="col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 sticky-top" style="top: 90px;">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="fw-bold mb-0 text-slate-800">Bộ lọc tìm kiếm</h5>
                        @if (!string.IsNullOrWhiteSpace(Model.Search) || Model.MaNhom.HasValue || Model.MinGia.HasValue || Model.MaxGia.HasValue)
                        {
                            <a asp-area="" asp-controller="Thuoc" asp-action="Index" class="text-decoration-none small text-danger">Xóa lọc</a>
                        }
                    </div>

                    <form method="get" asp-area="" asp-controller="Thuoc" asp-action="Index">
                        <input type="hidden" name="search" value="@Model.Search" />

                        <!-- Nhóm thuốc -->
                        <div class="mb-4">
                            <label class="form-label small fw-bold text-muted text-uppercase">Nhóm thuốc</label>
                            <div class="list-group list-group-flush">
                                <a asp-area="" asp-controller="Thuoc" asp-action="Index" asp-route-search="@Model.Search" asp-route-minGia="@Model.MinGia" asp-route-maxGia="@Model.MaxGia"
                                   class="list-group-item list-group-item-action border-0 px-2 py-1.5 rounded-2 @(!Model.MaNhom.HasValue ? "bg-success text-white fw-bold" : "text-slate-700")">
                                    Tất cả nhóm thuốc
                                </a>
                                @foreach (var nhom in Model.NhomThuocs)
                                {
                                    <a asp-area="" asp-controller="Thuoc" asp-action="Index" asp-route-maNhom="@nhom.MaNhom" asp-route-search="@Model.Search" asp-route-minGia="@Model.MinGia" asp-route-maxGia="@Model.MaxGia"
                                       class="list-group-item list-group-item-action border-0 px-2 py-1.5 rounded-2 @(Model.MaNhom == nhom.MaNhom ? "bg-success text-white fw-bold" : "text-slate-700")">
                                        @nhom.TenNhom
                                    </a>
                                }
                            </div>
                        </div>

                        <!-- Khoảng giá -->
                        <div class="mb-4">
                            <label class="form-label small fw-bold text-muted text-uppercase">Khoảng giá (VNĐ)</label>
                            <div class="row g-2">
                                <div class="col-6">
                                    <input type="number" name="minGia" value="@Model.MinGia" placeholder="Từ" class="form-control form-control-sm" />
                                </div>
                                <div class="col-6">
                                    <input type="number" name="maxGia" value="@Model.MaxGia" placeholder="Đến" class="form-control form-control-sm" />
                                </div>
                            </div>
                            <button type="submit" class="btn btn-outline-success btn-sm w-100 mt-2 rounded-pill">Áp dụng giá</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Product Grid (9 cols) -->
        <div class="col-lg-9">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <p class="text-muted small mb-0">Tìm thấy <strong class="text-dark">@Model.TotalItems</strong> sản phẩm</p>
                <span class="small text-muted">Trang @Model.CurrentPage / @Model.TotalPages</span>
            </div>

            @if (!Model.Thuocs.Any())
            {
                <div class="card border-0 shadow-sm rounded-4 p-5 text-center">
                    <div class="text-muted mb-3"><i class="bi bi-capsule fs-1"></i></div>
                    <h5>Không tìm thấy thuốc phù hợp</h5>
                    <p class="text-muted small">Hãy thử tìm với từ khóa khác hoặc xóa bớt các tiêu chí lọc.</p>
                    <div class="mt-2">
                        <a asp-area="" asp-controller="Thuoc" asp-action="Index" class="btn btn-outline-success rounded-pill px-4">Xem tất cả thuốc</a>
                    </div>
                </div>
            }
            else
            {
                <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 g-3">
                    @foreach (var item in Model.Thuocs)
                    {
                        <div class="col">
                            <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden d-flex flex-column transition-hover position-relative" style="background: #ffffff; border: 1px solid #eef2f0 !important;">
                                <!-- Prescription Badge -->
                                @if (item.KeDon)
                                {
                                    <span class="position-absolute top-0 start-0 m-2 badge bg-danger text-white rounded-pill px-2.5 py-1 small fw-bold shadow-sm z-2">
                                        <i class="bi bi-file-earmark-medical me-1"></i>Thuốc kê đơn (Rx)
                                    </span>
                                }

                                <!-- Product Image -->
                                <div class="bg-light p-3 text-center position-relative" style="height: 180px; display: flex; align-items: center; justify-content: center;">
                                    @{
                                        var itemImg = !string.IsNullOrEmpty(item.AnhThuoc)
                                            ? (item.AnhThuoc.StartsWith("http") || item.AnhThuoc.StartsWith("/") ? item.AnhThuoc : Url.Content("~/uploads/thuoc/" + item.AnhThuoc))
                                            : Url.Content("~/images/medicine-default.svg");
                                    }
                                    <img src="@itemImg" alt="@item.TenThuoc" class="img-fluid" style="max-height: 150px; object-fit: contain;" onerror="this.onerror=null; this.src='/images/medicine-default.svg';" />
                                </div>

                                <!-- Body -->
                                <div class="card-body p-3 d-flex flex-column">
                                    <span class="text-success small fw-semibold text-truncate">@(item.TenNhom ?? "Thuốc chung")</span>
                                    <h6 class="card-title fw-bold text-slate-800 mb-1 text-truncate-2" style="min-height: 42px;">
                                        <a asp-area="" asp-controller="Thuoc" asp-action="Details" asp-route-id="@item.MaThuoc" class="text-decoration-none text-slate-900">
                                            @item.TenThuoc
                                        </a>
                                    </h6>
                                    @if (!string.IsNullOrEmpty(item.HoatChat))
                                    {
                                        <p class="text-muted small mb-2 text-truncate">Hoạt chất: @item.HoatChat</p>
                                    }

                                    <!-- Price & Packaging -->
                                    <div class="mt-auto pt-2 border-top">
                                        <div class="d-flex align-items-baseline justify-content-between mb-2">
                                            <span class="fs-5 fw-bold text-success">@item.GiaBan.ToString("N0") đ</span>
                                            <span class="badge bg-light text-muted border">/@(item.DonViTinh ?? "Hộp")</span>
                                        </div>

                                        <!-- Stock status -->
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            @if (item.TongTonKhaDung > 0)
                                            {
                                                <span class="small text-success"><i class="bi bi-check2-circle me-1"></i>Còn hàng (@item.TongTonKhaDung)</span>
                                            }
                                            else
                                            {
                                                <span class="small text-danger"><i class="bi bi-x-circle me-1"></i>Tạm hết hàng</span>
                                            }
                                        </div>

                                        <!-- Action Buttons -->
                                        <div class="d-grid gap-1">
                                            @if (item.TongTonKhaDung > 0)
                                            {
                                                <form asp-area="" asp-controller="Cart" asp-action="AddToCart" method="post">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="maThuoc" value="@item.MaThuoc" />
                                                    <input type="hidden" name="soLuong" value="1" />
                                                    <button type="submit" class="btn btn-success btn-sm w-100 rounded-pill fw-semibold">
                                                        <i class="bi bi-cart-plus me-1"></i> Thêm vào giỏ
                                                    </button>
                                                </form>
                                            }
                                            else
                                            {
                                                <button type="button" class="btn btn-secondary btn-sm w-100 rounded-pill" disabled>Hết hàng</button>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <!-- Pagination (12 sp/trang) -->
                @if (Model.TotalPages > 1)
                {
                    <nav aria-label="Page navigation" class="mt-5">
                        <ul class="pagination justify-content-center">
                            <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                                <a class="page-link rounded-pill me-1" asp-area="" asp-controller="Thuoc" asp-action="Index"
                                   asp-route-page="@(Model.CurrentPage - 1)"
                                   asp-route-search="@Model.Search"
                                   asp-route-maNhom="@Model.MaNhom"
                                   asp-route-minGia="@Model.MinGia"
                                   asp-route-maxGia="@Model.MaxGia">
                                    <i class="bi bi-chevron-left"></i> Trước
                                </a>
                            </li>

                            @for (int p = 1; p <= Model.TotalPages; p++)
                            {
                                <li class="page-item @(p == Model.CurrentPage ? "active" : "")">
                                    <a class="page-link rounded-circle mx-1 text-center" style="width: 38px; height: 38px; line-height: 22px;"
                                       asp-area="" asp-controller="Thuoc" asp-action="Index"
                                       asp-route-page="@p"
                                       asp-route-search="@Model.Search"
                                       asp-route-maNhom="@Model.MaNhom"
                                       asp-route-minGia="@Model.MinGia"
                                       asp-route-maxGia="@Model.MaxGia">
                                        @p
                                    </a>
                                </li>
                            }

                            <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                                <a class="page-link rounded-pill ms-1" asp-area="" asp-controller="Thuoc" asp-action="Index"
                                   asp-route-page="@(Model.CurrentPage + 1)"
                                   asp-route-search="@Model.Search"
                                   asp-route-maNhom="@Model.MaNhom"
                                   asp-route-minGia="@Model.MinGia"
                                   asp-route-maxGia="@Model.MaxGia">
                                    Sau <i class="bi bi-chevron-right"></i>
                                </a>
                            </li>
                        </ul>
                    </nav>
                }
            }
        </div>
    </div>
</div>
