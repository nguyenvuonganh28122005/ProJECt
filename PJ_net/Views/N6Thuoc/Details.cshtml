@model PJ_net.ViewModels.ThuocDetailViewModel
@{
    ViewData["Title"] = Model.Thuoc.TenThuoc + " - Chi tiết dược phẩm";
}

<div class="container py-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-area="" asp-controller="Home" asp-action="Index" class="text-success text-decoration-none">Trang chủ</a></li>
            <li class="breadcrumb-item"><a asp-area="" asp-controller="Thuoc" asp-action="Index" class="text-success text-decoration-none">Danh mục thuốc</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.Thuoc.TenThuoc</li>
        </ol>
    </nav>

    <!-- Product Card -->
    <div class="card border-0 shadow-sm rounded-4 mb-5 overflow-hidden">
        <div class="row g-0">
            <!-- Left: Image -->
            <div class="col-md-5 bg-light p-4 text-center d-flex align-items-center justify-content-center" style="min-height: 380px;">
                @{
                    var detailImg = !string.IsNullOrEmpty(Model.Thuoc.AnhThuoc)
                        ? (Model.Thuoc.AnhThuoc.StartsWith("http") || Model.Thuoc.AnhThuoc.StartsWith("/") ? Model.Thuoc.AnhThuoc : Url.Content("~/uploads/thuoc/" + Model.Thuoc.AnhThuoc))
                        : Url.Content("~/images/medicine-default.svg");
                }
                <img src="@detailImg" alt="@Model.Thuoc.TenThuoc" class="img-fluid rounded-3" style="max-height: 320px; object-fit: contain;" onerror="this.onerror=null; this.src='/images/medicine-default.svg';" />
            </div>

            <!-- Right: Drug info -->
            <div class="col-md-7 p-4 p-md-5 d-flex flex-column justify-content-between">
                <div>
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <span class="badge bg-success-subtle text-success px-3 py-1 rounded-pill">
                            @(Model.Thuoc.MaNhomNavigation?.TenNhom ?? "Nhóm thuốc chuẩn")
                        </span>

                        @if (Model.Thuoc.KeDon == true)
                        {
                            <span class="badge bg-danger text-white px-3 py-1 rounded-pill fw-bold">
                                <i class="bi bi-file-earmark-medical me-1"></i>Thuốc kê đơn (Rx)
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-info-subtle text-info px-3 py-1 rounded-pill">
                                Thuốc không kê đơn (OTC)
                            </span>
                        }
                    </div>

                    <h1 class="h3 fw-bold text-slate-900 mb-2">@Model.Thuoc.TenThuoc</h1>

                    @if (!string.IsNullOrEmpty(Model.Thuoc.HoatChat))
                    {
                        <p class="text-muted mb-3"><strong class="text-dark">Hoạt chất:</strong> @Model.Thuoc.HoatChat</p>
                    }

                    <!-- Price box -->
                    <div class="p-3 bg-light rounded-3 my-3 d-flex align-items-baseline gap-2">
                        <span class="display-6 fw-bold text-success">@Model.Thuoc.GiaBan.ToString("N0") đ</span>
                        <span class="text-muted">/ @(Model.Thuoc.DonViTinh ?? "Hộp")</span>
                    </div>

                    <!-- Specs -->
                    <ul class="list-unstyled text-muted small mb-4">
                        <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i><strong>Dạng bào chế:</strong> @(Model.Thuoc.DangBaoChe ?? "Viên nén/nang")</li>
                        <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i><strong>Đơn vị tính:</strong> @(Model.Thuoc.DonViTinh ?? "Hộp")</li>
                        <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i><strong>Tồn kho khả dụng:</strong> 
                            @if (Model.TongTonKhaDung > 0)
                            {
                                <span class="text-success fw-bold">Còn @Model.TongTonKhaDung @Model.Thuoc.DonViTinh (các lô còn hạn)</span>
                            }
                            else
                            {
                                <span class="text-danger fw-bold">Tạm thời hết hàng trong kho</span>
                            }
                        </li>
                    </ul>

                    @if (Model.Thuoc.KeDon == true)
                    {
                        <div class="alert alert-warning border-0 rounded-3 small mb-4">
                            <i class="bi bi-exclamation-triangle-fill text-warning me-1"></i>
                            <strong>Lưu ý quan trọng:</strong> Đây là thuốc kê đơn. Theo quy định của Bộ Y tế, khi đặt hàng online bạn cần tải lên ảnh đơn thuốc của Bác sĩ hoặc cung cấp Mã đơn thuốc điện tử quốc gia để Dược sĩ thẩm định trước khi giao hàng.
                        </div>
                    }
                </div>

                <!-- Add to Cart Form -->
                <div>
                    @if (Model.TongTonKhaDung > 0)
                    {
                        <form asp-area="" asp-controller="Cart" asp-action="AddToCart" method="post" class="row g-2 align-items-center">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="maThuoc" value="@Model.Thuoc.MaThuoc" />
                            <div class="col-auto">
                                <label class="visually-hidden">Số lượng</label>
                                <div class="input-group" style="width: 130px;">
                                    <span class="input-group-text bg-light border-end-0">SL</span>
                                    <input type="number" name="soLuong" value="1" min="1" max="@Model.TongTonKhaDung" class="form-control text-center" />
                                </div>
                            </div>
                            <div class="col">
                                <button type="submit" class="btn btn-success px-4 py-2 rounded-pill fw-bold w-100">
                                    <i class="bi bi-cart-plus me-1"></i> Thêm vào giỏ hàng
                                </button>
                            </div>
                        </form>
                    }
                    else
                    {
                        <button class="btn btn-secondary w-100 py-2 rounded-pill" disabled>Tạm hết hàng</button>
                    }
                </div>
            </div>
        </div>

        <!-- HTML Usage Instructions -->
        @if (!string.IsNullOrEmpty(Model.Thuoc.HuongDanSuDung))
        {
            <div class="card-footer bg-white p-4 p-md-5 border-top">
                <h4 class="fw-bold mb-3 text-slate-900"><i class="bi bi-info-circle text-success me-2"></i>Hướng dẫn sử dụng &amp; Chỉ định</h4>
                <div class="content-html text-slate-700 leading-relaxed">
                    @Html.Raw(Model.Thuoc.HuongDanSuDung)
                </div>
            </div>
        }
    </div>

    <!-- Related Products -->
    @if (Model.ThuocCungNhom.Any())
    {
        <div class="mt-5">
            <h4 class="fw-bold mb-3 text-slate-900">Thuốc cùng nhóm tác dụng</h4>
            <div class="row row-cols-1 row-cols-sm-2 row-cols-md-4 g-3">
                @foreach (var c in Model.ThuocCungNhom)
                {
                    <div class="col">
                        <div class="card h-100 border-0 shadow-sm rounded-4 p-3 d-flex flex-column">
                            <h6 class="fw-bold mb-1 text-truncate">
                                <a asp-area="" asp-controller="Thuoc" asp-action="Details" asp-route-id="@c.MaThuoc" class="text-decoration-none text-dark">
                                    @c.TenThuoc
                                </a>
                            </h6>
                            <span class="text-muted small mb-2 text-truncate">@c.HoatChat</span>
                            <div class="mt-auto d-flex justify-content-between align-items-center">
                                <span class="fw-bold text-success">@c.GiaBan.ToString("N0") đ</span>
                                <a asp-area="" asp-controller="Thuoc" asp-action="Details" asp-route-id="@c.MaThuoc" class="btn btn-outline-success btn-sm rounded-pill">Xem</a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>
