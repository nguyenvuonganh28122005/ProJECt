@{
    Layout = "_TaiKhoanLayout";
    ViewData["Title"] = "Không có quyền truy cập";
    var userRole = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
}
<div class="auth-card">
  <div class="auth-card-header text-center">
    <div class="text-danger mb-2" style="font-size: 3rem;">
      <i class="bi bi-shield-lock"></i>
    </div>
    <h1>Không có quyền truy cập</h1>
    <p class="auth-subtitle">Tài khoản hiện tại không có quyền thao tác trên trang này.</p>
  </div>
  <div class="auth-card-body">
    <div class="d-grid gap-2">
      @if (userRole == "3")
      {
        <a asp-area="Admin" asp-controller="Home" asp-action="Index" class="btn btn-primary py-2 fw-bold">
          <i class="bi bi-speedometer2 me-1"></i> Vào Bảng Điều Khiển Quản Trị
        </a>
      }
      else if (userRole == "2")
      {
        <a asp-area="DuocSi" asp-controller="BanHang" asp-action="Index" class="btn btn-success py-2 fw-bold">
          <i class="bi bi-shop me-1"></i> Vào Màn Hình Bán Thuốc Dược Sĩ
        </a>
      }
      else
      {
        <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-success py-2 fw-bold">
          <i class="bi bi-house me-1"></i> Về Trang Chủ Khách Hàng
        </a>
      }
      <a asp-area="" asp-controller="TaiKhoan" asp-action="DangNhap" class="btn btn-outline-secondary btn-sm mt-2">
        Đăng nhập tài khoản khác
      </a>
    </div>
  </div>
</div>
