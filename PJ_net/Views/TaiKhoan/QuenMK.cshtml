@model PJ_net.ViewModels.ForgotPasswordViewModel
@{
    Layout = "_TaiKhoanLayout";
    ViewData["Title"] = "Quên mật khẩu";
}
<div class="auth-card">
  <div class="auth-card-header">
    <h1>Quên mật khẩu</h1>
    <p class="auth-subtitle">Nhập thông tin đã đăng ký để xác minh tài khoản.</p>
  </div>
  <div class="auth-card-body">
    <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>
    <div class="alert alert-info small">Vui lòng nhập đúng tên đăng nhập, họ tên và số điện thoại đã đăng ký. Đây là xác minh hồ sơ đơn giản, chưa có mã OTP.</div>
    <form asp-area="" asp-controller="TaiKhoan" asp-action="QuenMK" method="post">
      @Html.AntiForgeryToken()
      <div class="mb-3">
        <label asp-for="TenDangNhap" class="form-label"></label>
        <input asp-for="TenDangNhap" class="form-control" autocomplete="username" />
        <span asp-validation-for="TenDangNhap" class="text-danger"></span>
      </div>
      <div class="mb-3">
        <label asp-for="HoTen" class="form-label"></label>
        <input asp-for="HoTen" class="form-control" autocomplete="name" />
        <span asp-validation-for="HoTen" class="text-danger"></span>
      </div>
      <div class="mb-3">
        <label asp-for="SoDienThoai" class="form-label"></label>
        <input asp-for="SoDienThoai" class="form-control" autocomplete="tel" />
        <span asp-validation-for="SoDienThoai" class="text-danger"></span>
      </div>
      <button type="submit" class="btn btn-success w-100 py-2">Xác minh thông tin</button>
    </form>
    <div class="auth-links justify-content-center"><a asp-area="" asp-controller="TaiKhoan" asp-action="DangNhap">Quay lại đăng nhập</a></div>
  </div>
</div>
