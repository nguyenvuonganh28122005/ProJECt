@model PJ_net.ViewModels.RegisterViewModel
@{
    Layout = "_TaiKhoanLayout";
    ViewData["Title"] = "Đăng ký";
}
<div class="auth-card">
  <div class="auth-card-header">
    <h1>Tạo tài khoản</h1>
    <p class="auth-subtitle">Đăng ký tài khoản khách hàng miễn phí.</p>
  </div>
  <div class="auth-card-body">
    <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>
    <form asp-area="" asp-controller="TaiKhoan" asp-action="DangKy" method="post">
      @Html.AntiForgeryToken()
      <div class="mb-3">
        <label asp-for="HoTen" class="form-label"></label>
        <input asp-for="HoTen" class="form-control" autocomplete="name" />
        <span asp-validation-for="HoTen" class="text-danger"></span>
      </div>
      <div class="mb-3">
        <label asp-for="TenDangNhap" class="form-label"></label>
        <input asp-for="TenDangNhap" class="form-control" autocomplete="username" />
        <span asp-validation-for="TenDangNhap" class="text-danger"></span>
      </div>
      <div class="mb-3">
        <label asp-for="SoDienThoai" class="form-label"></label>
        <input asp-for="SoDienThoai" class="form-control" autocomplete="tel" />
        <span asp-validation-for="SoDienThoai" class="text-danger"></span>
      </div>
      <div class="mb-3">
        <label asp-for="MatKhau" class="form-label"></label>
        <input asp-for="MatKhau" class="form-control" autocomplete="new-password" />
        <span asp-validation-for="MatKhau" class="text-danger"></span>
      </div>
      <div class="mb-3">
        <label asp-for="XacNhanMatKhau" class="form-label"></label>
        <input asp-for="XacNhanMatKhau" class="form-control" autocomplete="new-password" />
        <span asp-validation-for="XacNhanMatKhau" class="text-danger"></span>
      </div>
      <button type="submit" class="btn btn-success w-100 py-2">Đăng ký</button>
    </form>
    <div class="auth-links justify-content-center">
      <span>Đã có tài khoản? <a asp-area="" asp-controller="TaiKhoan" asp-action="DangNhap">Đăng nhập</a></span>
    </div>
  </div>
</div>
