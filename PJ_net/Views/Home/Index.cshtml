@{
    ViewData["Title"] = "Trang chủ - Nhà thuốc An Tâm";
    var categories = ViewBag.Categories as List<PJ_net.Models.NhomThuoc> ?? new List<PJ_net.Models.NhomThuoc>();
    var featuredMedicines = ViewBag.FeaturedMedicines as List<PJ_net.Models.Thuoc> ?? new List<PJ_net.Models.Thuoc>();
}

<!-- Hero Banner Section -->
<section class="py-5 bg-white border-bottom rounded-4 my-3 shadow-xs">
    <div class="container">
        <div class="row align-items-center g-4">
            <div class="col-lg-7">
                <span class="badge bg-success-subtle text-success px-3 py-1.5 rounded-pill mb-3 fw-bold border border-success-subtle">
                    <i class="bi bi-shield-check me-1"></i> Chuỗi nhà thuốc chuẩn GPP
                </span>
                <h1 class="display-5 fw-bold text-slate-900 mb-3">
                    Chăm sóc sức khỏe,<br />
                    <span class="text-success">bắt đầu từ sự an tâm.</span>
                </h1>
                <p class="lead text-muted mb-4">
                    Nhà thuốc An Tâm đồng hành cùng sức khỏe gia đình bạn với hơn 2.000 mặt hàng dược phẩm chính hãng, xuất kho ưu tiên hạn dùng FEFO và đội ngũ Dược sĩ tư vấn tận tâm 24/7.
                </p>

                <!-- Search form -->
                <form asp-controller="Thuoc" asp-action="Index" method="get" class="mb-3">
                    <div class="input-group input-group-lg shadow-sm rounded-pill overflow-hidden border">
                        <span class="input-group-text bg-white border-0 text-muted ps-4"><i class="bi bi-search"></i></span>
                        <input type="text" name="search" class="form-control border-0" placeholder="Tìm kiếm tên thuốc, hoạt chất, triệu chứng..." />
                        <button type="submit" class="btn btn-success px-4 fw-bold">Tìm thuốc</button>
                    </div>
                </form>

                <div class="d-flex flex-wrap gap-2 align-items-center">
                    <span class="small text-muted">Gợi ý tìm nhanh:</span>
                    <a asp-controller="Thuoc" asp-action="Index" asp-route-search="Paracetamol" class="badge bg-light text-dark text-decoration-none rounded-pill py-1.5 px-3 border">Paracetamol</a>
                    <a asp-controller="Thuoc" asp-action="Index" asp-route-search="Amoxicillin" class="badge bg-light text-dark text-decoration-none rounded-pill py-1.5 px-3 border">Amoxicillin</a>
                    <a asp-controller="Thuoc" asp-action="Index" asp-route-search="Vitamin" class="badge bg-light text-dark text-decoration-none rounded-pill py-1.5 px-3 border">Vitamin C</a>
                    <a asp-controller="Thuoc" asp-action="Index" asp-route-search="Telfast" class="badge bg-light text-dark text-decoration-none rounded-pill py-1.5 px-3 border">Telfast</a>
                </div>
            </div>

            <div class="col-lg-5 text-center">
                <img src="~/images/nhathuoc-intro.svg" alt="Nhà thuốc An Tâm" class="img-fluid" style="max-height: 320px;" />
            </div>
        </div>
    </div>
</section>

<!-- Quick Action Service Cards -->
<section class="py-4">
    <div class="container">
        <div class="row g-3">
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm rounded-4 p-4 bg-white border-start border-4 border-success">
                    <div class="d-flex align-items-center gap-3">
                        <div class="w-12 h-12 rounded-3 bg-success-subtle text-success d-flex align-items-center justify-content-center p-3 fs-3">
                            <i class="bi bi-file-earmark-medical"></i>
                        </div>
                        <div>
                            <h5 class="fw-bold mb-1 text-slate-900">Gửi đơn thuốc tư vấn</h5>
                            <p class="text-muted small mb-2">Chụp ảnh đơn BS hoặc mã điện tử QG</p>
                            <a asp-controller="TuVan" asp-action="GuiDonThuoc" class="text-success fw-bold small text-decoration-none">
                                Gửi đơn ngay &rarr;
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm rounded-4 p-4 bg-white border-start border-4 border-primary">
                    <div class="d-flex align-items-center gap-3">
                        <div class="w-12 h-12 rounded-3 bg-primary-subtle text-primary d-flex align-items-center justify-content-center p-3 fs-3">
                            <i class="bi bi-truck"></i>
                        </div>
                        <div>
                            <h5 class="fw-bold mb-1 text-slate-900">Giao thuốc tận nơi</h5>
                            <p class="text-muted small mb-2">Đóng gói an toàn, hướng dẫn chi tiết</p>
                            <a asp-controller="Thuoc" asp-action="Index" class="text-primary fw-bold small text-decoration-none">
                                Mua thuốc trực tuyến &rarr;
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm rounded-4 p-4 bg-white border-start border-4 border-warning">
                    <div class="d-flex align-items-center gap-3">
                        <div class="w-12 h-12 rounded-3 bg-warning-subtle text-warning d-flex align-items-center justify-content-center p-3 fs-3">
                            <i class="bi bi-clock-history"></i>
                        </div>
                        <div>
                            <h5 class="fw-bold mb-1 text-slate-900">Theo dõi đơn hàng</h5>
                            <p class="text-muted small mb-2">Kiểm tra tiến độ đơn và hạn dùng lô xuất</p>
                            <a asp-controller="DonHang" asp-action="LichSu" class="text-warning fw-bold small text-decoration-none">
                                Tra cứu đơn hàng &rarr;
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Categories Pills -->
@if (categories.Any())
{
    <section class="py-4">
        <div class="container">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h3 class="h4 fw-bold text-slate-900 mb-0">Danh mục thuốc &amp; Dược phẩm</h3>
                <a asp-controller="Thuoc" asp-action="Index" class="text-success text-decoration-none fw-semibold small">
                    Xem tất cả nhóm thuốc &rarr;
                </a>
            </div>

            <div class="row row-cols-2 row-cols-md-3 row-cols-lg-6 g-3">
                @foreach (var cat in categories)
                {
                    <div class="col">
                        <a asp-controller="Thuoc" asp-action="Index" asp-route-maNhom="@cat.MaNhom" class="card border-0 shadow-sm rounded-4 p-3 text-center text-decoration-none text-slate-900 bg-white hover-shadow transition-all h-100">
                            <div class="mb-2 text-success fs-3">
                                <i class="bi bi-capsule"></i>
                            </div>
                            <h6 class="fw-bold mb-0 text-truncate small">@cat.TenNhom</h6>
                        </a>
                    </div>
                }
            </div>
        </div>
    </section>
}

<!-- Featured Products Section -->
@if (featuredMedicines.Any())
{
    <section class="py-4 my-2">
        <div class="container">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h3 class="h4 fw-bold text-slate-900 mb-1">Dược phẩm nổi bật</h3>
                    <p class="text-muted small mb-0">Các sản phẩm sẵn sàng giao hàng ngay</p>
                </div>
                <a asp-controller="Thuoc" asp-action="Index" class="btn btn-outline-success btn-sm rounded-pill px-3">
                    Xem toàn bộ thuốc
                </a>
            </div>

            <div class="row row-cols-1 row-cols-sm-2 row-cols-md-4 g-3">
                @foreach (var med in featuredMedicines)
                {
                    <div class="col">
                        <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden d-flex flex-column bg-white position-relative">
                            @if (med.KeDon == true)
                            {
                                <span class="position-absolute top-0 start-0 m-2 badge bg-danger text-white rounded-pill px-2.5 py-1 small fw-bold z-2">
                                    Rx Kê đơn
                                </span>
                            }

                            <div class="bg-light p-3 text-center position-relative" style="height: 160px; display: flex; align-items: center; justify-content: center;">
                                @{
                                    var imgSrc = !string.IsNullOrEmpty(med.AnhThuoc)
                                        ? (med.AnhThuoc.StartsWith("http") || med.AnhThuoc.StartsWith("/") ? med.AnhThuoc : Url.Content("~/uploads/thuoc/" + med.AnhThuoc))
                                        : Url.Content("~/images/medicine-default.svg");
                                }
                                <img src="@imgSrc" alt="@med.TenThuoc" class="img-fluid" style="max-height: 130px; object-fit: contain;" onerror="this.onerror=null; this.src='/images/medicine-default.svg';" />
                            </div>

                            <div class="card-body p-3 d-flex flex-column">
                                <span class="text-success small fw-semibold text-truncate">@(med.MaNhomNavigation?.TenNhom ?? "Thuốc")</span>
                                <h6 class="card-title fw-bold text-slate-900 mb-1 text-truncate-2" style="min-height: 40px;">
                                    <a asp-controller="Thuoc" asp-action="Details" asp-route-id="@med.MaThuoc" class="text-decoration-none text-slate-900">
                                        @med.TenThuoc
                                    </a>
                                </h6>

                                <div class="mt-auto pt-2 border-top d-flex justify-content-between align-items-center">
                                    <span class="fw-bold text-success fs-6">@med.GiaBan.ToString("N0") đ</span>
                                    <a asp-controller="Thuoc" asp-action="Details" asp-route-id="@med.MaThuoc" class="btn btn-outline-success btn-sm rounded-pill px-3">
                                        Xem
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>
}
