@{
    ViewData["Title"] = "Nhà thuốc An Tâm";
}

<section class="pharmacy-intro" aria-labelledby="intro-title">
    <div class="pharmacy-intro-copy">
        <span class="pharmacy-intro-label">NHÀ THUỐC AN TÂM</span>
        <h1 id="intro-title">Chăm sóc sức khỏe,<br /><span>bắt đầu từ sự an tâm.</span></h1>
        <p>Nhà thuốc An Tâm đồng hành cùng bạn và gia đình trên hành trình chăm sóc sức khỏe mỗi ngày — tận tâm, gần gũi và đáng tin cậy.</p>
    </div>
    <div class="pharmacy-intro-image">
        <img src="~/images/nhathuoc-intro.svg" asp-append-version="true" alt="Minh họa mặt tiền Nhà thuốc An Tâm với biểu tượng chữ thập y tế" />
    </div>
</section>
