@model PJ_net.Models.HoaDon
@{
    ViewData["Title"] = "Gửi đơn tư vấn thành công";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 text-center p-4 p-md-5">
                <div class="mb-4">
                    <div class="w-16 h-16 rounded-circle bg-success-subtle text-success d-inline-flex align-items-center justify-content-center" style="width: 72px; height: 72px;">
                        <i class="bi bi-file-earmark-check" style="font-size: 2.5rem;"></i>
                    </div>
                </div>

                <h3 class="fw-bold text-slate-900 mb-1">Đã nhận yêu cầu tư vấn!</h3>
                <p class="text-muted small mb-4">Dược sĩ chuyên môn của Nhà thuốc An Tâm sẽ liên hệ với bạn trong vòng 15-30 phút.</p>

                <div class="bg-light rounded-4 p-4 text-start mb-4">
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted small">Mã yêu cầu tư vấn:</span>
                        <strong class="text-success font-monospace fs-5">#@Model.MaHd</strong>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted small">Thời gian gửi:</span>
                        <span class="text-dark small">@(Model.NgayLap?.ToString("dd/MM/yyyy HH:mm") ?? DateTime.Now.ToString("dd/MM/yyyy HH:mm"))</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted small">Hình thức đơn:</span>
                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2.5 py-1 rounded-pill">
                            @(Model.LoaiDonTuVan == "GuiAnh" ? "Ảnh chụp đơn bác sĩ" : "Mã đơn điện tử QG")
                        </span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted small">Trạng thái:</span>
                        <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-2.5 py-1 rounded-pill">
                            Chờ Dược sĩ liên hệ
                        </span>
                    </div>
                    <div class="mt-3 pt-3 border-top text-muted small">
                        <strong>Nội dung yêu cầu:</strong>
                        <div>@Model.GhiChuKhachHang</div>
                    </div>
                </div>

                <div class="d-flex gap-2 justify-content-center">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                        Về trang chủ
                    </a>
                    <a asp-controller="Thuoc" asp-action="Index" class="btn btn-success rounded-pill px-4 fw-bold">
                        Xem thuốc &amp; dược phẩm
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
