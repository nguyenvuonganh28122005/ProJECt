@model PJ_net.Controllers.TuVanViewModel
@{
    ViewData["Title"] = "Gửi đơn thuốc để được Dược sĩ tư vấn";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5">
                <div class="text-center mb-4 pb-2 border-bottom">
                    <span class="badge bg-success-subtle text-success px-3 py-1 rounded-pill mb-2 fw-semibold">Tư vấn Dược sĩ 24/7</span>
                    <h2 class="h3 fw-bold text-slate-900">Gửi đơn thuốc để được tư vấn</h2>
                    <p class="text-muted small">Bạn chỉ cần chụp ảnh đơn thuốc của Bác sĩ hoặc cung cấp Mã đơn điện tử. Dược sĩ sẽ kiểm tra tương tác thuốc, định lượng và gọi lại hướng dẫn chi tiết.</p>
                </div>

                <form asp-action="GuiDonThuoc" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3" role="alert"></div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="HoTen" class="form-label small fw-bold">Họ và tên của bạn</label>
                            <input asp-for="HoTen" class="form-control" placeholder="Nguyễn Văn A" />
                            <span asp-validation-for="HoTen" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="SoDienThoai" class="form-label small fw-bold">Số điện thoại liên hệ</label>
                            <input asp-for="SoDienThoai" class="form-control" placeholder="0912345678" />
                            <span asp-validation-for="SoDienThoai" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="DiaChi" class="form-label small fw-bold">Địa chỉ nhận thuốc (nếu cần giao tận nhà)</label>
                        <input asp-for="DiaChi" class="form-control" placeholder="Địa chỉ giao hàng" />
                    </div>

                    <!-- Options for Prescription -->
                    <div class="mb-4">
                        <label class="form-label small fw-bold">Chọn hình thức cung cấp đơn thuốc</label>
                        <div class="form-check p-3 bg-light rounded-3 border mb-2">
                            <input class="form-check-input" type="radio" name="LoaiDonTuVan" id="optAnh" value="GuiAnh" checked onchange="toggleTuVan()">
                            <label class="form-check-label fw-bold" for="optAnh">
                                <i class="bi bi-camera text-success me-1"></i> Tải ảnh chụp đơn thuốc của Bác sĩ
                            </label>
                            <div class="text-muted small mt-1">Ảnh chụp rõ chữ Bác sĩ, liều dùng và chẩn đoán.</div>

                            <div id="boxAnh" class="mt-3">
                                <input type="file" name="anhDonThuoc" class="form-control" accept=".jpg,.jpeg,.png,.webp,.pdf" />
                            </div>
                        </div>

                        <div class="form-check p-3 bg-light rounded-3 border">
                            <input class="form-check-input" type="radio" name="LoaiDonTuVan" id="optMa" value="GuiMaDon" onchange="toggleTuVan()">
                            <label class="form-check-label fw-bold" for="optMa">
                                <i class="bi bi-qr-code-scan text-primary me-1"></i> Nhập Mã đơn thuốc điện tử quốc gia
                            </label>
                            <div class="text-muted small mt-1">Mã đơn cấp qua SMS/Hồ sơ bệnh án điện tử.</div>

                            <div id="boxMa" class="mt-3 d-none">
                                <input asp-for="MaDonThuocDienTu" class="form-control" placeholder="Ví dụ: DT-2026-981248" />
                            </div>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="GhiChu" class="form-label small fw-bold">Mô tả triệu chứng / Lưu ý về dị ứng thuốc (nếu có)</label>
                        <textarea asp-for="GhiChu" rows="3" class="form-control" placeholder="Ví dụ: Tiền sử dị ứng Penicillin, đang có thai hoặc cho con bú..."></textarea>
                    </div>

                    <button type="submit" class="btn btn-success w-100 py-3 rounded-pill fw-bold shadow-sm">
                        <i class="bi bi-send-check me-1"></i> Gửi đơn cho Dược sĩ thẩm định &amp; tư vấn
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function toggleTuVan() {
            var isAnh = document.getElementById('optAnh')?.checked;
            document.getElementById('boxAnh')?.classList.toggle('d-none', !isAnh);
            document.getElementById('boxMa')?.classList.toggle('d-none', isAnh);
        }
    </script>
}
