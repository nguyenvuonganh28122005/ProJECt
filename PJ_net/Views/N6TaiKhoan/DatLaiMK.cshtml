@model PJ_net.ViewModels.ResetPasswordViewModel
@{
    Layout = "_TaiKhoanLayout";
    ViewData["Title"] = "Đặt lại mật khẩu";
}
<div class="auth-card">
  <div class="auth-card-header">
    <h1>Đặt mật khẩu mới</h1>
    <p class="auth-subtitle">Tạo mật khẩu mới có ít nhất 8 ký tự.</p>
  </div>
  <div class="auth-card-body">
    @if (!ViewData.ModelState.IsValid)
    {
      <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>
    }
    <form asp-area="" asp-controller="TaiKhoan" asp-action="DatLaiMK" method="post">
      @Html.AntiForgeryToken()
      <div class="mb-3">
        <label asp-for="MatKhau" class="form-label"></label>
        <input asp-for="MatKhau" class="form-control" autocomplete="new-password" />
        <span asp-validation-for="MatKhau" class="text-danger"></span>
      </div>
      <div class="mb-3">
        <label asp-for="XacNhanMatKhau" class="form-label"></label>
        <input asp-for="XacNhanMatKhau" class="form-control" autocomplete="new-password" />
        <span asp-validation-for="XacNhanMatKhau" class="text-danger"></span>
      </div>
      <button type="submit" class="btn btn-success w-100 py-2">Lưu mật khẩu mới</button>
    </form>
  </div>
</div>
