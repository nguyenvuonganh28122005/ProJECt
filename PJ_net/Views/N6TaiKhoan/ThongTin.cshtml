@model PJ_net.ViewModels.ProfileViewModel
@{
    ViewData["Title"] = "Thông tin tài khoản";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4 p-md-5">
                    <div class="d-flex align-items-center justify-content-between mb-4 pb-3 border-bottom">
                        <div>
                            <h3 class="fw-bold mb-1 text-success">Hồ sơ cá nhân</h3>
                            <p class="text-muted small mb-0">Quản lý thông tin tài khoản Nhà thuốc An Tâm</p>
                        </div>
                        <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 rounded-pill font-monospace">
                            @Model.VaiTroTen
                        </span>
                    </div>

                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show rounded-3" role="alert">
                            <i class="bi bi-check-circle me-1"></i> @TempData["SuccessMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <form asp-action="ThongTin" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3" role="alert"></div>

                        <div class="mb-3">
                            <label class="form-label text-muted small fw-bold">Tên đăng nhập</label>
                            <input type="text" class="form-control bg-light" value="@Model.TenDangNhap" readonly />
                            <div class="form-text">Tên đăng nhập không thể thay đổi.</div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="HoTen" class="form-label small fw-bold"></label>
                            <input asp-for="HoTen" class="form-control" />
                            <span asp-validation-for="HoTen" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="SoDienThoai" class="form-label small fw-bold"></label>
                            <input asp-for="SoDienThoai" class="form-control" />
                            <span asp-validation-for="SoDienThoai" class="text-danger small"></span>
                        </div>

                        <div class="d-flex gap-2 justify-content-between pt-2">
                            <a asp-action="DoiMatKhau" class="btn btn-outline-secondary rounded-pill px-3">
                                <i class="bi bi-key me-1"></i> Đổi mật khẩu
                            </a>
                            <button type="submit" class="btn btn-success rounded-pill px-4 fw-bold">
                                Lưu thay đổi
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
