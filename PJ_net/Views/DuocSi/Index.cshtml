@{
    ViewData["Title"] = "Trang dược sĩ";
}
<div class="container py-5">
  <div class="card border-0 shadow-sm mx-auto" style="max-width: 760px;">
    <div class="card-body p-4 p-md-5">
      <span class="badge text-bg-success mb-3">Tài khoản dược sĩ</span>
      <h1 class="h3">Xin chào, @User.Identity?.Name</h1>
      <p class="text-secondary">Bạn đã đăng nhập vào khu vực dành cho dược sĩ.</p>
      <a asp-controller="Home" asp-action="Index" class="btn btn-outline-success">Đến trang khách hàng</a>
      <form asp-controller="TaiKhoan" asp-action="DangXuat" method="post" class="d-inline">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-outline-secondary ms-2">Đăng xuất</button>
      </form>
    </div>
  </div>
</div>
