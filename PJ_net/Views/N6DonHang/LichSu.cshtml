@model IEnumerable<PJ_net.Models.N6HoaDon>
@{
    ViewData["Title"] = "Lịch sử mua hàng & Tra cứu đơn";
    bool requiresSearch = ViewBag.RequiresSearch == true;
}

<div class="container py-4">
    <!-- Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 pb-2 border-bottom">
        <div>
            <h2 class="h3 fw-bold text-slate-900 mb-1">Lịch sử &amp; Theo dõi đơn hàng</h2>
            <p class="text-muted small mb-0">Theo dõi tiến trình xử lý, xuất kho FEFO và giao hàng của Nhà thuốc An Tâm</p>
        </div>

        @if (!User.Identity?.IsAuthenticated == true)
        {
            <div class="mt-2 mt-md-0">
                <a asp-controller="TaiKhoan" asp-action="DangNhap" class="btn btn-outline-success btn-sm rounded-pill">
                    Đăng nhập để xem tự động
                </a>
            </div>
        }
    </div>

    <!-- Search box for Guests -->
    <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-light">
        <form method="get" asp-action="LichSu" class="row g-2 align-items-center">
            <div class="col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-hash"></i></span>
                    <input type="number" name="maHd" value="@ViewBag.SearchMaHd" class="form-control border-start-0" placeholder="Tra cứu theo Mã đơn hàng (VD: 25)" />
                </div>
            </div>
            <div class="col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-telephone"></i></span>
                    <input type="text" name="sdt" value="@ViewBag.SearchSdt" class="form-control border-start-0" placeholder="Hoặc theo Số điện thoại đặt hàng" />
                </div>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-success w-100 rounded-pill fw-bold">Tra cứu</button>
            </div>
        </form>
    </div>

    @if (requiresSearch)
    {
        <div class="card border-0 shadow-sm rounded-4 p-5 text-center">
            <div class="text-muted mb-3"><i class="bi bi-search fs-1 text-success"></i></div>
            <h5>Tra cứu đơn hàng</h5>
            <p class="text-muted small">Vui lòng nhập Mã đơn hàng hoặc Số điện thoại để theo dõi đơn thuốc của bạn.</p>
        </div>
    }
    else if (!Model.Any())
    {
        <div class="card border-0 shadow-sm rounded-4 p-5 text-center">
            <div class="text-muted mb-3"><i class="bi bi-inbox fs-1 text-muted"></i></div>
            <h5>Không tìm thấy đơn hàng nào</h5>
            <p class="text-muted small">Hãy kiểm tra lại thông tin số điện thoại hoặc mã đơn.</p>
            <div class="mt-2">
                <a asp-controller="Thuoc" asp-action="Index" class="btn btn-success rounded-pill px-4">Khám phá thuốc ngay</a>
            </div>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-muted small text-uppercase">
                        <tr>
                            <th class="ps-4">Mã Đơn</th>
                            <th>Ngày đặt</th>
                            <th>Hình thức</th>
                            <th>Đơn thuốc kê đơn (Rx)</th>
                            <th>Tổng tiền</th>
                            <th>Trạng thái</th>
                            <th class="text-end pe-4">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var hd in Model)
                        {
                            <tr>
                                <td class="ps-4 font-monospace fw-bold text-success">#@hd.MaHd</td>
                                <td class="small">@(hd.NgayLap?.ToString("dd/MM/yyyy HH:mm") ?? "-")</td>
                                <td>
                                    @if (hd.HinhThuc == "TaiQuay")
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary rounded-pill">Tại quầy</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-primary-subtle text-primary rounded-pill">Trực tuyến</span>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(hd.LoaiDonTuVan))
                                    {
                                        <span class="badge bg-danger text-white rounded-pill small">
                                            <i class="bi bi-file-medical me-1"></i>@(hd.LoaiDonTuVan == "GuiAnh" ? "Ảnh đơn BS" : "Đơn điện tử QG")
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Không kê đơn</span>
                                    }
                                </td>
                                <td class="fw-bold text-slate-800">@((hd.TongTien ?? 0).ToString("N0")) đ</td>
                                <td>
                                    @{
                                        var badgeClass = hd.TrangThai switch
                                        {
                                            "HoanTat" => "bg-success text-white",
                                            "DaXacNhan" => "bg-info text-white",
                                            "DangGiao" => "bg-primary text-white",
                                            "DaHuy" => "bg-danger text-white",
                                            _ => "bg-warning text-dark"
                                        };
                                        var statusText = hd.TrangThai switch
                                        {
                                            "ChoXacNhan" => "Chờ Dược sĩ xác nhận",
                                            "DaXacNhan" => "Đã duyệt - Xuất kho FEFO",
                                            "DangGiao" => "Đang giao hàng",
                                            "HoanTat" => "Hoàn tất đơn",
                                            "DaHuy" => "Đã hủy",
                                            _ => hd.TrangThai
                                        };
                                    }
                                    <span class="badge @badgeClass rounded-pill px-3 py-1.5 small">
                                        @statusText
                                    </span>
                                </td>
                                <td class="text-end pe-4">
                                    <a asp-action="ChiTiet" asp-route-id="@hd.MaHd" class="btn btn-outline-success btn-sm rounded-pill px-3">
                                        Chi tiết
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
