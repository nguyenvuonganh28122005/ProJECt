@model PJ_net.Models.N6HoaDon
@{
    ViewData["Title"] = "Đặt hàng thành công";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 text-center p-4 p-md-5">
                <div class="mb-4">
                    <div class="w-16 h-16 rounded-circle bg-success-subtle text-success d-inline-flex align-items-center justify-content-center" style="width: 72px; height: 72px;">
                        <i class="bi bi-check-lg" style="font-size: 2.5rem;"></i>
                    </div>
                </div>

                <h3 class="fw-bold text-slate-900 mb-1">Đặt thuốc thành công!</h3>
                <p class="text-muted small mb-4">Cảm ơn bạn đã tin tưởng dịch vụ của Nhà thuốc An Tâm.</p>

                <div class="bg-light rounded-4 p-4 text-start mb-4">
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted small">Mã đơn hàng:</span>
                        <strong class="text-success font-monospace fs-5">#@Model.MaHd</strong>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted small">Thời gian đặt:</span>
                        <span class="text-dark small">@(Model.NgayLap?.ToString("dd/MM/yyyy HH:mm") ?? DateTime.Now.ToString("dd/MM/yyyy HH:mm"))</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted small">Trạng thái:</span>
                        <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-2.5 py-1 rounded-pill">
                            @Model.TrangThai
                        </span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted small">Tổng thanh toán:</span>
                        <strong class="text-slate-900 fs-5">@((Model.TongTien ?? 0).ToString("N0")) đ</strong>
                    </div>
                    <div class="mt-3 pt-3 border-top text-muted small">
                        <strong>Thông tin nhận hàng:</strong>
                        <div>@Model.GhiChuKhachHang</div>
                    </div>
                </div>

                <div class="d-flex gap-2 justify-content-center">
                    <a asp-controller="DonHang" asp-action="LichSu" class="btn btn-outline-success rounded-pill px-4">
                        <i class="bi bi-clock-history me-1"></i> Xem lịch sử đơn
                    </a>
                    <a asp-controller="Thuoc" asp-action="Index" class="btn btn-success rounded-pill px-4 fw-bold">
                        Tiếp tục mua hàng
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
