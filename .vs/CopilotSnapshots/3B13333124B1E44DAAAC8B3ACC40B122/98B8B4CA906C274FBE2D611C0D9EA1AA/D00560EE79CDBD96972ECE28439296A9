@model Staybook_sidePj.Areas.Admin.ViewModels.AmenityEditViewModel
@{ var editing = Model.Id.HasValue; ViewData["Title"] = editing ? "Sửa tiện nghi" : "Thêm tiện nghi"; }
<div class="app-content-header">
    <div class="container-fluid">
        <h1 class="fs-3">@ViewData["Title"]</h1>
    </div>
</div>
<div class="app-content">
    <div class="container-fluid">
        <div class="card">
            <form method="post" asp-action="@(editing ? "Edit" : "Create")">
                <div class="card-body">
                    <input asp-for="Id" type="hidden" />
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <div class="mb-3">
                        <label asp-for="Name" class="form-label">Tên tiện nghi</label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Description" class="form-label">Mô tả</label>
                        <textarea asp-for="Description" class="form-control"></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>
                </div>
                <div class="card-footer">
                    <button class="btn btn-primary">Lưu</button>
                    <a class="btn btn-secondary" asp-action="Index">Hủy</a>
                </div>
            </form>
        </div>
    </div>
</div>
