using Microsoft.AspNetCore.Authorization;
using Microsoft.AspNetCore.Mvc;
using Microsoft.EntityFrameworkCore;
using Staybook_sidePj.Areas.Admin.ViewModels;
using Staybook_sidePj.Data;
using Staybook_sidePj.Models.Database;

namespace Staybook_sidePj.Areas.Admin.Controllers;

[Area("Admin")]
[Authorize(Roles = "Admin")]
public sealed class RoomsController(StaybookDbContext dbContext) : Controller
{
    private static readonly string[] RoomStatuses = ["Trống", "Đang ở", "Bảo trì"];

    [HttpGet]
    public async Task<IActionResult> Index(string? search, int? roomTypeId, string? status, int page = 1, CancellationToken cancellationToken = default)
    {
        const int pageSize = 20;
        page = Math.Max(1, page);
        var query = dbContext.Phong.AsNoTracking()
            .Include(room => room.MaLoaiPhongNavigation)
                .ThenInclude(type => type.MaNoiLuuTruNavigation)
            .AsQueryable();
        if (!string.IsNullOrWhiteSpace(search))
        {
            var term = search.Trim();
            query = query.Where(room => room.SoPhong.Contains(term));
        }
        if (roomTypeId.HasValue)
        {
            query = query.Where(room => room.MaLoaiPhong == roomTypeId.Value);
        }
        if (!string.IsNullOrWhiteSpace(status))
        {
            query = query.Where(room => room.TrangThaiPhong == status);
        }

        var count = await query.CountAsync(cancellationToken);
        var items = await query.OrderBy(room => room.SoPhong)
            .Skip((page - 1) * pageSize)
            .Take(pageSize)
            .Select(room => new RoomRowViewModel
            {
                Id = room.MaPhong,
                RoomNumber = room.SoPhong,
                RoomTypeName = room.MaLoaiPhongNavigation.TenLoaiPhong,
                AccommodationName = room.MaLoaiPhongNavigation.MaNoiLuuTruNavigation.TenNoiLuuTru,
                Status = room.TrangThaiPhong
            })
            .ToListAsync(cancellationToken);

        return View(new RoomIndexViewModel
        {
            Search = search,
            RoomTypeId = roomTypeId,
            Status = status,
            Page = page,
            TotalPages = (int)Math.Ceiling(count / (double)pageSize),
            RoomTypes = await GetRoomTypeOptionsAsync(cancellationToken),
            Statuses = RoomStatuses,
            Items = items
        });
    }

    [HttpGet]
    public async Task<IActionResult> Create(CancellationToken cancellationToken)
    {
        var model = new RoomEditViewModel();
        await PopulateOptionsAsync(model, cancellationToken);
        return View("Edit", model);
    }

    [HttpPost, ValidateAntiForgeryToken]
    public async Task<IActionResult> Create(RoomEditViewModel model, CancellationToken cancellationToken)
    {
        if (!RoomStatuses.Contains(model.Status))
        {
            ModelState.AddModelError(nameof(model.Status), "Trạng thái phòng không hợp lệ.");
        }
        if (!ModelState.IsValid)
        {
            await PopulateOptionsAsync(model, cancellationToken);
            return View("Edit", model);
        }

        dbContext.Phong.Add(new Phong
        {
            MaLoaiPhong = model.RoomTypeId,
            SoPhong = model.RoomNumber.Trim(),
            TrangThaiPhong = model.Status
        });
        await dbContext.SaveChangesAsync(cancellationToken);
        return RedirectToAction(nameof(Index));
    }

    [HttpGet]
    public async Task<IActionResult> Edit(int id, CancellationToken cancellationToken)
    {
        var room = await dbContext.Phong.AsNoTracking().SingleOrDefaultAsync(x => x.MaPhong == id, cancellationToken);
        if (room is null)
        {
            return NotFound();
        }

        var model = new RoomEditViewModel
        {
            Id = room.MaPhong,
            RoomTypeId = room.MaLoaiPhong,
            RoomNumber = room.SoPhong,
            Status = room.TrangThaiPhong
        };
        await PopulateOptionsAsync(model, cancellationToken);
        return View(model);
    }

    [HttpPost, ValidateAntiForgeryToken]
    public async Task<IActionResult> Edit(RoomEditViewModel model, CancellationToken cancellationToken)
    {
        if (!RoomStatuses.Contains(model.Status))
        {
            ModelState.AddModelError(nameof(model.Status), "Trạng thái phòng không hợp lệ.");
        }
        if (!ModelState.IsValid || model.Id is null)
        {
            await PopulateOptionsAsync(model, cancellationToken);
            return View(model);
        }

        var room = await dbContext.Phong.FindAsync([model.Id.Value], cancellationToken);
        if (room is null)
        {
            return NotFound();
        }

        room.MaLoaiPhong = model.RoomTypeId;
        room.SoPhong = model.RoomNumber.Trim();
        room.TrangThaiPhong = model.Status;
        await dbContext.SaveChangesAsync(cancellationToken);
        return RedirectToAction(nameof(Index));
    }

    [HttpPost, ValidateAntiForgeryToken]
    public async Task<IActionResult> Delete(int id, CancellationToken cancellationToken)
    {
        var room = await dbContext.Phong.FindAsync([id], cancellationToken);
        if (room is null)
        {
            return NotFound();
        }
        if (await dbContext.Chitietdatphong.AnyAsync(x => x.MaPhong == id, cancellationToken))
        {
            TempData["Error"] = "Không thể xóa phòng đã xuất hiện trong chi tiết đặt phòng.";
            return RedirectToAction(nameof(Index));
        }

        dbContext.Phong.Remove(room);
        await dbContext.SaveChangesAsync(cancellationToken);
        return RedirectToAction(nameof(Index));
    }

    private async Task PopulateOptionsAsync(RoomEditViewModel model, CancellationToken cancellationToken)
    {
        model.RoomTypes = await GetRoomTypeOptionsAsync(cancellationToken);
        model.Statuses = RoomStatuses;
    }

    private Task<List<RoomOptionViewModel>> GetRoomTypeOptionsAsync(CancellationToken cancellationToken) =>
        dbContext.Loaiphong.AsNoTracking()
            .OrderBy(x => x.TenLoaiPhong)
            .Select(x => new RoomOptionViewModel
            {
                Id = x.MaLoaiPhong,
                Name = x.MaNoiLuuTruNavigation.TenNoiLuuTru + " — " + x.TenLoaiPhong
            })
            .ToListAsync(cancellationToken);
}
