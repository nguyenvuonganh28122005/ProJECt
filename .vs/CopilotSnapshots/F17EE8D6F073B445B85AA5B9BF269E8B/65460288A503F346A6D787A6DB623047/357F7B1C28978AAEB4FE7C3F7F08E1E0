using Microsoft.AspNetCore.Authorization;
using Microsoft.AspNetCore.Mvc;
using Microsoft.EntityFrameworkCore;
using Staybook_sidePj.Areas.Admin.ViewModels;
using Staybook_sidePj.Data;
using Staybook_sidePj.Models.Database;

namespace Staybook_sidePj.Areas.Admin.Controllers;

[Area("Admin")]
[Authorize(Roles = "Admin")]
public sealed class AmenitiesController(StaybookDbContext dbContext) : Controller
{
    [HttpGet]
    public async Task<IActionResult> Index(string? search, int page = 1, CancellationToken cancellationToken = default)
    {
        const int pageSize = 20;
        page = Math.Max(page, 1);
        var query = dbContext.Tiennghi.AsNoTracking();
        if (!string.IsNullOrWhiteSpace(search))
        {
            var term = search.Trim();
            query = query.Where(item => item.TenTienNghi.Contains(term));
        }

        var count = await query.CountAsync(cancellationToken);
        var items = await query.OrderBy(item => item.TenTienNghi)
            .Skip((page - 1) * pageSize)
            .Take(pageSize)
            .Select(item => new AmenityRowViewModel
            {
                Id = item.MaTienNghi,
                Name = item.TenTienNghi,
                Description = item.MoTa,
                RoomTypeCount = item.MaLoaiPhong.Count
            })
            .ToListAsync(cancellationToken);
        return View(new AmenityIndexViewModel
        {
            Search = search,
            Page = page,
            TotalPages = (int)Math.Ceiling(count / (double)pageSize),
            Items = items
        });
    }

    [HttpGet]
    public IActionResult Create() => View("Edit", new AmenityEditViewModel());

    [HttpPost, ValidateAntiForgeryToken]
    public async Task<IActionResult> Create(AmenityEditViewModel model, CancellationToken cancellationToken)
    {
        if (!ModelState.IsValid)
        {
            return View("Edit", model);
        }

        dbContext.Tiennghi.Add(new Tiennghi
        {
            TenTienNghi = model.Name.Trim(),
            MoTa = model.Description?.Trim()
        });
        await dbContext.SaveChangesAsync(cancellationToken);
        return RedirectToAction(nameof(Index));
    }

    [HttpGet]
    public async Task<IActionResult> Edit(int id, CancellationToken cancellationToken)
    {
        var item = await dbContext.Tiennghi.AsNoTracking().SingleOrDefaultAsync(x => x.MaTienNghi == id, cancellationToken);
        return item is null ? NotFound() : View(new AmenityEditViewModel { Id = item.MaTienNghi, Name = item.TenTienNghi, Description = item.MoTa });
    }

    [HttpPost, ValidateAntiForgeryToken]
    public async Task<IActionResult> Edit(AmenityEditViewModel model, CancellationToken cancellationToken)
    {
        if (!ModelState.IsValid || model.Id is null)
        {
            return View(model);
        }

        var item = await dbContext.Tiennghi.FindAsync([model.Id.Value], cancellationToken);
        if (item is null)
        {
            return NotFound();
        }

        item.TenTienNghi = model.Name.Trim();
        item.MoTa = model.Description?.Trim();
        await dbContext.SaveChangesAsync(cancellationToken);
        return RedirectToAction(nameof(Index));
    }

    [HttpPost, ValidateAntiForgeryToken]
    public async Task<IActionResult> Delete(int id, CancellationToken cancellationToken)
    {
        var item = await dbContext.Tiennghi.Include(x => x.MaLoaiPhong)
            .SingleOrDefaultAsync(x => x.MaTienNghi == id, cancellationToken);
        if (item is null)
        {
            return NotFound();
        }

        if (item.MaLoaiPhong.Count > 0)
        {
            TempData["Error"] = "Không thể xóa tiện nghi đang được gán cho loại phòng.";
            return RedirectToAction(nameof(Index));
        }

        dbContext.Tiennghi.Remove(item);
        await dbContext.SaveChangesAsync(cancellationToken);
        return RedirectToAction(nameof(Index));
    }
}
