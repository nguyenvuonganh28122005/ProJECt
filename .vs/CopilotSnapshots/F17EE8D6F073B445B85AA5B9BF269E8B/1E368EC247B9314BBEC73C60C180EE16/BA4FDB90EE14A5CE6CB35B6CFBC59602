using Microsoft.AspNetCore.Mvc;
using Microsoft.EntityFrameworkCore;
using Staybook_sidePj.Areas.Admin.ViewModels;
using Staybook_sidePj.Data;

namespace Staybook_sidePj.Areas.Admin.Controllers;

[Area("Admin")]
public sealed class DashboardController(StaybookDbContext dbContext) : Controller
{
    [HttpGet]
    public async Task<IActionResult> Index(CancellationToken cancellationToken)
    {
        var monthStart = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
        var rangeStart = monthStart.AddMonths(-11);

        var revenue = await dbContext.Thanhtoan
            .AsNoTracking()
            .Where(payment => payment.TrangThaiThanhToan == "Đã thanh toán")
            .SumAsync(payment => (decimal?)payment.SoTien, cancellationToken) ?? 0m;

        var bookingCount = await dbContext.Datphong.CountAsync(cancellationToken);
        var accommodationCount = await dbContext.Noiluutru.CountAsync(cancellationToken);
        var userCount = await dbContext.Nguoidung.CountAsync(cancellationToken);

        var revenueByMonth = await dbContext.Thanhtoan
            .AsNoTracking()
            .Where(payment => payment.TrangThaiThanhToan == "Đã thanh toán"
                && payment.NgayThanhToan >= rangeStart
                && payment.NgayThanhToan < monthStart.AddMonths(1))
            .GroupBy(payment => new
            {
                Year = payment.NgayThanhToan!.Value.Year,
                Month = payment.NgayThanhToan.Value.Month
            })
            .Select(group => new
            {
                group.Key.Year,
                group.Key.Month,
                Amount = group.Sum(payment => payment.SoTien)
            })
            .ToListAsync(cancellationToken);

        var revenueLookup = revenueByMonth.ToDictionary(
            row => (row.Year, row.Month),
            row => row.Amount);
        var monthAmounts = Enumerable.Range(0, 12)
            .Select(offset => monthStart.AddMonths(offset - 11))
            .Select(month => revenueLookup.GetValueOrDefault((month.Year, month.Month)))
            .ToList();
        var maximumMonthAmount = monthAmounts.DefaultIfEmpty().Max();

        var monthlyRevenue = Enumerable.Range(0, 12)
            .Select(offset => monthStart.AddMonths(offset - 11))
            .Select((month, index) => new RevenueMonthViewModel
            {
                Label = month.ToString("MM/yy"),
                Amount = monthAmounts[index],
                Percent = maximumMonthAmount == 0 ? 0 : (double)(monthAmounts[index] / maximumMonthAmount * 100m)
            })
            .ToList();

        var recentBookings = await dbContext.Datphong
            .AsNoTracking()
            .Include(booking => booking.MaNguoiDungNavigation)
            .Include(booking => booking.MaNoiLuuTruNavigation)
            .OrderByDescending(booking => booking.NgayTao)
            .Take(6)
            .Select(booking => new RecentBookingViewModel
            {
                Id = booking.MaDatPhong,
                GuestName = booking.MaNguoiDungNavigation.HoTen,
                AccommodationName = booking.MaNoiLuuTruNavigation.TenNoiLuuTru,
                CheckIn = booking.NgayNhanPhong,
                Status = booking.TrangThaiDatPhong,
                Total = booking.TongTien
            })
            .ToListAsync(cancellationToken);

        var recentReviews = await dbContext.Danhgia
            .AsNoTracking()
            .Include(review => review.MaNguoiDungNavigation)
            .Include(review => review.MaNoiLuuTruNavigation)
            .OrderByDescending(review => review.NgayTao)
            .Take(6)
            .Select(review => new RecentReviewViewModel
            {
                Id = review.MaDanhGia,
                GuestName = review.MaNguoiDungNavigation.HoTen,
                AccommodationName = review.MaNoiLuuTruNavigation.TenNoiLuuTru,
                Rating = review.DiemDanhGia,
                Comment = review.NoiDung,
                CreatedAt = review.NgayTao
            })
            .ToListAsync(cancellationToken);

        return View(new DashboardViewModel
        {
            TotalRevenue = revenue,
            BookingCount = bookingCount,
            AccommodationCount = accommodationCount,
            UserCount = userCount,
            MonthlyRevenue = monthlyRevenue,
            RecentBookings = recentBookings,
            RecentReviews = recentReviews
        });
    }
}
