<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <title>@ViewData["Title"] - Staybook Admin</title>
    <link rel="stylesheet" href="~/adminlte/css/adminlte.min.css" asp-append-version="true" />
</head>
<body class="layout-fixed sidebar-expand-lg bg-body-tertiary">
    <div class="app-wrapper">
        <nav class="app-header navbar navbar-expand bg-body">
            <div class="container-fluid">
                <ul class="navbar-nav">
                    <li class="nav-item">
                        <a class="nav-link" data-lte-toggle="sidebar" href="#" role="button" aria-label="Ẩn hoặc hiện menu">
                            <span aria-hidden="true">☰</span>
                        </a>
                    </li>
                    <li class="nav-item d-none d-md-block">
                        <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Xem trang công khai</a>
                    </li>
                </ul>
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <span class="nav-link">Quản trị Staybook</span>
                    </li>
                </ul>
            </div>
        </nav>

        <aside class="app-sidebar bg-body-secondary shadow" data-bs-theme="dark">
            <div class="sidebar-brand">
                <a class="brand-link text-decoration-none" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                    <span class="brand-text fw-light">Staybook <strong>Admin</strong></span>
                </a>
            </div>
            <div class="sidebar-wrapper">
                <nav class="mt-2" aria-label="Điều hướng quản trị">
                    <ul class="nav sidebar-menu flex-column" data-lte-toggle="treeview" role="menu" data-accordion="false">
                        <li class="nav-header">QUẢN LÝ</li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                                <span class="nav-icon" aria-hidden="true">▦</span>
                                <p>Tổng quan</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="Admin" asp-controller="Bookings" asp-action="Index">
                                <span class="nav-icon" aria-hidden="true">▣</span>
                                <p>Đặt chỗ</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="Admin" asp-controller="Accommodations" asp-action="Index">
                                <span class="nav-icon" aria-hidden="true">⌂</span>
                                <p>Chỗ nghỉ</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="Admin" asp-controller="RoomTypes" asp-action="Index">
                                <span class="nav-icon" aria-hidden="true">▤</span>
                                <p>Loại phòng</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="Admin" asp-controller="Rooms" asp-action="Index">
                                <span class="nav-icon" aria-hidden="true">▦</span>
                                <p>Phòng</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="Admin" asp-controller="Amenities" asp-action="Index">
                                <span class="nav-icon" aria-hidden="true">✦</span>
                                <p>Tiện nghi</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="Admin" asp-controller="Users" asp-action="Index">
                                <span class="nav-icon" aria-hidden="true">♙</span>
                                <p>Người dùng</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="Admin" asp-controller="Payments" asp-action="Index">
                                <span class="nav-icon" aria-hidden="true">₫</span>
                                <p>Thanh toán</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="Admin" asp-controller="Reviews" asp-action="Index">
                                <span class="nav-icon" aria-hidden="true">★</span>
                                <p>Đánh giá</p>
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        </aside>

        <main class="app-main">
            <div class="px-3 pt-3">
                <div class="alert alert-warning py-2 mb-0" role="alert">
                    Chế độ khung phát triển: Admin chưa có đăng nhập hoặc phân quyền. Không triển khai công khai.
                </div>
            </div>
            @RenderBody()
        </main>

        <footer class="app-footer">
            <span>Staybook Admin</span>
            <span class="float-end d-none d-sm-inline">&copy; @DateTime.Now.Year Staybook</span>
        </footer>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/adminlte/js/adminlte.min.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
