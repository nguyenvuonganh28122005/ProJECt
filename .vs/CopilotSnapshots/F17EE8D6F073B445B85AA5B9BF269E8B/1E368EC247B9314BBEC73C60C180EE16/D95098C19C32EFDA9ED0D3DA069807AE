using Microsoft.AspNetCore.Mvc;
using Microsoft.EntityFrameworkCore;
using Staybook_sidePj.Areas.Admin.ViewModels;
using Staybook_sidePj.Data;
using Staybook_sidePj.Models.Database;

namespace Staybook_sidePj.Areas.Admin.Controllers;

[Area("Admin")]
public sealed class AccommodationsController(StaybookDbContext dbContext) : Controller
{
    [HttpGet]
    public async Task<IActionResult> Index(string? search, string? type, int page = 1, CancellationToken cancellationToken = default)
    {
        const int pageSize = 15;
        page = Math.Max(1, page);
        var query = dbContext.Noiluutru.AsNoTracking();

        if (!string.IsNullOrWhiteSpace(search))
        {
            var term = search.Trim();
            query = query.Where(item => item.TenNoiLuuTru.Contains(term) || item.DiaChi.Contains(term));
        }

        if (!string.IsNullOrWhiteSpace(type))
        {
            query = query.Where(item => item.LoaiHinh == type);
        }

        var totalCount = await query.CountAsync(cancellationToken);
        var items = await query
            .Include(item => item.Hinhanhnoiluutru)
            .OrderBy(item => item.TenNoiLuuTru)
            .Skip((page - 1) * pageSize)
            .Take(pageSize)
            .ToListAsync(cancellationToken);
        var types = await dbContext.Noiluutru.AsNoTracking()
            .Select(item => item.LoaiHinh)
            .Distinct()
            .OrderBy(value => value)
            .ToListAsync(cancellationToken);

        return View(new AccommodationIndexViewModel
        {
            Search = search,
            Type = type,
            Page = page,
            TotalPages = (int)Math.Ceiling(totalCount / (double)pageSize),
            Types = types,
            Items = items.Select(item => new AccommodationRowViewModel
            {
                Id = item.MaNoiLuuTru,
                Name = item.TenNoiLuuTru,
                Type = item.LoaiHinh,
                Address = item.DiaChi,
                IsActive = item.TrangThaiHoatDong,
                CoverImage = item.Hinhanhnoiluutru.FirstOrDefault(image => image.LaAnhDaiDien == true)?.DuongDanAnh
            }).ToList()
        });
    }

    [HttpGet]
    public IActionResult Create()
    {
        ViewData["Title"] = "Thêm nơi lưu trú";
        return View("Edit", new AccommodationEditViewModel());
    }

    [HttpPost, ValidateAntiForgeryToken]
    public async Task<IActionResult> Create(AccommodationEditViewModel model, CancellationToken cancellationToken)
    {
        if (!ModelState.IsValid)
        {
            ViewData["Title"] = "Thêm nơi lưu trú";
            return View("Edit", model);
        }

        dbContext.Noiluutru.Add(new Noiluutru
        {
            TenNoiLuuTru = model.Name.Trim(),
            LoaiHinh = model.Type.Trim(),
            DiaChi = model.Address.Trim(),
            MoTa = model.Description?.Trim(),
            TrangThaiHoatDong = true
        });
        await dbContext.SaveChangesAsync(cancellationToken);
        return RedirectToAction(nameof(Index));
    }

    [HttpGet]
    public async Task<IActionResult> Edit(int id, CancellationToken cancellationToken)
    {
        var item = await dbContext.Noiluutru.AsNoTracking().SingleOrDefaultAsync(x => x.MaNoiLuuTru == id, cancellationToken);
        if (item is null)
        {
            return NotFound();
        }

        ViewData["Title"] = "Sửa nơi lưu trú";
        return View(new AccommodationEditViewModel
        {
            Id = item.MaNoiLuuTru,
            Name = item.TenNoiLuuTru,
            Type = item.LoaiHinh,
            Address = item.DiaChi,
            Description = item.MoTa
        });
    }

    [HttpPost, ValidateAntiForgeryToken]
    public async Task<IActionResult> Edit(AccommodationEditViewModel model, CancellationToken cancellationToken)
    {
        if (!ModelState.IsValid || model.Id is null)
        {
            ViewData["Title"] = "Sửa nơi lưu trú";
            return View(model);
        }

        var item = await dbContext.Noiluutru.FindAsync([model.Id.Value], cancellationToken);
        if (item is null)
        {
            return NotFound();
        }

        item.TenNoiLuuTru = model.Name.Trim();
        item.LoaiHinh = model.Type.Trim();
        item.DiaChi = model.Address.Trim();
        item.MoTa = model.Description?.Trim();
        await dbContext.SaveChangesAsync(cancellationToken);
        return RedirectToAction(nameof(Index));
    }

    [HttpPost, ValidateAntiForgeryToken]
    public async Task<IActionResult> ToggleStatus(int id, CancellationToken cancellationToken)
    {
        var item = await dbContext.Noiluutru.FindAsync([id], cancellationToken);
        if (item is null)
        {
            return NotFound();
        }

        item.TrangThaiHoatDong = !item.TrangThaiHoatDong;
        await dbContext.SaveChangesAsync(cancellationToken);
        return RedirectToAction(nameof(Index));
    }

    [HttpGet]
    public async Task<IActionResult> Images(int id, CancellationToken cancellationToken)
    {
        var item = await dbContext.Noiluutru.AsNoTracking()
            .Include(x => x.Hinhanhnoiluutru)
            .SingleOrDefaultAsync(x => x.MaNoiLuuTru == id, cancellationToken);
        if (item is null)
        {
            return NotFound();
        }

        ViewData["AddImage"] = new AddAccommodationImageViewModel { AccommodationId = id };
        return View(new AccommodationImagesViewModel
        {
            AccommodationId = id,
            AccommodationName = item.TenNoiLuuTru,
            Images = item.Hinhanhnoiluutru.Select(image => new AccommodationImageViewModel
            {
                Id = image.MaHinhAnh,
                Url = image.DuongDanAnh,
                IsCover = image.LaAnhDaiDien
            }).ToList()
        });
    }

    [HttpPost, ValidateAntiForgeryToken]
    public async Task<IActionResult> AddImage(AddAccommodationImageViewModel model, CancellationToken cancellationToken)
    {
        if (!ModelState.IsValid || !await dbContext.Noiluutru.AnyAsync(x => x.MaNoiLuuTru == model.AccommodationId, cancellationToken))
        {
            return BadRequest(ModelState);
        }

        var existingImages = await dbContext.Hinhanhnoiluutru
            .Where(x => x.MaNoiLuuTru == model.AccommodationId)
            .ToListAsync(cancellationToken);
        foreach (var image in existingImages)
        {
            image.LaAnhDaiDien = false;
        }

        dbContext.Hinhanhnoiluutru.Add(new Hinhanhnoiluutru
        {
            MaNoiLuuTru = model.AccommodationId,
            DuongDanAnh = model.Url.Trim(),
            LaAnhDaiDien = true
        });
        await dbContext.SaveChangesAsync(cancellationToken);
        return RedirectToAction(nameof(Images), new { id = model.AccommodationId });
    }

    [HttpPost, ValidateAntiForgeryToken]
    public async Task<IActionResult> SetCover(int id, int imageId, CancellationToken cancellationToken)
    {
        var images = await dbContext.Hinhanhnoiluutru
            .Where(x => x.MaNoiLuuTru == id)
            .ToListAsync(cancellationToken);
        var selected = images.SingleOrDefault(x => x.MaHinhAnh == imageId);
        if (selected is null)
        {
            return NotFound();
        }

        foreach (var image in images)
        {
            image.LaAnhDaiDien = image.MaHinhAnh == imageId;
        }

        await dbContext.SaveChangesAsync(cancellationToken);
        return RedirectToAction(nameof(Images), new { id });
    }
}
