using System.Data;
using Microsoft.AspNetCore.Mvc;
using Microsoft.EntityFrameworkCore;
using Staybook_sidePj.Areas.Admin.ViewModels;
using Staybook_sidePj.Data;
using Staybook_sidePj.Models.Database;

namespace Staybook_sidePj.Areas.Admin.Controllers;

[Area("Admin")]
public sealed class BookingsController(StaybookDbContext dbContext) : Controller
{
    [HttpGet]
    public async Task<IActionResult> Index(string? search, string? status, int page = 1, CancellationToken cancellationToken = default)
    {
        const int pageSize = 20;
        page = Math.Max(1, page);
        var query = dbContext.Datphong.AsNoTracking()
            .Include(x => x.MaNguoiDungNavigation)
            .Include(x => x.MaNoiLuuTruNavigation)
            .Include(x => x.Thanhtoan)
            .AsQueryable();
        if (!string.IsNullOrWhiteSpace(search))
        {
            var term = search.Trim();
            query = query.Where(x => x.MaNguoiDungNavigation.HoTen.Contains(term)
                || x.MaNoiLuuTruNavigation.TenNoiLuuTru.Contains(term));
            if (int.TryParse(term.TrimStart('#'), out var bookingId))
            {
                query = query.Where(x => x.MaDatPhong == bookingId
                    || x.MaNguoiDungNavigation.HoTen.Contains(term)
                    || x.MaNoiLuuTruNavigation.TenNoiLuuTru.Contains(term));
            }
        }
        if (!string.IsNullOrWhiteSpace(status))
        {
            query = query.Where(x => x.TrangThaiDatPhong == status);
        }

        var count = await query.CountAsync(cancellationToken);
        var items = await query.OrderByDescending(x => x.NgayTao).ThenByDescending(x => x.MaDatPhong)
            .Skip((page - 1) * pageSize)
            .Take(pageSize)
            .Select(x => new BookingRowViewModel
            {
                Id = x.MaDatPhong,
                GuestName = x.MaNguoiDungNavigation.HoTen,
                AccommodationName = x.MaNoiLuuTruNavigation.TenNoiLuuTru,
                CheckIn = x.NgayNhanPhong,
                CheckOut = x.NgayTraPhong,
                Status = x.TrangThaiDatPhong,
                PaymentStatus = x.Thanhtoan == null ? null : x.Thanhtoan.TrangThaiThanhToan,
                Total = x.TongTien
            })
            .ToListAsync(cancellationToken);
        var statuses = await dbContext.Datphong.AsNoTracking()
            .Select(x => x.TrangThaiDatPhong).Distinct().OrderBy(x => x).ToListAsync(cancellationToken);
        return View(new BookingIndexViewModel
        {
            Search = search,
            Status = status,
            Page = page,
            TotalPages = (int)Math.Ceiling(count / (double)pageSize),
            Statuses = statuses,
            Items = items
        });
    }

    [HttpGet]
    public async Task<IActionResult> Details(int id, CancellationToken cancellationToken)
    {
        var booking = await dbContext.Datphong.AsNoTracking()
            .Include(x => x.MaNguoiDungNavigation)
            .Include(x => x.MaNoiLuuTruNavigation)
            .Include(x => x.Chitietdatphong).ThenInclude(x => x.MaPhongNavigation)
                .ThenInclude(x => x.MaLoaiPhongNavigation)
            .SingleOrDefaultAsync(x => x.MaDatPhong == id, cancellationToken);
        if (booking is null)
        {
            return NotFound();
        }

        return View(new BookingDetailsViewModel
        {
            Id = booking.MaDatPhong,
            GuestName = booking.MaNguoiDungNavigation.HoTen,
            AccommodationName = booking.MaNoiLuuTruNavigation.TenNoiLuuTru,
            CheckIn = booking.NgayNhanPhong,
            CheckOut = booking.NgayTraPhong,
            GuestCount = booking.SoLuongKhach,
            Status = booking.TrangThaiDatPhong,
            Total = booking.TongTien,
            Rooms = booking.Chitietdatphong.Select(x => new BookingRoomViewModel
            {
                RoomId = x.MaPhong,
                RoomNumber = x.MaPhongNavigation.SoPhong,
                RoomType = x.MaPhongNavigation.MaLoaiPhongNavigation.TenLoaiPhong,
                CheckInStatus = x.TrangThaiNhanPhong,
                CheckOutStatus = x.TrangThaiTraPhong,
                ActualCheckIn = x.NgayCheckInThucTe,
                ActualCheckOut = x.NgayCheckOutThucTe
            }).ToList()
        });
    }

    [HttpGet]
    public async Task<IActionResult> Create(BookingCreateViewModel model, CancellationToken cancellationToken)
    {
        await PopulateBookingOptionsAsync(model, cancellationToken);
        if (model.AccommodationId.HasValue && model.CheckOut.Date > model.CheckIn.Date && model.GuestCount > 0)
        {
            model.AvailableRooms = await FindAvailableRoomsAsync(model.AccommodationId.Value, model.CheckIn.Date, model.CheckOut.Date, model.GuestCount, cancellationToken);
        }
        return View(model);
    }

    [HttpPost, ValidateAntiForgeryToken]
    public async Task<IActionResult> Create(BookingCreateViewModel model, CancellationToken cancellationToken)
    {
        if (model.CustomerId is null || model.AccommodationId is null)
        {
            ModelState.AddModelError(string.Empty, "Chọn khách hàng và nơi lưu trú.");
        }
        if (model.CheckIn.Date < DateTime.Today || model.CheckOut.Date <= model.CheckIn.Date)
        {
            ModelState.AddModelError(string.Empty, "Khoảng ngày nhận/trả phòng không hợp lệ.");
        }
        if (model.SelectedRoomIds.Count == 0)
        {
            ModelState.AddModelError(nameof(model.SelectedRoomIds), "Chọn ít nhất một phòng trống.");
        }
        if (!ModelState.IsValid)
        {
            await PopulateBookingOptionsAsync(model, cancellationToken);
            if (model.AccommodationId.HasValue && model.CheckOut.Date > model.CheckIn.Date)
            {
                model.AvailableRooms = await FindAvailableRoomsAsync(model.AccommodationId.Value, model.CheckIn.Date, model.CheckOut.Date, model.GuestCount, cancellationToken);
            }
            return View(model);
        }

        await using var transaction = await dbContext.Database.BeginTransactionAsync(IsolationLevel.Serializable, cancellationToken);
        var customerExists = await dbContext.Nguoidung.AnyAsync(x => x.MaNguoiDung == model.CustomerId && x.TrangThaiHoatDong == true, cancellationToken);
        var accommodation = await dbContext.Noiluutru.SingleOrDefaultAsync(x => x.MaNoiLuuTru == model.AccommodationId && x.TrangThaiHoatDong == true, cancellationToken);
        if (!customerExists || accommodation is null)
        {
            await transaction.RollbackAsync(cancellationToken);
            ModelState.AddModelError(string.Empty, "Khách hàng hoặc nơi lưu trú không còn hoạt động.");
            await PopulateBookingOptionsAsync(model, cancellationToken);
            return View(model);
        }

        var roomIds = model.SelectedRoomIds.Distinct().ToArray();
        var availableRooms = await FindAvailableRoomsAsync(model.AccommodationId.Value, model.CheckIn.Date, model.CheckOut.Date, model.GuestCount, cancellationToken);
        var selectedRooms = availableRooms.Where(x => roomIds.Contains(x.Id)).ToList();
        if (selectedRooms.Count != roomIds.Length)
        {
            await transaction.RollbackAsync(cancellationToken);
            ModelState.AddModelError(nameof(model.SelectedRoomIds), "Một hoặc nhiều phòng không còn trống trong khoảng thời gian đã chọn.");
            await PopulateBookingOptionsAsync(model, cancellationToken);
            model.AvailableRooms = availableRooms;
            return View(model);
        }

        var nights = (model.CheckOut.Date - model.CheckIn.Date).Days;
        var booking = new Datphong
        {
            MaNguoiDung = model.CustomerId.Value,
            MaNoiLuuTru = model.AccommodationId.Value,
            NgayNhanPhong = model.CheckIn.Date,
            NgayTraPhong = model.CheckOut.Date,
            SoLuongKhach = model.GuestCount,
            TongTien = selectedRooms.Sum(x => x.NightlyRate) * nights,
            TrangThaiDatPhong = "ChoXacNhan",
            Chitietdatphong = selectedRooms.Select(room => new Chitietdatphong
            {
                MaPhong = room.Id,
                GiaMoiDem = room.NightlyRate,
                TrangThaiNhanPhong = "ChuaNhan",
                TrangThaiTraPhong = "ChuaTra"
            }).ToList()
        };
        dbContext.Datphong.Add(booking);
        await dbContext.SaveChangesAsync(cancellationToken);
        await transaction.CommitAsync(cancellationToken);
        return RedirectToAction(nameof(Details), new { id = booking.MaDatPhong });
    }

    [HttpPost, ValidateAntiForgeryToken]
    public async Task<IActionResult> CheckIn(int bookingId, int roomId, CancellationToken cancellationToken)
    {
        var detail = await dbContext.Chitietdatphong.Include(x => x.MaDatPhongNavigation)
            .Include(x => x.MaPhongNavigation)
            .SingleOrDefaultAsync(x => x.MaDatPhong == bookingId && x.MaPhong == roomId, cancellationToken);
        if (detail is null)
        {
            return NotFound();
        }
        if (detail.MaDatPhongNavigation.TrangThaiDatPhong == "DaHuy" || detail.NgayCheckInThucTe.HasValue)
        {
            return BadRequest("Không thể nhận phòng cho đơn này.");
        }

        detail.NgayCheckInThucTe = DateTime.Now;
        detail.TrangThaiNhanPhong = "DaNhan";
        detail.MaPhongNavigation.TrangThaiPhong = "DangO";
        await dbContext.SaveChangesAsync(cancellationToken);
        return RedirectToAction(nameof(Details), new { id = bookingId });
    }

    [HttpPost, ValidateAntiForgeryToken]
    public async Task<IActionResult> CheckOut(int bookingId, int roomId, CancellationToken cancellationToken)
    {
        var detail = await dbContext.Chitietdatphong.Include(x => x.MaDatPhongNavigation)
            .Include(x => x.MaPhongNavigation)
            .SingleOrDefaultAsync(x => x.MaDatPhong == bookingId && x.MaPhong == roomId, cancellationToken);
        if (detail is null)
        {
            return NotFound();
        }
        if (!detail.NgayCheckInThucTe.HasValue || detail.NgayCheckOutThucTe.HasValue)
        {
            return BadRequest("Phòng chưa nhận hoặc đã trả phòng.");
        }

        detail.NgayCheckOutThucTe = DateTime.Now;
        detail.TrangThaiTraPhong = "DaTra";
        detail.MaPhongNavigation.TrangThaiPhong = "Trong";
        var remainingRooms = await dbContext.Chitietdatphong
            .Where(x => x.MaDatPhong == bookingId && x.MaPhong != roomId)
            .AnyAsync(x => x.NgayCheckOutThucTe == null, cancellationToken);
        if (!remainingRooms)
        {
            detail.MaDatPhongNavigation.TrangThaiDatPhong = "DaHoanThanh";
        }
        await dbContext.SaveChangesAsync(cancellationToken);
        return RedirectToAction(nameof(Details), new { id = bookingId });
    }

    private async Task PopulateBookingOptionsAsync(BookingCreateViewModel model, CancellationToken cancellationToken)
    {
        model.Customers = await dbContext.Nguoidung.AsNoTracking()
            .Where(x => x.TrangThaiHoatDong == true)
            .OrderBy(x => x.HoTen)
            .Select(x => new CustomerOptionViewModel { Id = x.MaNguoiDung, Name = x.HoTen, Email = x.Email })
            .ToListAsync(cancellationToken);
        model.Accommodations = await dbContext.Noiluutru.AsNoTracking()
            .Where(x => x.TrangThaiHoatDong == true)
            .OrderBy(x => x.TenNoiLuuTru)
            .Select(x => new AccommodationOptionViewModel { Id = x.MaNoiLuuTru, Name = x.TenNoiLuuTru })
            .ToListAsync(cancellationToken);
    }

    private Task<List<AvailableRoomViewModel>> FindAvailableRoomsAsync(int accommodationId, DateTime checkIn, DateTime checkOut, int guests, CancellationToken cancellationToken) =>
        dbContext.Phong.AsNoTracking()
            .Where(room => room.TrangThaiPhong == "Trong"
                && room.MaLoaiPhongNavigation.MaNoiLuuTru == accommodationId
                && room.MaLoaiPhongNavigation.SucChua >= guests
                && !room.Chitietdatphong.Any(detail =>
                    detail.MaDatPhongNavigation.TrangThaiDatPhong != "DaHuy"
                    && detail.MaDatPhongNavigation.NgayNhanPhong < checkOut
                    && detail.MaDatPhongNavigation.NgayTraPhong > checkIn))
            .OrderBy(room => room.SoPhong)
            .Select(room => new AvailableRoomViewModel
            {
                Id = room.MaPhong,
                RoomNumber = room.SoPhong,
                RoomType = room.MaLoaiPhongNavigation.TenLoaiPhong,
                Capacity = room.MaLoaiPhongNavigation.SucChua,
                NightlyRate = room.MaLoaiPhongNavigation.GiaCoBan
            })
            .ToListAsync(cancellationToken);
}
