using Microsoft.AspNetCore.Mvc;
using Microsoft.EntityFrameworkCore;
using PJ_net.Data;
using PJ_net.Models;

namespace PJ_net.Areas.Admin.Controllers
{
    [Area("Admin")]
    public class NhomThuocController : Controller
    {
        private readonly PjNetContext _context;

        public NhomThuocController(PjNetContext context)
        {
            _context = context;
        }

        // GET: /Admin/NhomThuoc
        public async Task<IActionResult> Index(string? search)
        {
            var query = _context.NhomThuocs
                .Include(n => n.Thuocs)
                .AsQueryable();

            if (!string.IsNullOrWhiteSpace(search))
            {
                search = search.Trim();
                query = query.Where(n => n.TenNhom.Contains(search) || (n.MoTa != null && n.MoTa.Contains(search)));
            }

            var list = await query.OrderBy(n => n.TenNhom).ToListAsync();
            ViewBag.Search = search;
            return View(list);
        }

        // GET: /Admin/NhomThuoc/Create
        public IActionResult Create()
        {
            return View();
        }

        // POST: /Admin/NhomThuoc/Create
        [HttpPost]
        [ValidateAntiForgeryToken]
        public async Task<IActionResult> Create([Bind("TenNhom,MoTa")] NhomThuoc nhomThuoc)
        {
            if (string.IsNullOrWhiteSpace(nhomThuoc.TenNhom))
            {
                ModelState.AddModelError("TenNhom", "Tên nhóm thuốc không được để trống.");
            }

            if (ModelState.IsValid)
            {
                // Kiểm tra xem tên nhóm thuốc đã tồn tại chưa
                var exists = await _context.NhomThuocs.AnyAsync(n => n.TenNhom.ToLower() == nhomThuoc.TenNhom.Trim().ToLower());
                if (exists)
                {
                    ModelState.AddModelError("TenNhom", "Tên nhóm thuốc này đã tồn tại trong hệ thống.");
                    return View(nhomThuoc);
                }

                nhomThuoc.TenNhom = nhomThuoc.TenNhom.Trim();
                nhomThuoc.MoTa = nhomThuoc.MoTa?.Trim();

                _context.Add(nhomThuoc);
                await _context.SaveChangesAsync();
                TempData["SuccessMessage"] = $"Đã thêm mới nhóm thuốc \"{nhomThuoc.TenNhom}\" thành công!";
                return RedirectToAction(nameof(Index));
            }

            return View(nhomThuoc);
        }
    }
}
