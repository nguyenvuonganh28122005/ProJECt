html[data-bs-theme="light"] .app-main .bg-dark {
  background-color: var(--bs-tertiary-bg) !important;
  color: var(--bs-body-color) !important;
}

html[data-bs-theme="light"] .app-main .text-light:not(.badge) {
  color: var(--bs-body-color) !important;
}

html[data-bs-theme="light"] .app-main .border-secondary {
  border-color: var(--bs-border-color) !important;
}

html[data-bs-theme="light"] .app-main .form-control::placeholder {
  color: var(--bs-secondary-color);
  opacity: 1;
}

html[data-bs-theme="light"] .app-main .form-control:focus,
html[data-bs-theme="light"] .app-main .form-select:focus {
  border-color: var(--bs-primary);
  box-shadow: 0 0 0 .2rem rgba(var(--bs-primary-rgb), .2);
}

html[data-bs-theme="light"] .app-main .table-dark {
  --bs-table-color: var(--bs-body-color);
  --bs-table-bg: var(--bs-tertiary-bg);
  --bs-table-border-color: var(--bs-border-color);
  --bs-table-striped-bg: var(--bs-secondary-bg);
  --bs-table-striped-color: var(--bs-body-color);
  --bs-table-active-bg: var(--bs-secondary-bg);
  --bs-table-active-color: var(--bs-body-color);
  --bs-table-hover-bg: var(--bs-secondary-bg);
  --bs-table-hover-color: var(--bs-body-color);
}

html[data-bs-theme="dark"] .app-main .bg-white {
  background-color: var(--bs-tertiary-bg) !important;
  color: var(--bs-body-color) !important;
}

html[data-bs-theme="dark"] .app-main .text-slate-900 {
  color: var(--bs-body-color) !important;
}

html[data-bs-theme="dark"] .app-main .table-light {
  --bs-table-color: var(--bs-body-color);
  --bs-table-bg: var(--bs-tertiary-bg);
  --bs-table-border-color: var(--bs-border-color);
  --bs-table-striped-bg: var(--bs-secondary-bg);
  --bs-table-striped-color: var(--bs-body-color);
  --bs-table-active-bg: var(--bs-secondary-bg);
  --bs-table-active-color: var(--bs-body-color);
  --bs-table-hover-bg: var(--bs-secondary-bg);
  --bs-table-hover-color: var(--bs-body-color);
}
