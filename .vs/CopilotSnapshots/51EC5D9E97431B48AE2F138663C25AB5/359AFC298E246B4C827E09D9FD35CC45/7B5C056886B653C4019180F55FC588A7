using System.ComponentModel.DataAnnotations;

namespace StayBook.API.DTOs;

public sealed class RegisterRequest
{
    [Required, StringLength(120, MinimumLength = 2)]
    public string FullName { get; init; } = string.Empty;

    [Required, EmailAddress, StringLength(256)]
    public string Email { get; init; } = string.Empty;

    [Required, StringLength(20, MinimumLength = 8)]
    public string PhoneNumber { get; init; } = string.Empty;

    [Required, StringLength(100, MinimumLength = 8)]
    public string Password { get; init; } = string.Empty;
}

public sealed class LoginRequest
{
    [Required, EmailAddress, StringLength(256)]
    public string Email { get; init; } = string.Empty;

    [Required, StringLength(100, MinimumLength = 8)]
    public string Password { get; init; } = string.Empty;
}

public sealed record UserResponse(int Id, string FullName, string Email, string PhoneNumber, string Role);

public sealed record AuthResponse(string AccessToken, DateTime ExpiresAtUtc, UserResponse User);

public sealed class NoiLuuTruQuery
{
    public string? Keyword { get; init; }
    public string? Location { get; init; }
    public string? Type { get; init; }
    public int? Guests { get; init; }
    public DateTime? CheckIn { get; init; }
    public DateTime? CheckOut { get; init; }
    public decimal? MinPrice { get; init; }
    public decimal? MaxPrice { get; init; }
}

public sealed record NoiLuuTruResponse(
    int Id,
    string Name,
    string Type,
    string Address,
    string Description,
    IReadOnlyList<string> Images,
    IReadOnlyList<LoaiPhongResponse> RoomTypes);

public sealed record LoaiPhongResponse(
    int Id,
    string Name,
    string Description,
    int Capacity,
    decimal PricePerNight,
    IReadOnlyList<PhongResponse> Rooms);

public sealed record PhongResponse(int Id, string Number, string Status);

public sealed class CreateDatPhongRequest
{
    [Required]
    public DateTime CheckIn { get; init; }

    [Required]
    public DateTime CheckOut { get; init; }

    [Range(1, 100)]
    public int Guests { get; init; }

    [Required, MinLength(1)]
    public List<int> RoomIds { get; init; } = [];
}

public sealed record DatPhongResponse(
    int Id,
    DateTime CheckIn,
    DateTime CheckOut,
    int Guests,
    decimal TotalPrice,
    string Status,
    DateTime CreatedAt,
    IReadOnlyList<DatPhongRoomResponse> Rooms);

public sealed record DatPhongRoomResponse(
    int RoomId,
    string RoomNumber,
    string AccommodationName,
    string RoomTypeName,
    decimal PricePerNight);
