<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Staybook</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Staybook_sidePj.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="site-nav" aria-label="Điều hướng chính">
            <div class="nav-inner">
                <a class="brand-mark" asp-area="" asp-controller="Home" asp-action="Index" aria-label="Staybook - Trang chủ"><span class="brand-icon" aria-hidden="true">S</span>staybook<span class="brand-period">.</span></a>
                <div class="nav-links">
                    <a href="/#gioi-thieu">Giới thiệu</a>
                    <a href="/#tinh-nang">Tính năng</a>
                    <a href="/#cach-hoat-dong">Cách hoạt động</a>
                </div>
                <a class="nav-cta" href="/#tinh-nang">Khám phá <span aria-hidden="true">↗</span></a>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="footer-inner">
            <a class="brand-mark footer-brand" asp-area="" asp-controller="Home" asp-action="Index"><span class="brand-icon" aria-hidden="true">S</span>staybook<span class="brand-period">.</span></a>
            <span>Chúc bạn có một hành trình thật đáng nhớ.</span>
            <span>&copy; @DateTime.Now.Year Staybook</span>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
