@model Staybook_sidePj.ViewModels.CustomerRegisterViewModel
@{
    ViewData["Title"] = "Tạo tài khoản";
}

<section class="account-page">
    <div class="account-card">
        <p class="eyebrow">BẮT ĐẦU HÀNH TRÌNH CÙNG STAYBOOK</p>
        <h1>Tạo tài khoản</h1>
        <p class="account-intro">Đăng ký để gửi yêu cầu đặt phòng và theo dõi chuyến đi của bạn.</p>
        <form asp-action="Register" method="post">
            @Html.AntiForgeryToken()
            <input asp-for="ReturnUrl" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
            <div class="account-field">
                <label asp-for="Name">Họ và tên</label>
                <input asp-for="Name" autocomplete="name" />
                <span asp-validation-for="Name" class="field-error"></span>
            </div>
            <div class="account-field">
                <label asp-for="Email">Email</label>
                <input asp-for="Email" autocomplete="email" />
                <span asp-validation-for="Email" class="field-error"></span>
            </div>
            <div class="account-field">
                <label asp-for="Phone">Số điện thoại</label>
                <input asp-for="Phone" autocomplete="tel" />
                <span asp-validation-for="Phone" class="field-error"></span>
            </div>
            <div class="account-field">
                <label asp-for="Password">Mật khẩu (ít nhất 8 ký tự)</label>
                <input asp-for="Password" autocomplete="new-password" />
                <span asp-validation-for="Password" class="field-error"></span>
            </div>
            <div class="account-field">
                <label asp-for="ConfirmPassword">Nhập lại mật khẩu</label>
                <input asp-for="ConfirmPassword" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="field-error"></span>
            </div>
            <button class="button-primary account-submit" type="submit">Tạo tài khoản</button>
        </form>
        <p class="account-switch">Đã có tài khoản? <a asp-action="Login" asp-route-returnUrl="@Model.ReturnUrl">Đăng nhập</a></p>
    </div>
</section>
