@model Staybook_sidePj.Areas.Admin.ViewModels.BookingDetailsViewModel
@using System.Globalization
@{
    ViewData["Title"] = $"Đơn #{Model.Id}";
    var culture = CultureInfo.GetCultureInfo("vi-VN");
}
<div class="app-content-header">
    <div class="container-fluid d-flex justify-content-between">
        <h1 class="fs-3">Chi tiết đơn #@Model.Id</h1>
        <a class="btn btn-secondary" asp-action="Index">Quay lại</a>
    </div>
</div>
<div class="app-content">
    <div class="container-fluid">
        <div class="card">
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <p><strong>Khách:</strong> @Model.GuestName</p>
                        <p><strong>Nơi lưu trú:</strong> @Model.AccommodationName</p>
                        <p><strong>Số khách:</strong> @Model.GuestCount</p>
                    </div>
                    <div class="col-md-6">
                        <p><strong>Ngày:</strong> @Model.CheckIn.ToString("dd/MM/yyyy") – @Model.CheckOut.ToString("dd/MM/yyyy")</p>
                        <p><strong>Trạng thái:</strong> @Model.Status</p>
                        <p><strong>Tổng tiền:</strong> @Model.Total.ToString("N0", culture) ₫</p>
                    </div>
                </div>
            </div>
        </div>
        <div class="card">
            <div class="card-header">
                <h2 class="card-title">Phòng và nhận/trả thực tế</h2>
            </div>
            <div class="card-body p-0 table-responsive">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Phòng</th>
                            <th>Loại phòng</th>
                            <th>Nhận phòng</th>
                            <th>Trả phòng</th>
                            <th>Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var room in Model.Rooms) {
                        <tr>
                            <td>@room.RoomNumber</td>
                            <td>@room.RoomType</td>
                            <td>@(room.ActualCheckIn?.ToString("dd/MM/yyyy HH:mm") ?? room.CheckInStatus)</td>
                            <td>@(room.ActualCheckOut?.ToString("dd/MM/yyyy HH:mm") ?? room.CheckOutStatus)</td>
                            <td>
                                @if (room.ActualCheckIn is null) {
                                    <form method="post" asp-action="CheckIn" class="d-inline">
                                        <input type="hidden" name="bookingId" value="@Model.Id" />
                                        <input type="hidden" name="roomId" value="@room.RoomId" />
                                        <button class="btn btn-sm btn-outline-success">Check-in</button>
                                    </form>
                                } else if (room.ActualCheckOut is null) {
                                    <form method="post" asp-action="CheckOut" class="d-inline">
                                        <input type="hidden" name="bookingId" value="@Model.Id" />
                                        <input type="hidden" name="roomId" value="@room.RoomId" />
                                        <button class="btn btn-sm btn-outline-primary">Check-out</button>
                                    </form>
                                }
                            </td>
                        </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
