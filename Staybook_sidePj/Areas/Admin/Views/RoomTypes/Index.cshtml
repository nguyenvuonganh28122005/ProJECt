@model Staybook_sidePj.Areas.Admin.ViewModels.RoomTypeIndexViewModel
@{ ViewData["Title"] = "Loại phòng"; }
<div class="app-content-header"><div class="container-fluid d-flex justify-content-between"><h1 class="fs-3">Loại phòng</h1><a class="btn btn-primary" asp-action="Create">Thêm loại phòng</a></div></div>
<div class="app-content"><div class="container-fluid">
@if (TempData["Error"] is string error){<div class="alert alert-danger">@error</div>}
<form method="get" class="card card-body mb-3"><div class="row g-2 align-items-end"><div class="col-md-5"><label class="form-label">Tên loại phòng</label><input class="form-control" name="search" value="@Model.Search" /></div><div class="col-md-5"><label class="form-label">Nơi lưu trú</label><select class="form-select" name="accommodationId"><option value="">Tất cả</option>@foreach(var item in Model.Accommodations){<option value="@item.Id" selected="@(Model.AccommodationId==item.Id)">@item.Name</option>}</select></div><div class="col-md-2"><button class="btn btn-outline-primary w-100">Lọc</button></div></div></form>
<div class="card"><div class="card-body p-0 table-responsive"><table class="table table-hover mb-0"><thead><tr><th>Tên loại</th><th>Nơi lưu trú</th><th>Sức chứa</th><th>Giá cơ bản</th><th>Tiện nghi</th><th></th></tr></thead><tbody>
@if(Model.Items.Count==0){<tr><td colspan="6" class="text-center p-4">Chưa có loại phòng.</td></tr>}
@foreach(var item in Model.Items){<tr><td>@item.Name</td><td>@item.AccommodationName</td><td>@item.Capacity</td><td>@item.BaseRate.ToString("N0") ₫</td><td>@item.AmenityCount</td><td class="text-end"><a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.Id">Sửa</a><form method="post" asp-action="Delete" asp-route-id="@item.Id" class="d-inline"><button class="btn btn-sm btn-outline-danger">Xóa</button></form></td></tr>}
</tbody></table></div></div>
</div></div>
