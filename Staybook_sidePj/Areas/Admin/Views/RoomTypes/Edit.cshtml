@model Staybook_sidePj.Areas.Admin.ViewModels.RoomTypeEditViewModel
@{ var editing = Model.Id.HasValue; ViewData["Title"] = editing ? "Sửa loại phòng" : "Thêm loại phòng"; }
<div class="app-content-header"><div class="container-fluid"><h1 class="fs-3">@ViewData["Title"]</h1></div></div>
<div class="app-content"><div class="container-fluid"><div class="card"><form method="post" asp-action="@(editing ? "Edit" : "Create")"><div class="card-body"><input asp-for="Id" type="hidden" /><div asp-validation-summary="ModelOnly" class="text-danger"></div>
<div class="mb-3"><label asp-for="AccommodationId" class="form-label">Nơi lưu trú</label><select asp-for="AccommodationId" class="form-select"><option value="">Chọn nơi lưu trú</option>@foreach(var item in Model.Accommodations){<option value="@item.Id">@item.Name</option>}</select><span asp-validation-for="AccommodationId" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="Name" class="form-label">Tên loại phòng</label><input asp-for="Name" class="form-control" /><span asp-validation-for="Name" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="Description" class="form-label">Mô tả</label><textarea asp-for="Description" class="form-control"></textarea></div>
<div class="row"><div class="col-md-6 mb-3"><label asp-for="Capacity" class="form-label">Sức chứa</label><input asp-for="Capacity" class="form-control" /><span asp-validation-for="Capacity" class="text-danger"></span></div><div class="col-md-6 mb-3"><label asp-for="BaseRate" class="form-label">Giá cơ bản</label><input asp-for="BaseRate" class="form-control" /><span asp-validation-for="BaseRate" class="text-danger"></span></div></div>
<fieldset><legend class="fs-6">Tiện nghi</legend><div class="row">@foreach(var amenity in Model.Amenities){<div class="col-sm-6 col-lg-4"><label class="form-check"><input class="form-check-input" type="checkbox" name="SelectedAmenityIds" value="@amenity.Id" checked="@amenity.Selected" /><span class="form-check-label">@amenity.Name</span></label></div>}</div></fieldset>
</div><div class="card-footer"><button class="btn btn-primary">Lưu</button> <a class="btn btn-secondary" asp-action="Index">Hủy</a></div></form></div></div></div>
