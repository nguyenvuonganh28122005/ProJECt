@model Staybook_sidePj.Areas.Admin.ViewModels.UserIndexViewModel
@{ ViewData["Title"] = "Người dùng"; }
<div class="app-content-header"><div class="container-fluid"><h1 class="fs-3">Người dùng</h1></div></div>
<div class="app-content"><div class="container-fluid"><form method="get" class="card card-body mb-3"><div class="row g-2 align-items-end"><div class="col-md-5"><label class="form-label">Email hoặc số điện thoại</label><input name="search" value="@Model.Search" class="form-control" /></div><div class="col-md-3"><label class="form-label">Vai trò</label><select name="role" class="form-select"><option value="">Tất cả</option>@foreach(var role in Model.Roles){<option value="@role" selected="@(Model.Role==role)">@role</option>}</select></div><div class="col-md-2"><label class="form-label">Trạng thái</label><select name="active" class="form-select"><option value="">Tất cả</option><option value="true" selected="@(Model.Active==true)">Hoạt động</option><option value="false" selected="@(Model.Active==false)">Đã khóa</option></select></div><div class="col-md-2"><button class="btn btn-outline-primary w-100">Lọc</button></div></div></form>
<div class="card"><div class="card-body p-0 table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>Tên</th><th>Email</th><th>Số điện thoại</th><th>Trạng thái</th><th>Vai trò</th><th>Thao tác</th></tr></thead><tbody>
@if(Model.Items.Count==0){<tr><td colspan="6" class="text-center p-4">Không có người dùng.</td></tr>}
@foreach(var item in Model.Items){<tr><td>@item.Name</td><td>@item.Email</td><td>@item.Phone</td><td><span class="badge @(item.Active ? "text-bg-success" : "text-bg-secondary")">@(item.Active ? "Hoạt động" : "Đã khóa")</span></td><td><form method="post" asp-action="UpdateRole" class="d-flex gap-1"><input type="hidden" name="id" value="@item.Id"/><select name="role" class="form-select form-select-sm"><option selected="@(item.Role=="KhachHang")" value="KhachHang">KhachHang</option><option selected="@(item.Role=="ChuKhachSan")" value="ChuKhachSan">ChuKhachSan</option><option selected="@(item.Role=="NhanVien")" value="NhanVien">NhanVien</option><option selected="@(item.Role=="Admin")" value="Admin">Admin</option></select><button class="btn btn-sm btn-outline-primary">Lưu</button></form></td><td><form method="post" asp-action="ToggleStatus" asp-route-id="@item.Id"><button class="btn btn-sm btn-outline-warning">@(item.Active ? "Khóa" : "Mở khóa")</button></form></td></tr>}
</tbody></table></div></div>
</div></div>
