@model Staybook_sidePj.Areas.Admin.ViewModels.AmenityIndexViewModel
@{ ViewData["Title"] = "Tiện nghi"; }
<div class="app-content-header">
    <div class="container-fluid d-flex justify-content-between">
        <h1 class="fs-3">Tiện nghi</h1>
        <a class="btn btn-primary" asp-action="Create">Thêm tiện nghi</a>
    </div>
</div>
<div class="app-content">
    <div class="container-fluid">
        @if (TempData["Error"] is string error)
        {
            <div class="alert alert-danger">@error</div>
        }
        <form method="get" class="card card-body mb-3">
            <div class="input-group">
                <input class="form-control" name="search" value="@Model.Search" placeholder="Tìm tiện nghi" />
                <button class="btn btn-outline-primary">Tìm</button>
            </div>
        </form>
        <div class="card">
            <div class="card-body p-0 table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Tên</th>
                            <th>Mô tả</th>
                            <th>Đang dùng ở loại phòng</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Items.Count == 0)
                        {
                            <tr>
                                <td colspan="4" class="text-center p-4">Chưa có tiện nghi.</td>
                            </tr>
                        }
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td>@item.Name</td>
                                <td>@item.Description</td>
                                <td>@item.RoomTypeCount</td>
                                <td class="text-end">
                                    <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.Id">Sửa</a>
                                    <form method="post" asp-action="Delete" asp-route-id="@item.Id" class="d-inline">
                                        <button class="btn btn-sm btn-outline-danger" onclick="return confirm('Xóa tiện nghi này?')">Xóa
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
